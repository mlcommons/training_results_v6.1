    _cleanup_node_scratch
    set -e
}
_run_grpo_teardown() {
    set +e
    _kill_ray_steps
    if declare -F _orig_run_grpo_teardown >/dev/null; then
        ( _orig_run_grpo_teardown ) 2>&1 | sed 's/^/[orig-teardown] /'
        [[ ${PIPESTATUS[0]} -eq 0 ]] || echo "WARNING: original teardown reported errors (expected for Enroot-specific steps)"
