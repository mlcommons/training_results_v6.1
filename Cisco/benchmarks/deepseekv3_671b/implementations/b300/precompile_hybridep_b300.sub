#!/bin/bash
#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --nodes=1
#SBATCH --gres=gpu:8
#SBATCH --ntasks-per-node=8


#SBATCH --time=00:30:00

set -euo pipefail

SCRIPT_DIR="${HYBRID_EP_SCRIPT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)}"
[[ -d "${SCRIPT_DIR}" ]] || {
    echo "Missing HybridEP script directory: ${SCRIPT_DIR}" >&2
    exit 1
}
CONT="${CONT:?Set CONT}"
CACHE_TAG="${HYBRID_EP_CACHE_TAG:-b300_ep8_cp2_t2048_h7168_e32_top8_bf16_pad128_sm32_deepep58397eac}"
RUNTIME_CACHE="${SCRIPT_DIR}/.hybridep_jit/runtime-${SLURM_JOB_ID}"
PREBUILT_CACHE="${SCRIPT_DIR}/.hybridep_jit/${CACHE_TAG}"

export MASTER_ADDR="$(scontrol show hostnames "${SLURM_JOB_NODELIST}" | head -n1)"
export MASTER_PORT="${MASTER_PORT:-29610}"
export HYBRID_EP_CACHE_DIR=/workspace/llm/.hybridep_jit/runtime-${SLURM_JOB_ID}
export NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN=8
export USE_MNNVL=0

if [[ "${HYBRID_EP_VERIFY_CACHE:-0}" == "1" ]]; then
    export HYBRID_EP_PREBUILT_CACHE=/workspace/llm/.hybridep_jit/${CACHE_TAG}
    CACHE_ENV=HYBRID_EP_PREBUILT_CACHE
else
    export HYBRID_EP_PREBUILT_OUTPUT=/workspace/llm/.hybridep_jit/${CACHE_TAG}
    CACHE_ENV=HYBRID_EP_PREBUILT_OUTPUT
fi

mkdir -p "${RUNTIME_CACHE}" "${PREBUILT_CACHE}"

srun --mpi=pmi2 --ntasks-per-node=8 \
    --container-image="${CONT}" \
    --no-container-mount-home \
    --container-remap-root \
    --container-writable \
    --container-mounts="${SCRIPT_DIR}:/workspace/llm" \
    --container-workdir=/workspace/llm \
    --container-env=MASTER_ADDR,MASTER_PORT,HYBRID_EP_TOKENS_PER_RANK,HYBRID_EP_PAD_MULTIPLE,HYBRID_EP_CACHE_DIR,${CACHE_ENV},NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN,USE_MNNVL \
    slurm2pytorch python -u precompile_hybridep_b300.py

echo "HybridEP prebuilt cache: ${PREBUILT_CACHE}"
