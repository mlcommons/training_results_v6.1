#SBATCH --exclusive
#SBATCH --mem=0

set -euxo pipefail

                                                                              
                                                                             
export SLURM_CONF="${SLURM_CONF:-/etc/slurm/slurm.conf}"

echo "PROLOG_START $(date +%s)"

                       
: "${CONT:?CONT not set}"
: "${DGXSYSTEM:?DGXSYSTEM not set}"
: "${DATADIR:?DATADIR not set}"
: "${WALLTIME_RUNANDTIME:?WALLTIME_RUNANDTIME not set}"

                    
: "${MLPERF_RULESET:=6.1.0}"
: "${MLPERF_SCALE:='unknown'}"
: "${MLPERF_CLUSTER_NAME:='unknown'}"
: "${MILESTONE_YML:=unknown}"
: "${NEXP:=1}"
: "${NCCL_TEST:=1}"
: "${NCCL_TEST_WALLTIME:=10}"
: "${DATESTAMP:=$(date +'%y%m%d%H%M%S%N')}"
: "${CLEAR_CACHES:=1}"
: "${SET_PEAK_MEM_CLK:=0}"
: "${DROPCACHE_CMD:="sudo /sbin/sysctl vm.drop_caches=3"}"
: "${USER_DROPCACHE:=}"
: "${CHECK_COMPLIANCE:=$(( ! ${FORCE_SUCCESS_STATUS:-0} ))}"
: "${SEED:=$RANDOM}"
: "${POWERLOGDIR:=' '}"                          
: "${POWERCMDDIR:=' '}"                        
: "${LOGDIR:=./results}"
: "${EXTRA_ASSETS:=}"
: "${WORK_DIR:=/workspace/dlrmv4}"
: "${DGXNGPU:=4}"
export DGXNGPU
: "${MASTER_PORT:=29500}"
export MASTER_PORT

                                                                           
                                                              
if [[ "${SLURM_JOB_ID}" ]]; then
    export RUNSUB_DIR=$(dirname $(scontrol show job "${SLURM_JOB_ID}" | awk -F= '/Command=/{print $2}'))
else
    export RUNSUB_DIR=$(dirname "${BASH_SOURCE[0]}")
fi

                                              
                                                                          
                                                                        
                                                               
                                              
PYXIS_DEFAULTS=( '--no-container-mount-home' '--container-remap-root' '--container-writable' )
source "${RUNSUB_DIR}/submission_seeds.sh"
validate_submission_seeds

                                              
                                                          
                                              
                                           
                                                      
                                                              
                                                              
                                                                     

export MODEL_NAME="dlrmv4"
export MODEL_FRAMEWORK="pytorch"
LOGBASE="${DATESTAMP}"
export DATESTAMP LOGBASE DGXSYSTEM CONT MLPERF_SCALE MLPERF_CLUSTER_NAME MILESTONE_YML EXTRA_ASSETS
export SPREFIX="${MODEL_NAME}_${MODEL_FRAMEWORK}_${DGXNNODES}x${DGXNGPU}x${BATCH_SIZE}_${DATESTAMP}"

readonly _logfile_base="${LOGDIR}/${LOGBASE}"
readonly _cont_name="${MODEL_NAME}_${SLURM_JOB_ID}"
mounts_to_verify="DATADIR:/data"

                                                    
( umask 0002; mkdir -p "${LOGDIR}" )
srun --ntasks-per-node=1 mkdir -p "${LOGDIR}"

                 
: "${CONTAINER_IMAGE_OVERRIDE:=}"
echo MELLANOX_VISIBLE_DEVICES="${MELLANOX_VISIBLE_DEVICES:-}"
srun --ntasks-per-node=1 --container-image="${CONTAINER_IMAGE_OVERRIDE:-$CONT}" --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" true
if [[ "${PROLOG_CHECKS:-1}" -eq 1 ]]; then
    srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" ibv_devinfo --list
    srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" nvidia-smi topo -m

    set +e
                                              
    srun --ntasks-per-node=1 nvidia-smi --query-gpu=gpu_name,gpu_bus_id,vbios_version --format=csv
    srun -l --ntasks-per-node=1 bash -c "nvidia-smi -q | grep Fabric -A 4 | grep CliqueId"
    set -e
fi

                                                                     
if [[ "${SLOW_DATADIR:-}" ]]; then
    if [[ -z "${DATADIR:-}" ]]; then
        echo "ERROR: DATADIR variable is empty (would translate to root!)"
        exit 1
    fi
    srun --label --ntasks-per-node=1 --output "${_logfile_base}"_rsync.log /bin/bash -c '
        set -euo pipefail
        hostname
        umask 0000
        mkdir -p "${DATADIR}"
        rsync -rltv --delete --no-owner --no-group --no-perms --whole-file --omit-dir-times --chmod=ugo+rwx "${SLOW_DATADIR}/" "${DATADIR}"
        '
fi

source ${RUNSUB_DIR}/mounts.sh
echo _cont_mounts="${_cont_mounts}"

                                                  
_master_node="$(scontrol show hostnames "${SLURM_JOB_NODELIST-}" | head -n1)"
if [[ -n "${NCCL_SOCKET_IFNAME:-}" ]]; then
                                                                              
                                                                             
                                               
    MASTER_ADDR="$(
        srun --quiet -N1 -n1 -w "${_master_node}" \
            bash -c 'ip -4 -o addr show dev "$NCCL_SOCKET_IFNAME" scope global |
                     awk "{split(\$4, a, \"/\"); print a[1]; exit}"'
    )"
    if [[ ! "${MASTER_ADDR}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo "ERROR: could not resolve ${NCCL_SOCKET_IFNAME} IPv4 address on ${_master_node}: ${MASTER_ADDR}" >&2
        exit 1
    fi
else
    MASTER_ADDR="${_master_node}"
fi
export MASTER_ADDR
echo "using MASTER_ADDR \"${MASTER_ADDR}\" of list \"${SLURM_JOB_NODELIST}\""

                                                                               
                                                                           
                                                                              
container_env="MASTER_PORT,MASTER_ADDR${EXTRA_CONTAINER_ENV:+,${EXTRA_CONTAINER_ENV#,}}"

echo "NCCL_TEST = ${NCCL_TEST}"
if [[ ${NCCL_TEST} -eq 1 ]]; then
    set -e
    echo "NCCL_TEST_START_pytorch $(date +%s)"
    (srun --mpi=none --ntasks-per-node="${DGXNGPU}" --time="${NCCL_TEST_WALLTIME}" \
         --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-env="${container_env}" \
         --container-mounts="${_cont_mounts}" \
         slurm2pytorch bash /workspace/dlrm-portmask/with_rdma_ports.sh env NCCL_DEBUG=INFO NCCL_DEBUG_SUBSYS=INIT,NET \
         python /workspace/dlrm-portmask/nccl_preflight.py
    ) |& tee "${LOGDIR}/${SPREFIX}_nccl_pytorch.log"
    echo "NCCL_TEST_STOP $(date +%s)"
    set -e
fi

if [[ "${INIT_EXPECTED_MOUNTS:-0}" -eq 1 ]]; then
    srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-mounts="${_cont_mounts}" \
        python3 -m mlperf_common.mountcheck --expected_mounts_csv "${LOGDIR}/${SPREFIX}_expected-mounts.csv" \
            --mounts_to_verify $mounts_to_verify --initialize
fi

if [[ "${VERIFY_MOUNTS:-1}" -eq 1 ]]; then
    (srun --ntasks-per-node=1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-mounts="${_cont_mounts}" \
        python3 -m mlperf_common.mountcheck --expected_mounts_csv expected-mounts.csv --mounts_to_verify $mounts_to_verify
    ) |& tee "${LOGDIR}/${SPREFIX}_mountcheck.log"
fi

                       
if [ -f "$POWERCMDDIR/power_monitor.sh"  ]; then
    ( umask 0002; mkdir -p "${POWERLOGDIR}" )
                                          
    if [ ${SLURM_JOB_NUM_NODES} -gt 64 ]; then
        ( srun --overlap --ntasks=64 bash $POWERCMDDIR/power_monitor.sh ) &
    else
        ( srun --overlap --ntasks-per-node=1 bash $POWERCMDDIR/power_monitor.sh ) &
    fi
fi

               
if [[ -f "${TELEMETRY_SCRIPT:-}"  ]]; then
    NODENAME=$(echo "$(hostname)" | sed 's/\..*//')
    TELEMETRY_FNAME="/results/gpu_telemetry/${SLURM_JOB_ID}_${NODENAME}_gpu_telemetry.log"
    ( srun -N1 --overlap bash ${TELEMETRY_SCRIPT} ) &
    EXTRA_ASSETS="${EXTRA_ASSETS} --asset ${TELEMETRY_FNAME}"
fi

NVSMI_QUIET='nvsmi_quiet() { local out rc=0; out=$(sudo nvidia-smi "$@" 2>&1) || rc=$?; if [[ "${SLURM_NODEID}" -eq 0 || "${rc}" -ne 0 ]]; then echo "${out}"; fi; return "${rc}"; }'

                                       
if [[ "${SET_MAXQ_CLK:-0}" == "1" ]] || [[ "${SET_MINEDP_CLK:-0}" == "1" ]]; then
        if [[ "${SET_MAXQ_CLK}" == "1" ]]; then
                GPC_CLK=${MAXQ_CLK}
        fi
        if [[ "${SET_MINEDP_CLK}" == "1" ]]; then
                GPC_CLK=${MINEDP_CLK}
        fi
    srun --ntasks-per-node=1 bash -c "${NVSMI_QUIET}; nvsmi_quiet -lgc ${GPC_CLK}"
fi

                                                        
if [[ "${SET_PEAK_MEM_CLK:-0}" == "1" ]]; then
    srun --ntasks-per-node=1 bash -c "${NVSMI_QUIET}"'; for idx in {0..3}; do nvsmi_quiet -lmc 4752,4752 -i "${idx}"; done'
fi

echo "PROLOG_STOP $(date +%s)"

if [[ "${USER_DROPCACHE:-}" ]]; then
    DROPCACHE_CMD="${USER_DROPCACHE} ${DATADIR}"
fi

                 
export SEED
for _experiment_index in $(seq -w 1 "${NEXP}"); do
    export SEED=${_submission_seeds[10#${_experiment_index}-1]}
    echo "EXPERIMENT_START $(date +%s)"

    export _experiment_index
    (
        echo ":::DLPAL ${CONT} ${SLURM_JOB_ID} ${SLURM_JOB_NUM_NODES} ${SLURM_JOB_NODELIST} ${MLPERF_CLUSTER_NAME} ${DGXSYSTEM}"
        echo ":::SYSJSON $(srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" mlperf-sysjson.sh)"
        srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" bash -c 'echo ":::GITCOMMITID ${GIT_COMMIT_ID} ${LAUNCHER_GIT_COMMIT_ID}"'

        if [[ $CLEAR_CACHES == 1 ]]; then
            srun --ntasks-per-node=1 bash -c '
                 set -euo pipefail
                 host=$(hostname)
                 echo "$host sync_start"
                                                                            
                                                                             
                 sync -f "$DATADIR"
                 sync -f "$LOGDIR"
                 echo "$host sync_done"
                 cache_before=$(awk "/^Cached:/ {print \$2}" /proc/meminfo)
                 '"${DROPCACHE_CMD}"'
                 cache_after=$(awk "/^Cached:/ {print \$2}" /proc/meminfo)
                 echo "$host cache_cleared ${cache_before}kB to ${cache_after}kB"
            '
            srun --ntasks-per-node=1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" python3 -c "
import mlperf_logging.mllog as mllog
mllogger = mllog.get_mllogger()
mllogger.event(key=mllog.constants.CACHE_CLEAR, value=True)"
        fi

        echo "Beginning trial ${_experiment_index} of ${NEXP}"

                               
        export -p > "${LOGDIR}/${SLURM_JOB_ID}_${_experiment_index}.env"

        set +e
        echo "RUNANDTIME_START $(date +%s)"
        if [[ "${NODEDIAG_SIDECAR:-0}" -eq 1 ]]; then
                                                                           
                                                                               
            START_DELAY="${NODEDIAG_START_DELAY:-0}" DURATION="${NODEDIAG_DURATION:-600}" PERIOD="${NODEDIAG_PERIOD:-0.5}" \
                srun --overlap --ntasks-per-node=1 --output="${LOGDIR}/${SPREFIX}_nodediag_%N.txt" \
                bash "${RUNSUB_DIR}/nodediag_sample.sh" </dev/null >"${LOGDIR}/${SPREFIX}_nodediag_srun.log" 2>&1 &
        fi
                                                                   
        srun -l --mpi="${SLURM_MPI_TYPE:-pmix}" \
            --ntasks-per-node="${DGXNGPU}" \
            --time="${WALLTIME_RUNANDTIME}" \
            --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
            --container-mounts="${_cont_mounts}" \
            --container-workdir="${WORK_DIR}" \
            --container-env="${container_env}" \
            slurm2pytorch ./run_and_time.sh
        RUN_AND_TIME_EXIT_STATUS=$?
        echo "RUNANDTIME_STOP $(date +%s)"
        echo "${RUN_AND_TIME_EXIT_STATUS}" > "/tmp/run_and_time_exit_status_${SLURM_JOB_ID}_${_experiment_index}.txt"
        set -e

    ) |& tee "${_logfile_base}_raw_${_experiment_index}.log"
                                                                            

                                                                           
                                                                           
                            
    RUN_AND_TIME_EXIT_STATUS=$(cat "/tmp/run_and_time_exit_status_${SLURM_JOB_ID}_${_experiment_index}.txt" 2>/dev/null || echo "255")
    if [[ "${RUN_AND_TIME_EXIT_STATUS}" -ne 0 ]]; then
        echo "run_and_time.sh failed with status ${RUN_AND_TIME_EXIT_STATUS}" >&2
    fi

                                                      
    grep ":::" "${_logfile_base}_raw_${_experiment_index}.log" | sort -k5 -n -s | tee "${_logfile_base}_${_experiment_index}.log"
                        
    if [[ "${CHECK_COMPLIANCE}" -eq 1 ]]; then
      srun -N1 -n1 -w "${_master_node}" --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
           --container-mounts="$(realpath ${LOGDIR}):/results" \
           --container-workdir="/results" \
           python3 -m mlperf_logging.compliance_checker --usage training \
           --ruleset "${MLPERF_RULESET}" \
           --log_output "/results/compliance_${DATESTAMP}_${_experiment_index}.out" \
           "/results/${LOGBASE}_${_experiment_index}.log" \
      || { echo "COMPLIANCE FAILED: stopping collection" >&2; exit 1; }
      EXTRA_ASSETS="${EXTRA_ASSETS} --asset /results/compliance_${DATESTAMP}_${_experiment_index}.out"
    fi


    echo "EXPERIMENT_STOP $(date +%s)"
    if [[ "${RUN_AND_TIME_EXIT_STATUS}" -ne 0 ]]; then
        exit "${RUN_AND_TIME_EXIT_STATUS}"
    fi
done
