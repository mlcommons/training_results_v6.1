+def _b300_memory_phase(function):
+                                                                              
+    @wraps(function)
+    def wrapped(self, *args, **kwargs):
+        if os.environ.get("PRINT_MEMORY_USAGE", "0") != "1":
+            return function(self, *args, **kwargs)
+        phase = function.__name__
+        try:
+            self._log_gpu_mem(phase + "_enter")
+        except Exception:
+            log.exception("Memory diagnostic failed at %s entry", phase)
+        status = "ok"
+        try:
+            return function(self, *args, **kwargs)
+        except BaseException as error:
+            status = "error"
+            log.exception(
+                "[training-error] phase=%s rank=%s type=%s",
+                phase, self.rank, type(error).__name__,
+            )
+            raise
+        finally:
+            try:
+                self._log_gpu_mem(phase + "_exit_" + status)
+            except Exception:
+                log.exception("Memory diagnostic failed at %s exit", phase)
+    return wrapped
+
