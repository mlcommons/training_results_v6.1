+def _site_pinned_rank(node: dict, default_rank: int) -> int:
+                                                                       
+    raw_order = os.environ.get("QWEN_B300_NODE_ORDER", "")
+    if not raw_order:
+        return default_rank
+    order = raw_order.split(",")
+    if len(order) != len(set(order)) or any(not ip for ip in order):
+        raise ValueError("QWEN_B300_NODE_ORDER must contain unique node IPs")
+    ip = node["NodeManagerAddress"]
+    if ip not in order:
+        raise ValueError(f"Alive Ray node {ip} is absent from QWEN_B300_NODE_ORDER")
+    return order.index(ip) + 1
+
