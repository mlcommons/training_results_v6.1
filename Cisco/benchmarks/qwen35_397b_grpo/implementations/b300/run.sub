#SBATCH --exclusive
#SBATCH --mem=0

                                                                            
                                                                            
                                                                           
                                                                           
                                        
                                                                                                                       

set -eux

[[ -n "${CUDA_DEVICE_MAX_CONNECTIONS:-}" ]] && export CUDA_DEVICE_MAX_CONNECTIONS
[[ -n "${NCCL_LAUNCH_ORDER_IMPLICIT:-}" ]] && export NCCL_LAUNCH_ORDER_IMPLICIT

                       
: "${CONT:?CONT not set}"
: "${DGXSYSTEM:?DGXSYSTEM not set}"
: "${WALLTIME_RUNANDTIME:?WALLTIME_RUNANDTIME not set}"
: "${TRAIN_NODES:?TRAIN_NODES not set}"
: "${GEN_NODES:?GEN_NODES not set}"

                    
: "${MLPERF_RULESET:=6.1.0}"
: "${MLPERF_SCALE:='unknown'}"
: "${MLPERF_CLUSTER_NAME:='unknown'}"
: "${MILESTONE_YML:=unknown}"
: "${NEXP:=1}"
: "${CHECK_COMPLIANCE:=$(( ! ${FORCE_SUCCESS_STATUS:-0} ))}"
: "${SEED:=$RANDOM}"
: "${CLEAR_CACHES:=1}"
: "${SET_PEAK_MEM_CLK:=0}"
