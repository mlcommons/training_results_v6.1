: "${RUN_ONLY_NCCL:=0}"
: "${WORK_DIR:=/opt/nemo-rl}"
                                                
: "${BENCHMARK_DIR:=/workspace/optimized/qwen35_397b_grpo_trtllm/pytorch}"
export BENCHMARK_DIR
: "${RUN_AND_TIME_SCRIPT:=${BENCHMARK_DIR}/run_and_time.sh}"
                                                                        
                                                                      
                                                                           
                                          
: "${CONTAINER_LD_LIBRARY_PATH_PREPEND:=/usr/lib/aarch64-linux-gnu}"
export CONTAINER_LD_LIBRARY_PATH_PREPEND
                                                                     
: "${CLEAN_MPI_ENV_BEFORE_RAY:=1}"
: "${DGXNGPU:=4}"
: "${DROPCACHE_CMD:="sudo /sbin/sysctl vm.drop_caches=3"}"
: "${USER_DROPCACHE:=}"
: "${EXTRA_ASSETS:=}"
: "${SRUN_KILL_ON_BAD_EXIT:=0}"
: "${OFFLINE_EVAL:=0}"
: "${WALLTIME_OFFLINE_EVAL:=60}"
export OFFLINE_EVAL
case "${OFFLINE_EVAL}" in
    0|1) ;;
    *) echo "ERROR: OFFLINE_EVAL must be 0 or 1" >&2; exit 1 ;;
esac
                                                              
: "${TLLM_LOG_LEVEL:=info}"
export TLLM_LOG_LEVEL
                                                                     
                                                                          
                                                                          
                                                                       
: "${NRL_CONTAINER_ENV_FORWARD:=UCX_TLS,UCX_NET_DEVICES,UCX_TCP_AF_PRIO,NCCL_NVLS_ENABLE,TRTLLM_HYBRID_DISAGG_REUSE,TLLM_MAMBA_FOLD_SAVE_LAST,TLLM_ADP_PACKED_SYNC}"

                                                                                    
: "${OMP_NUM_THREADS:=16}"
export OMP_NUM_THREADS
NODE_MANAGER_PORT=${NODE_MANAGER_PORT:-1301}
OBJECT_MANAGER_PORT=${OBJECT_MANAGER_PORT:-1303}
RUNTIME_ENV_AGENT_PORT=${RUNTIME_ENV_AGENT_PORT:-1305}
DASHBOARD_AGENT_GRPC_PORT=${DASHBOARD_AGENT_GRPC_PORT:-1307}
METRICS_EXPORT_PORT=${METRICS_EXPORT_PORT:-1309}
PORT=${PORT:-1200}
RAY_CLIENT_SERVER_PORT=${RAY_CLIENT_SERVER_PORT:-1201}
DASHBOARD_PORT=${DASHBOARD_PORT:-8265}
DASHBOARD_AGENT_LISTEN_PORT=${DASHBOARD_AGENT_LISTEN_PORT:-1311}
MIN_WORKER_PORT=${MIN_WORKER_PORT:-2000}
MAX_WORKER_PORT=${MAX_WORKER_PORT:-2999}
RAY_LOG_SYNC_FREQUENCY=${RAY_LOG_SYNC_FREQUENCY:-120}
export RAY_ENABLE_UV_RUN_RUNTIME_ENV=0

num_retries=3

if [[ "${DGXNNODES}" -ne "${SLURM_JOB_NUM_NODES}" ]]; then
    echo "ERROR: DGXNNODES (${DGXNNODES}) != SLURM_JOB_NUM_NODES (${SLURM_JOB_NUM_NODES})" >&2
    exit 1
fi
if [[ "${COLOCATED_GENERATION:-0}" == "1" ]]; then
    if [[ "${TRAIN_NODES}" -ne "${DGXNNODES}" ]]; then
        echo "ERROR: colocated TRAIN_NODES (${TRAIN_NODES}) != DGXNNODES (${DGXNNODES})" >&2
        exit 1
    fi
    if [[ "${GEN_NODES}" -ne "${TRAIN_NODES}" ]]; then
        echo "ERROR: colocated GEN_NODES (${GEN_NODES}) must equal TRAIN_NODES (${TRAIN_NODES})" >&2
        exit 1
    fi
else
    if [[ "$((TRAIN_NODES + GEN_NODES))" -ne "${DGXNNODES}" ]]; then
        echo "ERROR: TRAIN_NODES (${TRAIN_NODES}) + GEN_NODES (${GEN_NODES}) != DGXNNODES (${DGXNNODES})" >&2
        exit 1
    fi
fi

if [[ $(ulimit -Hn) == "unlimited" ]] || [[ 65535 -lt $(ulimit -Hn) ]]; then
  ulimit -Sn 65535
fi

                                                                               
unset UV_CACHE_DIR

                                       
if [[ -n "${SLURM_JOB_ID:-}" && ( -z "${RUNSUB_DIR:-}" || "${OFFLINE_EVAL}" == "1" ) ]]; then
    _slurm_job_info="$(SLURM_TIME_FORMAT=standard scontrol show job "${SLURM_JOB_ID}")" || {
        _slurm_query_status=$?
        echo "ERROR: scontrol could not read Slurm job ${SLURM_JOB_ID}" >&2
        exit "${_slurm_query_status}"
    }
fi
if [[ -z "${RUNSUB_DIR:-}" ]]; then
    if [[ -n "${SLURM_JOB_ID:-}" ]]; then
        export RUNSUB_DIR=$(dirname $(awk -F= '/Command=/{print $2}' <<< "${_slurm_job_info}"))
    else
        export RUNSUB_DIR=$(dirname "${BASH_SOURCE[0]}")
    fi
fi

                                                                                   
                                                                                    
                     
GRPO_SUPPORT_DIR="$(dirname "$(readlink -f -- "${BASH_SOURCE[0]}")")"
if [[ ! -r "${GRPO_SUPPORT_DIR}/cleanup_grpo_scratch.sh" ||
      ! -r "${GRPO_SUPPORT_DIR}/grpo_teardown.sh" ]]; then
    GRPO_SUPPORT_DIR="${RUNSUB_DIR}"
fi
readonly GRPO_SUPPORT_DIR

                                                                          
source "${GRPO_SUPPORT_DIR}/utility/slurm_helpers.sh"
configure_cpus_per_worker || exit 1
initialize_gpu_cpu_affinity_settings || exit 1

source "${GRPO_SUPPORT_DIR}/cleanup_grpo_scratch.sh"
source "${GRPO_SUPPORT_DIR}/grpo_teardown.sh"
source "${GRPO_SUPPORT_DIR}/experiment_isolation.sh"
source "${GRPO_SUPPORT_DIR}/ipc_login_guard.sh"
initialize_grpo_teardown_settings
export RETAIN_GRPO_SCRATCH RETAIN_GRPO_CHECKPOINTS

PYXIS_DEFAULTS=( '--no-container-mount-home' '--container-remap-root' '--container-writable' )

                                                                             
                                                                           
export RAY_ADDRESS=auto RAY_TMPDIR=/tmp TMPDIR=/tmp
NRL_CONTAINER_ENV_FORWARD="${NRL_CONTAINER_ENV_FORWARD:+${NRL_CONTAINER_ENV_FORWARD},}RAY_ADDRESS,RAY_TMPDIR,TMPDIR"

                                                                                 
                                                                               
                                                                               
                                                       
if [[ -n "${NRL_CONTAINER_ENV_FORWARD}" ]]; then
    IFS=',' read -ra _fwd_names <<< "${NRL_CONTAINER_ENV_FORWARD}"
    _fwd_set=()
    for _fwd_name in "${_fwd_names[@]}"; do
        [[ -n "${_fwd_name}" ]] || continue
        [[ -n "${!_fwd_name:-}" ]] && _fwd_set+=("${_fwd_name}")
    done
    if (( ${#_fwd_set[@]} )); then
        _IFS=$IFS; IFS=','; PYXIS_DEFAULTS+=( "--container-env=${_fwd_set[*]}" ); IFS=$_IFS
        echo "container-env forward: ${_fwd_set[*]}"
    fi
    unset _fwd_names _fwd_name _fwd_set _IFS
fi

                                                                            
                                                                                 
                                                                              
run_grpo_experiment() (
echo "PROLOG_START $(date +%s) experiment=${_experiment_index}"
readonly _archive_logdir="$(realpath -m -- "${LOGDIR}")"
prepare_grpo_experiment_paths

            
export MODEL_NAME="${MODEL_NAME:-qwen35_397b_grpo_trtllm}"
export MODEL_FRAMEWORK="pytorch"
LOGBASE="${DATESTAMP}"
export DATESTAMP LOGBASE DGXSYSTEM CONT MLPERF_SCALE MLPERF_CLUSTER_NAME MILESTONE_YML EXTRA_ASSETS
export SPREFIX="${MODEL_NAME}_${MODEL_FRAMEWORK}_${DGXNNODES}x${DGXNGPU}_${DATESTAMP}"

                                                                         
                                                           
readonly LOG_FILE_BASE="${_archive_logdir}/${LOGBASE}"
readonly _cont_name="${MODEL_NAME}_${SLURM_JOB_ID}_exp${_experiment_index}"

                                                                     
                                                                      
                                    
( umask 0002; mkdir -p "${LOGDIR}" )
                                                                         
                                                                  
                                                       
export LOGDIR="$(realpath -e -- "${LOGDIR}")"
export RAY_CLUSTER_LOG_DIR="${LOGDIR}/ray-${SLURM_JOB_ID}.${SLURM_RESTART_COUNT:-0}"
mkdir -p "${RAY_CLUSTER_LOG_DIR}"
if [[ "${NCCL_DEBUG_FILE:-}" == /results/nccl/* ]]; then
    mkdir -p "${LOGDIR}/nccl"
fi

declare -A SRUN_PIDS=()

                                                                          
unset _checkpoint_dir
trap qwen_cleanup_with_ipc_guards EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

                                                                               
                                                                           
qwen_start_ipc_login_guards
                                                                           
                                                                         
require_fresh_grpo_container

if [[ "${OFFLINE_EVAL}" == "1" ]]; then
                                                                             
                                             
    [[ "${SLURM_RESTART_COUNT:-0}" == "0" ]] || _experiment_index=1
    validate_deferred_launch "${_slurm_job_info}"
fi

source "${RUNSUB_DIR}/mounts.sh"
echo _cont_mounts="${_cont_mounts}"

NVSMI_QUIET='nvsmi_quiet() { local out rc=0; out=$(sudo nvidia-smi "$@" 2>&1) || rc=$?; if [[ "${SLURM_NODEID}" -eq 0 || "${rc}" -ne 0 ]]; then echo "${out}"; fi; return "${rc}"; }'

                                                        
if [[ "${SET_PEAK_MEM_CLK:-0}" == "1" ]]; then
    srun --ntasks-per-node=1 bash -c "${NVSMI_QUIET}"'; for idx in {0..3}; do nvsmi_quiet -lmc 4752,4752 -i "${idx}"; done'
fi

                                      
: "${CONTAINER_IMAGE_OVERRIDE:=}"
srun --ntasks-per-node=1 --container-image="${CONTAINER_IMAGE_OVERRIDE:-$CONT}" --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" true
require_created_grpo_container
srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" ibv_devinfo --list || true
srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" nvidia-smi topo -m

nvidia-smi

if [[ "${INIT_EXPECTED_MOUNTS:-0}" -eq 1 ]]; then
    srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-mounts="${_cont_mounts}" \
        python3 -m mlperf_common.mountcheck --expected_mounts_csv "${LOGDIR}/${SPREFIX}_expected-mounts.csv" \
            --mounts_to_verify $mounts_to_verify --initialize
fi

if [[ "${VERIFY_MOUNTS:-1}" -eq 1 ]]; then
                                                                                   
    (srun --ntasks-per-node=1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-mounts="${_cont_mounts}" \
        --container-workdir="${BENCHMARK_DIR}" \
        python3 -m mlperf_common.mountcheck --expected_mounts_csv expected-mounts.csv --mounts_to_verify $mounts_to_verify
    ) |& tee -a "${_archive_logdir}/${SPREFIX}_mountcheck.log"
fi

                                                                     
                                                                            
nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | sort)
nodes_array=($nodes)
head_node=${nodes_array[0]}
                                                                        
                                                            
                                  
head_node_ip=$(getent ahostsv4 $head_node 2>/dev/null | awk '{ print $1; exit }' || true)
if [[ -z "$head_node_ip" ]]; then
    head_node_ip=$(host $head_node 2>/dev/null | awk '/has address/ { print $4 }' | head -1 || true)
fi
if [[ -z "$head_node_ip" ]]; then
    head_node_ip=$head_node
fi
ip_head=$head_node_ip:$PORT
export RAY_ADDRESS="${ip_head}"
export MASTER_ADDR=$head_node
echo "using MASTER_ADDR \"${MASTER_ADDR}\" of list \"${SLURM_JOB_NODELIST}\""

echo "NCCL_TEST = ${NCCL_TEST}"
if [[ ${NCCL_TEST} -eq 1 ]]; then
    set +e
    echo "NCCL_TEST_START $(date +%s)"
    (srun --mpi="${SLURM_MPI_TYPE:-pmix}" \
          --ntasks-per-node="${DGXNGPU}" \
          --container-name="${_cont_name}" \
          "${PYXIS_DEFAULTS[@]}" \
          --container-mounts="${_cont_mounts}" \
          --time="${NCCL_TEST_WALLTIME}" \
          all_reduce_perf_mpi -b 16M -e 4G -f 2)
    echo "NCCL_TEST_STOP $(date +%s)"
    set -e
fi
if [ ${RUN_ONLY_NCCL} -gt 0 ]; then
    exit 0
fi

                                                        
                                                   
                                                        
GRES_ARG=""
if sinfo -p $SLURM_JOB_PARTITION -h -o "%G" | grep -q "gpu:"; then
    GRES_ARG="--gres=gpu:${DGXNGPU}"
fi

COMMON_SRUN_ARGS="$GRES_ARG"
COMMON_SRUN_ARGS+=" --mpi=${SLURM_MPI_TYPE:-pmix}"
COMMON_SRUN_ARGS+=" --container-mounts=$_cont_mounts"
COMMON_SRUN_ARGS+=" --container-name=${_cont_name}"
COMMON_SRUN_ARGS+=" --container-workdir=$WORK_DIR"
COMMON_SRUN_ARGS+=" -p $SLURM_JOB_PARTITION"
if [[ -n "${SLURM_JOB_ACCOUNT:-}" ]]; then
    COMMON_SRUN_ARGS+=" -A ${SLURM_JOB_ACCOUNT}"
fi

check_srun_processes() {
  qwen_check_ipc_login_guards
  for name in "${!SRUN_PIDS[@]}"; do
    pid="${SRUN_PIDS[$name]}"
    if ! kill -0 "$pid" 2>/dev/null; then
      _grpo_scratch_log "ERROR: background srun '${name}' died (pid=${pid}); attempting to exit"
      if [[ "${SLURM_RESTART_COUNT:-0}" -eq 0 && "${OFFLINE_EVAL}" != "1" ]]; then
        cleanup_for_requeue
        trap - HUP INT TERM EXIT
        scontrol requeue "$SLURM_JOB_ID"
      fi
      exit 1
    fi
  done
}

                                                                          
                                                      
TOPO_PROBE_SCRIPT="$RAY_CLUSTER_LOG_DIR/topology_probe.sh"
                                                                               
printf 'export NRL_ENABLE_GPU_CPU_AFFINITY=%q\n' "$NRL_ENABLE_GPU_CPU_AFFINITY" > "$TOPO_PROBE_SCRIPT"
printf 'export NRL_GPU_CPU_AFFINITY_FILE=%q\n' "${NRL_GPU_CPU_AFFINITY_FILE:-}" >> "$TOPO_PROBE_SCRIPT"
cat >> "$TOPO_PROBE_SCRIPT" <<TOPO_PROBE_EOF
CLUSTER_UUID=\$(nvidia-smi -q 2>/dev/null | grep 'ClusterUUID' | head -1 | awk -F: '{print \$2}' | tr -d ' ')
if [[ -z "\$CLUSTER_UUID" ]]; then
  CLUSTER_UUID=""
fi

TOPO_RANK=""
if [[ -n "\${SLURM_TOPOLOGY_ADDR:-}" && "\${SLURM_TOPOLOGY_ADDR_PATTERN:-}" == "block.node" ]]; then
  _block_part="\${SLURM_TOPOLOGY_ADDR%%.*}"
  _node_part="\${SLURM_TOPOLOGY_ADDR##*.}"
  _block_digits=\$(echo "\$_block_part" | tr -dc '0-9')
  _node_digits=\$(echo "\$_node_part" | tr -dc '0-9')
  if [[ -n "\$_block_digits" && -n "\$_node_digits" ]]; then
    TOPO_RANK=\$(( 10#\$_block_digits * 10000000000 + 10#\$_node_digits ))
  fi
elif [[ -n "\${RAY_NODE_RANK:-}" ]]; then
  TOPO_RANK=\$(( 10#\$RAY_NODE_RANK ))
else
  _hostname_digits=\$(hostname | tr -dc '0-9')
  if [[ -n "\$_hostname_digits" ]]; then
    TOPO_RANK=\$(( 10#\$_hostname_digits ))
  fi
fi

source "${BENCHMARK_DIR}/utility/slurm_helpers.sh"
configure_gpu_cpu_affinity "$DGXNGPU" || exit 1

RAY_RESOURCES='{\"worker_units\": '"$DGXNGPU"', \"slurm_managed_ray_cluster\": 1'
if [[ -n "\$CLUSTER_UUID" ]]; then
  RAY_RESOURCES+=', \"nvlink_domain_'\${CLUSTER_UUID}'\": 1'
fi
if [[ -n "\$TOPO_RANK" ]]; then
  RAY_RESOURCES+=', \"topo_rank\": '\$TOPO_RANK
fi
RAY_RESOURCES+='}'
export RAY_RESOURCES
TOPO_PROBE_EOF

ray_node_body=$(cat <<EOF
                                                                         
export XDG_CACHE_HOME=/opt/nemo-rl/.cache/xdg
if [[ -n "${CONTAINER_LD_LIBRARY_PATH_PREPEND}" ]]; then
    export LD_LIBRARY_PATH=${CONTAINER_LD_LIBRARY_PATH_PREPEND}\${LD_LIBRARY_PATH:+:\${LD_LIBRARY_PATH}}
fi

exit-dramatically() {
    pkill -P \$\$ || true
    kill -TERM 0 || true
    exit 1
}
export -f exit-dramatically

                                                                             
                                                                              
                                                                        
if [[ -n "${NRL_RUNTIME_PATCH_CONTAINER:-}" ]]; then
  if git -C /opt/nemo-rl apply --check "${NRL_RUNTIME_PATCH_CONTAINER:-}"; then
    git -C /opt/nemo-rl apply "${NRL_RUNTIME_PATCH_CONTAINER:-}"
    echo "Applied runtime NeMo-RL patch ${NRL_RUNTIME_PATCH_CONTAINER:-}"
  elif git -C /opt/nemo-rl apply --reverse --check "${NRL_RUNTIME_PATCH_CONTAINER:-}"; then
    echo "Runtime NeMo-RL patch already applied"
  else
    echo "ERROR: runtime NeMo-RL patch does not apply: ${NRL_RUNTIME_PATCH_CONTAINER:-}" >&2
    exit 1
  fi
fi

monitor-sidecar() {
  set +x
  while true; do
    sleep 60
    if [[ -f "$RAY_CLUSTER_LOG_DIR/ENDED" ]]; then
      echo "Detected ENDED file, terminating..."
      exit-dramatically
    fi
  done
}
monitor-sidecar &

log-sync-sidecar() {
  set +x
  mkdir -p $RAY_CLUSTER_LOG_DIR/ray/\$(hostname)
  while true; do
    sleep $RAY_LOG_SYNC_FREQUENCY
    if ls /tmp/ray/session_[0-9]* > /dev/null 2>&1; then
      for session_dir in /tmp/ray/session_[0-9]*/; do
        if [[ -d "\$session_dir/logs" ]]; then
          session_name=\$(basename "\$session_dir")
          mkdir -p "$RAY_CLUSTER_LOG_DIR/ray/\$(hostname)/\$session_name"
          rsync -ahP "\$session_dir/logs/" "$RAY_CLUSTER_LOG_DIR/ray/\$(hostname)/\$session_name/logs/" 2>/dev/null || true
        fi
      done
    fi
    if [[ -f "$RAY_CLUSTER_LOG_DIR/ENDED" ]]; then
      echo "Log sync sidecar terminating..."
      break
    fi
  done
}
log-sync-sidecar &

                                                                   
sed -i 's/context\.py_executable = " "\.join(self\.nsight_cmd) + " python"/context.py_executable = " ".join(self.nsight_cmd) + f" {context.py_executable}"/g' /opt/nemo_rl_venv/lib/python*/site-packages/ray/_private/runtime_env/nsight.py || true

source $RAY_CLUSTER_LOG_DIR/topology_probe.sh

                                                                               
if [[ "${CLEAN_MPI_ENV_BEFORE_RAY}" == "1" ]]; then
    for v in \$(env | awk -F= '/^(PMI|PMIX|MPI|OMPI|SLURM)_/ && !/^OMPI_ALLOW_RUN_AS_ROOT/{print \$1}'); do
        unset "\$v"
    done
fi
EOF
)

head_cmd=$(cat <<EOF
RAY_NODE_RANK=0
touch $RAY_CLUSTER_LOG_DIR/STARTED_RAY_HEAD
$ray_node_body

cat <<EOFINNER | tee /launch-head.sh
ray stop --force || true
rm -rf /tmp/ray/session_latest /tmp/ray/session_[0-9]* || true
ray start --head \
    --disable-usage-stats \
    --resources="\$RAY_RESOURCES" \
    --node-ip-address="$head_node_ip" \
    --port=${PORT} \
    --ray-client-server-port=${RAY_CLIENT_SERVER_PORT} \
    --dashboard-port=${DASHBOARD_PORT} \
    --dashboard-host="$head_node_ip" \
    --include-dashboard=True \
    --min-worker-port=${MIN_WORKER_PORT} \
    --max-worker-port=${MAX_WORKER_PORT} \
    --node-manager-port=$((${NODE_MANAGER_PORT} + 1)) \
    --object-manager-port=$((${OBJECT_MANAGER_PORT} + 1)) \
    --runtime-env-agent-port=$((${RUNTIME_ENV_AGENT_PORT} + 1)) \
    --dashboard-agent-grpc-port=$((${DASHBOARD_AGENT_GRPC_PORT} + 1)) \
    --dashboard-agent-listen-port=$((${DASHBOARD_AGENT_LISTEN_PORT} + 1)) \
    --metrics-export-port=$((${METRICS_EXPORT_PORT} + 1)) \
    --block
EOFINNER
chmod +x /launch-head.sh

count=0
while [[ \$count -lt $num_retries ]]; do
  bash /launch-head.sh
  count=\$((count+1))
  echo "Head node failed \$count/$num_retries times, restarting in 5 seconds..."
  sleep 5
done
touch $RAY_CLUSTER_LOG_DIR/ENDED
exit 1
EOF
)
srun $COMMON_SRUN_ARGS "${PYXIS_DEFAULTS[@]}" --nodes=1 --ntasks=1 --cpus-per-task=$CPUS_PER_WORKER -w "$head_node" -o $RAY_CLUSTER_LOG_DIR/ray-head.log bash -x -c "$head_cmd" &
SRUN_PIDS["ray-head"]=$!

NUM_ACTORS=$((DGXNGPU * SLURM_JOB_NUM_NODES))

                                      
while check_srun_processes && ! srun --overlap --nodes=1 --ntasks=1 -w $head_node test -f $RAY_CLUSTER_LOG_DIR/STARTED_RAY_HEAD; do
  echo "[INFO][$(date)] Waiting for head node container to start..."
  sleep 2
done

                                                                     
extract_worker_units() {
  status_output=$(srun --overlap --container-name=${_cont_name} "${PYXIS_DEFAULTS[@]}" --nodes=1 --ntasks=1 -w "$head_node" ray status) || status_output=
  if echo "$status_output" | grep -q "worker_units"; then
    worker_units=$(echo "$status_output" | grep "worker_units" | awk -F'[/. ]' '{print $4}')
    echo $worker_units
  else
    echo 0
  fi
}

                                                                       
                                                                             
while true; do
  check_srun_processes
  worker_units=$(extract_worker_units)
  if [[ "$worker_units" -ge "$DGXNGPU" ]]; then
    break
  fi
  echo "[INFO] Waiting for Ray on the head node..."
  sleep 2
done

worker_nodes=$((SLURM_JOB_NUM_NODES - 1))
if [[ "$worker_nodes" -gt 0 ]]; then
  worker_cmd=$(cat <<EOF
RAY_NODE_RANK=\$((SLURM_PROCID + 1))
$ray_node_body

cat <<EOFINNER | tee /launch-worker.sh
ray stop --force || true
rm -rf /tmp/ray/session_latest /tmp/ray/session_[0-9]* || true
ray start --address "$ip_head" \
          --disable-usage-stats \
          --resources="\$RAY_RESOURCES" \
          --min-worker-port=${MIN_WORKER_PORT} \
          --max-worker-port=${MAX_WORKER_PORT} \
          --node-manager-port=${NODE_MANAGER_PORT} \
          --object-manager-port=${OBJECT_MANAGER_PORT} \
          --runtime-env-agent-port=${RUNTIME_ENV_AGENT_PORT} \
          --dashboard-agent-grpc-port=${DASHBOARD_AGENT_GRPC_PORT} \
          --dashboard-agent-listen-port=${DASHBOARD_AGENT_LISTEN_PORT} \
          --metrics-export-port=${METRICS_EXPORT_PORT} \
          --block
EOFINNER

count=0
while [[ \$count -lt $num_retries ]]; do
  bash /launch-worker.sh
  count=\$((count+1))
  echo "Worker failed \$count/$num_retries times, restarting in 5 seconds..."
  sleep 5
done
touch $RAY_CLUSTER_LOG_DIR/ENDED
exit 1
EOF
)
                                                                        
                                                                           
  srun $COMMON_SRUN_ARGS "${PYXIS_DEFAULTS[@]}" --exact \
       --nodes="$worker_nodes" --ntasks="$worker_nodes" --ntasks-per-node=1 \
       --cpus-per-task="$CPUS_PER_WORKER" --exclude="$head_node" \
       --kill-on-bad-exit=1 -o "$RAY_CLUSTER_LOG_DIR/ray-worker-%N.log" \
       bash -x -c "$worker_cmd" &
  SRUN_PIDS["ray-workers"]=$!
fi

                                                           
while true; do
  worker_units=$(extract_worker_units)
  echo "[INFO] Number of actors online: $worker_units/$NUM_ACTORS"
  if [[ "$worker_units" -eq "$NUM_ACTORS" ]]; then
    break
  fi
  check_srun_processes
  sleep 2
done

echo "All Ray workers connected!"

echo "PROLOG_STOP $(date +%s)"

if [[ "${USER_DROPCACHE:-}" ]]; then
    DROPCACHE_CMD="${USER_DROPCACHE}"
fi

                                                                           
                                       
_checkpoint_base="${CHECKPOINT_DIR:-/checkpoint}"
    echo "EXPERIMENT_START $(date +%s)"

    export _experiment_index
    if [[ "${OFFLINE_EVAL}" == 1 && "${NEXP}" -gt 1 ]]; then
        export CHECKPOINT_DIR="${_checkpoint_base%/}/${_experiment_index}"
    fi
    (
        echo "Beginning trial ${_experiment_index} of ${NEXP}"

                               
        export -p > "${_archive_logdir}/${SLURM_JOB_ID}_${_experiment_index}.env"

        echo ":::DLPAL ${CONT} ${SLURM_JOB_ID} ${SLURM_JOB_NUM_NODES} ${SLURM_JOB_NODELIST} ${MLPERF_CLUSTER_NAME} ${DGXSYSTEM}"
        echo ":::SYSJSON $(srun -N1 -n1 --overlap --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" mlperf-sysjson.sh)"
        srun -N1 -n1 --overlap --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" bash -c 'echo ":::GITCOMMITID ${GIT_COMMIT_ID} ${LAUNCHER_GIT_COMMIT_ID}"'

                                                                             
                                                                            
        if [ "${CLEAR_CACHES}" -eq 1 ]; then
            srun --overlap --exact --nodes="${SLURM_JOB_NUM_NODES}" \
                 --ntasks="${SLURM_JOB_NUM_NODES}" --ntasks-per-node=1 \
                 --cpus-per-task=1 --kill-on-bad-exit=1 bash -euc '
                 host=$(hostname)
                 echo "$host sync_start"
                 sync
                 echo "$host sync_done"
                 cache_before=$(awk "/^Cached:/ {print \$2}" /proc/meminfo)
                 '"${DROPCACHE_CMD}"'
                 cache_after=$(awk "/^Cached:/ {print \$2}" /proc/meminfo)
                 echo "$host cache_cleared ${cache_before}kB to ${cache_after}kB"
            '
            srun -N1 -n1 --overlap --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" --container-mounts="${_cont_mounts}" \
                --container-workdir="${BENCHMARK_DIR}" \
                python -c "
from callback_logging import mllogger
mllogger.event(key=mllogger.constants.CACHE_CLEAR, value=True)"
        fi

        if [[ "${OFFLINE_EVAL}" == "1" ]]; then
            _slurm_job_info="$(SLURM_TIME_FORMAT=standard scontrol show job "${SLURM_JOB_ID}")" || {
                _slurm_query_status=$?
                echo "ERROR: scontrol could not read Slurm job ${SLURM_JOB_ID}" >&2
                exit "${_slurm_query_status}"
            }
            validate_deferred_launch "${_slurm_job_info}"
        fi

                                                                     
        set +e
        echo "RUNANDTIME_START $(date +%s)"
        srun -N1 -n1 --overlap \
             --time="${WALLTIME_RUNANDTIME}" \
             --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
             --container-mounts="${_cont_mounts}" \
             --container-workdir=${WORK_DIR} \
             -w "$head_node" \
             bash -c '[[ -z "${CONTAINER_LD_LIBRARY_PATH_PREPEND:-}" ]] || export LD_LIBRARY_PATH="${CONTAINER_LD_LIBRARY_PATH_PREPEND}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; exec bash "$@"' _ "${RUN_AND_TIME_SCRIPT}"
        RUN_AND_TIME_EXIT_STATUS=$?
        echo "RUNANDTIME_STOP $(date +%s)"
        if [[ "${OFFLINE_EVAL}" == "1" && "${RUN_AND_TIME_EXIT_STATUS}" -eq 0 ]]; then
                                                                           
                                                                               
            export RAY_ADDRESS="${ip_head}"
            echo "DEFERRED_EVAL_START $(date +%s)"
            srun -N1 -n1 --overlap \
                 --time="${WALLTIME_OFFLINE_EVAL}" \
                 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
                 --container-mounts="${_cont_mounts}" \
                 --container-workdir="${WORK_DIR}" \
                 -w "$head_node" \
                 bash -c '[[ -z "${CONTAINER_LD_LIBRARY_PATH_PREPEND:-}" ]] || export LD_LIBRARY_PATH="${CONTAINER_LD_LIBRARY_PATH_PREPEND}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; exec bash "$@"' _ "${RUN_AND_TIME_SCRIPT}" --deferred-eval
            RUN_AND_TIME_EXIT_STATUS=$?
            echo "DEFERRED_EVAL_STOP status=${RUN_AND_TIME_EXIT_STATUS} $(date +%s)"
        fi
                                                                           
        echo "${RUN_AND_TIME_EXIT_STATUS}" > "${LOGDIR}/run_and_time_exit_status_${SLURM_JOB_ID}_${_experiment_index}.txt"
        set -e

    ) |& tee "${LOG_FILE_BASE}_${_experiment_index}.log"

    RUN_AND_TIME_EXIT_STATUS=$(cat "${LOGDIR}/run_and_time_exit_status_${SLURM_JOB_ID}_${_experiment_index}.txt" 2>/dev/null || echo "255")

    if [[ "${CHECK_COMPLIANCE}" -eq 1 ]]; then
      _compliance_status=0
      _compliance_report="/results/compliance_${DATESTAMP}.out"
                                                                              
                                          
      srun -N1 -n1 --overlap --container-image="${CONTAINER_IMAGE_OVERRIDE:-$CONT}" "${PYXIS_DEFAULTS[@]}" \
           --container-mounts="${_archive_logdir}:/results" \
           --container-workdir="/results" \
           python3 -m mlperf_logging.compliance_checker --usage training \
           --ruleset "${MLPERF_RULESET}" \
           --log_output "${_compliance_report}" \
           "/results/${LOGBASE}_${_experiment_index}.log" \
      || _compliance_status=$?
      EXTRA_ASSETS="${EXTRA_ASSETS} --asset ${_compliance_report}"
                                                                        
                                                                         
                                                                         
      if [[ "${OFFLINE_EVAL}" == 1 && -z "${QWEN_EVAL_ONLY_CHECKPOINT_ROOT:-}" &&
            "${_compliance_status}" -ne 0 ]]; then
          echo "QWEN_COMPLIANCE_GATE: FAILED status=${_compliance_status}; stopping the run chain" >&2
          exit "${_compliance_status}"
      fi
    fi


    echo "EXPERIMENT_STOP $(date +%s)"
    if [[ "${RUN_AND_TIME_EXIT_STATUS}" -ne 0 ]]; then
        exit "${RUN_AND_TIME_EXIT_STATUS}"
    fi
                                                                              
                                                                                 
                                                                           
                                             
_teardown_status=0
_run_grpo_teardown || _teardown_status=$?
qwen_stop_ipc_login_guards
trap - EXIT
exit "${_teardown_status}"
)

if [[ ! "${NEXP}" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: NEXP must be a positive integer without leading zeroes" >&2
    exit 1
fi
export SEED
for _experiment_index in $(seq -w 1 "${NEXP}"); do
    export _experiment_index
    run_grpo_experiment
    SEED=$RANDOM     # choose a new seed for the next experiment
done
