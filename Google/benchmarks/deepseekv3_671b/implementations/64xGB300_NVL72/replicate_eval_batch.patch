+def _replicate_microbatches(it, k):
+    """Yield each item from `it` `k` times in a row. Used to inflate eval num_microbatches
+    when eval_global_batch_size is too small for the (PP, VP) topology."""
+    while True:
+        item = next(it)
+        for _ in range(k):
+            yield item
+
