+    def _ak_flush_pending_adds(self):
+        """auto_kernel X8: apply the deferred `main_grad += grad` of this bucket group."""
+        pending = getattr(self, "_ak_pending_adds", None)
+        if not pending:
+            return
+        # torch._foreach_add_ groups by (device, dtype); every pair here is a bf16 main_grad
+        # view and its bf16 autograd grad, so the fast path is one fused launch per dtype group.
+        # Under X7 (buffer not zeroed) a single contribution is COPIED instead -- per param:
+        # a zero_out_wgrad weight (two contributions per step, its main_grad still zeroed)
+        # is always ADDED, whatever the group's mode.
+        to_copy = [(m, g) for m, g, p in pending if getattr(p, "_ak_x7_store", False)]
+        to_add = [(m, g) for m, g, p in pending if not getattr(p, "_ak_x7_store", False)]
+        if to_copy:
+            torch._foreach_copy_([m for m, g in to_copy], [g for m, g in to_copy])
+        if to_add:
+            torch._foreach_add_([m for m, g in to_add], [g for m, g in to_add])
+        mains = [m for m, g, p in pending]
+        for m, g, p in pending:
+            p.grad = None
+        self._ak_pending_adds = []
+        self._ak_flushes = getattr(self, "_ak_flushes", 0) + 1
+        if self._ak_flushes <= 2 and torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
+            print("[auto_kernel x8] bucket group flushed %d deferred grad adds in one _foreach_add_ (%d params in group)"
+                  % (len(mains), len(self.params)), flush=True)
+
