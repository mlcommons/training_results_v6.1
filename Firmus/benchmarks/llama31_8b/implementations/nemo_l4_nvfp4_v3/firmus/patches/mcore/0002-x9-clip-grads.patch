+# branch, so the fold now sits inside `elif norm_type == 2.0`; behaviour unchanged.)
+import os as _ak_os
+import sys as _ak_sys
+_AK_X9_FOLD = _ak_os.environ.get("AK_X9_FOLD", "0") == "1"
+_ak_fold_norm = None
