+def _ak_fold_l2norm(grads_for_norm):
+    """norm() of the fold module over the bf16 shard views; a 1-element fp32 tensor like TE's."""
+    global _ak_fold_norm, _ak_fold_announced
+    if _ak_fold_norm is None:
+        _ak_fold_norm = _ak_fold_mod.FusedAdamWMaster(device=torch.cuda.current_device())
+    if not _ak_fold_announced:
