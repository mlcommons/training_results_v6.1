+            path = _ak_fold_mod.__file__
+            sha = _h.sha256(open(path, "rb").read()).hexdigest()[:16]
+            print("[auto_kernel x9fold] norm pass ARMED: {} shards, dtype {}, module {} sha256={}".format(
+                len(grads_for_norm), grads_for_norm[0].dtype if grads_for_norm else None, path, sha), flush=True)
+    return _ak_fold_norm.norm(grads_for_norm)
