+def _ak_x12_armed(tensor_format, interleaved, cp_size, start_positions, t):
+    return (_AK_X12_ROPE and _ak_x12_mod is not None and tensor_format == "sbhd" and not interleaved
+            and cp_size == 1 and start_positions is None and t.dtype == torch.bfloat16 and t.dim() == 4)
+
+
+def _ak_x12_instance(device):
+    global _ak_x12_rope
+    if _ak_x12_rope is None:
+        _ak_x12_rope = _ak_x12_mod.FusedQKVRoPE(device=device)
