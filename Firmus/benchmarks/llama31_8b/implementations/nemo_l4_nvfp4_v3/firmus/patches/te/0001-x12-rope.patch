+def _ak_x12_packed_forward(inst, qkv, q_freqs, k_freqs, split):
+    s, b, h, total = qkv.shape
+    qs, ks, vs = split
+    d = q_freqs.shape[-1]
+    assert total == qs + ks + vs and ks == d and vs == d and qs % d == 0
+    nq = qs // d
+    nqe, nke = s * b * h * nq * d, s * b * h * d
+    flat = torch.empty(nqe + 2 * nke, dtype=qkv.dtype, device=qkv.device)
+    q = flat[:nqe].view(s, b, h * nq, d)
+    k = flat[nqe:nqe + nke].view(s, b, h, d)
+    v = flat[nqe + nke:].view(s, b, h, d)
+    tab, same = inst._angles(q_freqs, k_freqs, s, d)
+    if _ak_x12a_mod is not None:
+        part = torch.empty(s * b, dtype=torch.float32, device=qkv.device)
+        if _AK_QKVA_REG["deferred"] is not None and _AK_QKVA_REG["part"] is not None:
+            raise RuntimeError("[auto_kernel x12] a q|k|v buffer left unwritten (QKV direct) was never quantized")
+        direct = None
+        if _ak_x12d_mod is not None:
+            direct = dict(qkv=qkv, tab=tab, b=b, n_prog=s * b, nqe=nqe, nke=nke, D=d, NQ=nq, H=h, TOTAL=total,
+                          SAME=same)
+            cu = _ak_qkvx_direct(qkv, tab, same, d, b)
+            if cu is not None:
+                direct.update(p1=cu[0], p2=cu[1], impl="cuda v{} p1 rev {} p2 rev {}".format(
+                    cu[2], int(_AK_QKV_DIRECT_P1_REV), int(_AK_QKV_DIRECT_P2_REV)))
+        if direct is not None and _AK_QKVA_REG["direct_ok"] and torch.cuda.is_current_stream_capturing():
+            if "p1" in direct:
+                direct["p1"](part)
+            else:
+                k1 = (_ak_x12d_mod._qkv_rope_amax_only_kernel2 if _AK_QKV_DIRECT_P1 == "2"
+                      else _ak_x12d_mod._qkv_rope_amax_only_kernel)
+                k1[(s * b,)](qkv, tab, part, b, D=d, NQ=nq, H=h, TOTAL=total, SAME=same,
+                             num_warps=_AK_QKV_DIRECT_W1)
+            deferred = direct
+            _AK_QKVA_REG["deferred_launches"] += 1
+        else:
+            _ak_x12a_mod._qkv_rope_fwd_amax_kernel[(s * b,)](qkv, tab, q, k, v, part, b,
+                                                             D=d, NQ=nq, H=h, TOTAL=total, SAME=same,
+                                                             num_warps=_ak_x12_mod._NUM_WARPS)
+            deferred = None
+        _AK_QKVA_REG.update(ptr=flat.data_ptr(), numel=flat.numel(), part=part,
+                            launches=_AK_QKVA_REG["launches"] + 1, direct=direct, deferred=deferred)
+    else:
+        _ak_x12_mod._qkv_rope_fwd_kernel[(s * b,)](qkv, tab, q, k, v, b,
+                                                   D=d, NQ=nq, H=h, TOTAL=total, SAME=same,
+                                                   num_warps=_ak_x12_mod._NUM_WARPS)
+    return q, k, v
+# -------------------------------------------------------------------------------------------------------------------
