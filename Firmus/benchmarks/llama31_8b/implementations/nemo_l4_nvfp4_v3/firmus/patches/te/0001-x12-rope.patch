+# --- auto_kernel QKV-pack (2026-10-02, sec 168) -------------------------------------------------------------------
+# Under FP8 attention (Float8CurrentScaling) TE's combine_and_quantize concatenates the bf16 q, k, v into one buffer
+# (torch.cat, ~92 us and 0.5 GB of traffic per layer) and quantizes that buffer with one scale.  With AK_QKV_PACK=1 the
+# rope_qkv module's forward kernel writes q, k, v into three contiguous views of ONE flat buffer laid out exactly as that
+# cat would build it ([q | k | v], each in its own [s, b, heads, d] order); the kernel, its grid and its stores are the
+# module's own (FusedQKVRoPE.forward, re-launched here with packed output pointers).  The matching hunk in TE's
+# dot_product_attention/utils.py quantizes the adjacent views in place instead of concatenating them.
+_AK_QKV_PACK = _ak_os.environ.get("AK_QKV_PACK", "0") == "1"
+# --- auto_kernel QKVA (Llama 3.1 8B campaign, 2026-10-02): with AK_QKV_AMAX=1 the packed forward launches
+# fused_qkv_rope_amax._qkv_rope_fwd_amax_kernel (the same stores) which also writes one partial max |y| per (s, b)
+# position; the packed buffer's pointer, size and partials are registered here, and the FP8 current-scaling quantize of
+# exactly that buffer (the ak_l8b_fp8cs patch) takes its amax from them instead of a pass over the buffer.
+_AK_QKV_AMAX = _ak_os.environ.get("AK_QKV_AMAX", "0") == "1"
+_AK_QKVA_REG = {"ptr": None, "numel": 0, "part": None, "launches": 0, "direct": None, "deferred": None,
+                "direct_ok": False, "deferred_launches": 0}
+_ak_x12a_mod = None
+if _AK_X12_ROPE and _AK_QKV_AMAX:
+    import fused_qkv_rope_amax as _ak_x12a_mod
+# --- auto_kernel QKV direct (Llama 3.1 8B campaign, 2026-10-07): with AK_QKV_DIRECT=1 (needs AK_QKV_AMAX=1 and the
+# fp8cs2 overlay) every packed forward also registers what the FP8 quantize of its buffer needs to write the FP8 bytes
+# straight from the RoPE's own inputs (fused_qkv_rope_fp8._qkv_rope_fp8_kernel: the same bf16 values, times the scale,
+# TE's satfinite cast).  Once the fp8cs2 patch has checked that path against tex.quantize of a written buffer (its first
+# eager quantize; it then sets _AK_QKVA_REG["direct_ok"]), a packed forward under CUDA-graph capture launches only
+# fused_qkv_rope_fp8._qkv_rope_amax_only_kernel (the partial maxima, no q / k / v stores) and leaves the bf16 buffer
+# unwritten: TE's FP8 attention (current scaling, O in F16) saves only the FP8 q, k, v, and combine_and_quantize reads
+# the buffer only through that quantize.  A deferred buffer the next packed forward finds unquantized raises.
+_AK_QKV_DIRECT = _ak_os.environ.get("AK_QKV_DIRECT", "0") == "1" and _AK_QKV_AMAX
+# the partial-maxima pass: kernel version (1: five block reductions, 2: three) and warps per (s, b) position
+_AK_QKV_DIRECT_P1 = _ak_os.environ.get("AK_QKV_DIRECT_P1", "1")
+_AK_QKV_DIRECT_W1 = int(_ak_os.environ.get("AK_QKV_DIRECT_W1", "2"))
+_ak_x12d_mod = None
+if _AK_X12_ROPE and _AK_QKV_DIRECT:
+    import fused_qkv_rope_fp8 as _ak_x12d_mod
+# --- auto_kernel QKV gradient amaxes + QKV direct in CUDA (Llama 3.1 8B campaign, 2026-10-07): ak_l8b_qkvx (a CUDA
+# extension next to the Triton modules in AK_X12_KERNEL_DIR) --
+#  * AK_QKV_GRAD_AMAX=1: the RoPE backward is ak_l8b_qkvx.rope_bwd_amax -- _qkv_rope_bwd_kernel's arithmetic and stores,
+#    plus in the same pass the two amaxes the QKV linear's NVFP4 gradient quantizer takes of the result (the pre-RHT
+#    amax and the post-RHT amax of the columnwise copy, ak_l8b_rht_epi.cuh: TE's own amax instructions).  They are
+#    registered with the NVFP4P patch exactly as its fused norm backward registers the residual gradient's
+#    (ak_l8b_nvfp4p_patch._STATE["bwd_reg"], site "rope_bwd"): the next tex.quantize of exactly that tensor (the QKV
+#    linear's grad_output, a view of it) runs the cast with them, and its separate amax pass (ak_l8b_nvfp4b.rht_amax,
+#    PROF-L2k 39.5 us per layer) is gone.  The first eager call checks the gradient against TE (the x12 check below) and
+#    the amaxes against ak_l8b_nvfp4b.rht_amax of the same tensor, bit for bit; the NVFP4P patch checks the quantize with
+#    them against TE's own quantize.  Only without a pending registration, for d 128, (s * b) % 32 == 0, nq even.
+#  * AK_QKV_DIRECT_IMPL=cuda: QKV direct's two passes are ak_l8b_qkvx.rope_fwd_partials and rope_fwd_fp8 (the same
+#    partials and bytes as the Triton kernels; one CTA per s with each thread's angles in registers), handed to the
+#    fp8cs patch (version 3) as callables in the registry ("p1", "p2") so its eager check proves what runs under capture.
+_AK_QKV_GRAD_AMAX = _ak_os.environ.get("AK_QKV_GRAD_AMAX", "0") == "1"
+_AK_QKV_DIRECT_IMPL = _ak_os.environ.get("AK_QKV_DIRECT_IMPL", "triton")
+_AK_QKV_DIRECT_P1_REV = _ak_os.environ.get("AK_QKV_DIRECT_P1_REV", "0") == "1"
+_AK_QKV_DIRECT_P2_REV = _ak_os.environ.get("AK_QKV_DIRECT_P2_REV", "1") == "1"
+# kernel versions (ak_l8b_qkvx): 2 = any shape; 30-35 / 30-34 = version 3, the Llama shape compile-time (h 8 groups of
+# nq 4 + 2 heads, b 2), its CTA-shape variants -- taken only for that shape, version 2 otherwise
+_AK_QKVX_BWD_VER = int(_ak_os.environ.get("AK_QKVX_BWD_VER", "2"))
+_AK_QKVX_P1_VER = int(_ak_os.environ.get("AK_QKVX_P1_VER", "2"))
+_AK_QKVX_P2_VER = int(_ak_os.environ.get("AK_QKVX_P2_VER", "2"))
+_ak_qkvx = None
+if _AK_X12_ROPE and (_AK_QKV_GRAD_AMAX or (_AK_QKV_DIRECT and _AK_QKV_DIRECT_IMPL == "cuda")):
+    import ak_l8b_qkvx as _ak_qkvx
+_AK_QKVG = {"checked": False, "fused": 0, "registered": 0, "skipped": 0}
+
+
+def _ak_qkvx_ver(ver, h, nq, b):
+    return ver if (ver < 30 or (h == 8 and nq == 4 and b == 2)) else 2
+
+
+def _ak_qkvx_direct(qkv, tab, same, d, b):
+    """the CUDA passes of QKV direct for this packed forward, as callables (None when the shape is not covered)"""
+    if (_ak_qkvx is None or _AK_QKV_DIRECT_IMPL != "cuda" or d != 128 or not 1 <= b <= 4 or not qkv.is_contiguous()
+            or qkv.dtype != torch.bfloat16 or qkv.data_ptr() % 16 != 0):
+        return None
+    v1 = _ak_qkvx_ver(_AK_QKVX_P1_VER, qkv.size(2), qkv.size(3) // 128 - 2, b)
+    v2 = _ak_qkvx_ver(_AK_QKVX_P2_VER, qkv.size(2), qkv.size(3) // 128 - 2, b)
+    return (lambda part: _ak_qkvx.rope_fwd_partials(qkv, tab, same, part, _AK_QKV_DIRECT_P1_REV, v1),
+            lambda ws, data: _ak_qkvx.rope_fwd_fp8(qkv, tab, same, ws, data, _AK_QKV_DIRECT_P2_REV, v2),
+            "{} / {}".format(v1, v2))
+
+
+def _ak_qkvg_backward(rope, dq, dk, dv, q_freqs, k_freqs, split, s, b, d):
+    """ak_l8b_qkvx.rope_bwd_amax with its amaxes registered for the next gradient quantize; None: not taken"""
+    patch = _ak_sys.modules.get("ak_l8b_nvfp4p_patch")
+    st = getattr(patch, "_STATE", None) if patch is not None else None
+    if not getattr(patch, "_ARMED", False) or not isinstance(st, dict) or "bwd_reg" not in st:
+        return None
+    qs, ks, vs = split
+    nq = qs // d
+    rows = s * b
+    if (d != 128 or ks != d or vs != d or qs % d != 0 or (nq + 2) % 2 != 0 or rows % 32 != 0 or rows // 32 > 65535
+            or any(t.dtype != torch.bfloat16 for t in (dq, dk, dv))):
+        return None
+    tab, same = rope._angles(q_freqs.contiguous(), k_freqs.contiguous(), s, d)
+    mask = int(st.get("rht_mask", 0xD7E8))
+    ver = _ak_qkvx_ver(_AK_QKVX_BWD_VER, dk.size(2), nq, b)
+    dqkv, am = _ak_qkvx.rope_bwd_amax(dq.contiguous(), dk.contiguous(), dv.contiguous(), tab, same, mask, ver)
+    _AK_QKVG["fused"] += 1
+    if not _AK_QKVG["checked"] and not torch.cuda.is_current_stream_capturing():
+        _AK_QKVG["checked"] = True
+        ref = patch._ext_b().rht_amax(dqkv.view(rows, -1), mask)
+        ok = bool(torch.equal(ref.view(torch.int32), am.view(torch.int32)))
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+        if rank == 0:
+            import hashlib as _h
+            path = _ak_qkvx.__file__
+            print("[auto_kernel x12] RoPE backward + the gradient quantizer's pre/post-RHT amaxes ARMED (dqkv {}, mask "
+                  "{:#x}): module {} sha256={} v{}; amaxes ({:.6g}, {:.6g}) bit-equal to ak_l8b_nvfp4b.rht_amax of the "
+                  "gradient: {}".format(list(dqkv.shape), mask, _ak_os.path.basename(path),
+                                        _h.sha256(open(path, "rb").read()).hexdigest()[:16], ver, float(am[0]),
+                                        float(am[1]), ok), flush=True)
+        if not ok:
+            raise RuntimeError("[auto_kernel x12] E0 self-check FAILED for the RoPE backward's amaxes: {} v {}".format(
+                am.tolist(), ref.tolist()))
+    if st["bwd_reg"] is None:
+        import weakref
+        st["bwd_reg"] = {"ref": weakref.ref(dqkv), "ver": dqkv._version, "a_pre": am[0:1], "a_post": am[1:2],
+                         "mask": mask, "site": "rope_bwd"}
+        _AK_QKVG["registered"] += 1
+    else:
+        _AK_QKVG["skipped"] += 1
+    return dqkv
+
