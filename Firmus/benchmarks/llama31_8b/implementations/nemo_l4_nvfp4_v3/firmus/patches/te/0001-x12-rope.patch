+# --- auto_kernel X12 first-call byte check (Llama 3.1 8B campaign, 2026-10-02) --------------------------------------
+# The gpt-oss overlay had no live check (its E0 rested on the rope_qkv task's cases under TE 2.15 / Triton 3.6).  Here the
+# first eager forward and the first eager backward (warm-up iteration 0, before any graph capture) also run TE's own
+# tex.fused_qkv_rope_forward / _backward on the same inputs and compare the outputs as bytes, on every rank.  Rank 0 prints
+# one line each; a mismatch raises.
+_AK_X12_CHECKED = {"fwd": False, "bwd": False}
+
+
+def _ak_x12_bytes_equal(a, b):
+    return (a.shape == b.shape and a.dtype == b.dtype
+            and bool(torch.equal(a.contiguous().view(torch.uint8), b.contiguous().view(torch.uint8))))
+
+
+def _ak_x12_check(kind, ours, ref, desc):
+    _AK_X12_CHECKED[kind] = True
+    oks = [_ak_x12_bytes_equal(o, r) for o, r in zip(ours, ref)]
+    ok = len(oks) == len(ref) and all(oks)
+    rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+    if rank == 0:
+        print("[auto_kernel x12] first-call check: {} {} byte-exact v tex.fused_qkv_rope_{}: {} ({})".format(
+            kind, desc, "forward" if kind == "fwd" else "backward", ok, oks), flush=True)
+    if not ok:
+        raise RuntimeError("[auto_kernel x12] E0 self-check FAILED ({}): {}".format(kind, oks))
+
