+import os as _ak_os
+import sys as _ak_sys
+_AK_X12_ROPE = _ak_os.environ.get("AK_X12_ROPE", "0") == "1"
+_ak_x12_mod = None
+_ak_x12_rope = None
+_ak_x12_announced = False
