+def _ak_x12_forward(qkv, q_freqs, k_freqs, split):
+    global _ak_x12_announced
+    if not _ak_x12_announced:
+        _ak_x12_announced = True
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+        if rank == 0:
+            import hashlib as _h
+            path = _ak_x12_mod.__file__
+            sha = _h.sha256(open(path, "rb").read()).hexdigest()[:16]
+            print("[auto_kernel x12] fused QKV RoPE ARMED: qkv {} split {} freqs {} module {} sha256={}".format(
+                tuple(qkv.shape), list(split), tuple(q_freqs.shape), path, sha), flush=True)
+    s, b, h, total = qkv.shape
+    d = q_freqs.shape[-1]
+    qs, ks, vs = split
+    if _AK_QKV_PACK:  # auto_kernel QKV-pack (sec 168): the same kernel and stores, q/k/v as views of one buffer
+        q, k, v = _ak_x12_packed_forward(_ak_x12_instance(qkv.device), qkv.contiguous(), q_freqs.contiguous(),
+                                         k_freqs.contiguous(), list(split))
+    else:
+        q, k, v = _ak_x12_instance(qkv.device).forward(qkv.contiguous(), q_freqs.contiguous(), k_freqs.contiguous(), list(split))
+    # TE's output shapes: q [s, b, h * (qs // d), d], k and v [s, b, h * (ks // d), d]
+    out = (q.view(s, b, h * (qs // d), d), k.view(s, b, h * (ks // d), d), v.view(s, b, h * (vs // d), d))
+    if not _AK_X12_CHECKED["fwd"] and not torch.cuda.is_current_stream_capturing():
+        ref = tex.fused_qkv_rope_forward(qkv.contiguous(), q_freqs.contiguous(), k_freqs.contiguous(), None, list(split),
+                                         QKVFormat["sbhd"], False, 1, 0)
+        _ak_x12_check("fwd", out, ref, "qkv {} split {}".format(tuple(qkv.shape), list(split)))
+        del ref
+    return out
+
+
+def _ak_x12_backward(dq, dk, dv, q_freqs, k_freqs, split):
+    s, b = dq.shape[0], dq.shape[1]
+    d = q_freqs.shape[-1]
+    qs, ks, vs = split
+    h = dk.shape[2] * d // ks
+    rope = _ak_x12_instance(dq.device)
+    dqkv = None
+    if _AK_QKV_GRAD_AMAX and _ak_qkvx is not None:     # auto_kernel QKV gradient amaxes (2026-10-07)
+        dqkv = _ak_qkvg_backward(rope, dq.contiguous().view(s, b, h * (qs // d), d),
+                                 dk.contiguous().view(s, b, h * (ks // d), d), dv.contiguous().view(s, b, h * (vs // d), d),
+                                 q_freqs, k_freqs, list(split), s, b, d)
+    if dqkv is None:
+        dqkv = rope.backward(dq.contiguous().view(s, b, h * (qs // d), d), dk.contiguous().view(s, b, h * (ks // d), d),
+                             dv.contiguous().view(s, b, h * (vs // d), d), q_freqs.contiguous(), k_freqs.contiguous(),
+                             list(split))
+    out = dqkv.view(s, b, h, qs + ks + vs)
+    if not _AK_X12_CHECKED["bwd"] and not torch.cuda.is_current_stream_capturing():
+        ref = tex.fused_qkv_rope_backward(dq.contiguous(), dk.contiguous(), dv.contiguous(), q_freqs.contiguous(),
+                                          k_freqs.contiguous(), list(split), QKVFormat["sbhd"], False, 1, 0)
+        _ak_x12_check("bwd", (out,), (ref,), "dq {} split {}".format(tuple(dq.shape), list(split)))
+        del ref
+    return out
+
