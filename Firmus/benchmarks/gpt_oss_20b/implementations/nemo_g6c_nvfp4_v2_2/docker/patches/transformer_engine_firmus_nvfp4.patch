index 0000000000000000000000000000000000000000..6633451a79fd1904f48050cc00bada751219b7cf
--- /dev/null
+++ b/transformer_engine/pytorch/ops/basic/nvfp4_triton_qkv_rope.py
@@ -0,0 +1,184 @@
+# Classification: Internal
+"""Triton replacement for TE's fused QKV RoPE (sbhd, non-interleaved, no CP).
+
+qkv is [s, b, g, (hq + 2) * d] with per-group layout [hq query heads, 1 key, 1 value];
+the outputs are contiguous q [s, b, g * hq, d], k and v [s, b, g, d], matching
+``tex.fused_qkv_rope_forward``/``fused_qkv_rope_backward`` bit for bit. Each
+single-warp program handles one KV group of one token row, so cos/sin are evaluated
+once per row on the half-width frequency vectors. More warps per program are several
+times slower on GB300.
+"""
+from typing import List
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
+
+
+@triton.jit
+def _cos_sin(fq_ptr, fk_ptr, pos, freq_stride, j, isq, HALF: tl.constexpr):
+    fb = pos * freq_stride + j
+    fq1 = tl.load(fq_ptr + fb)
+    fq2 = tl.load(fq_ptr + fb + HALF)
+    fk1 = tl.load(fk_ptr + fb)
+    fk2 = tl.load(fk_ptr + fb + HALF)
+    c1 = tl.where(isq, libdevice.cos(fq1), libdevice.cos(fk1))
+    s1 = tl.where(isq, libdevice.sin(fq1), libdevice.sin(fk1))
+    c2 = tl.where(isq, libdevice.cos(fq2), libdevice.cos(fk2))
+    s2 = tl.where(isq, libdevice.sin(fq2), libdevice.sin(fk2))
+    return c1, s1, c2, s2
+
+
+@triton.jit
+def _qkv_rope_fwd_kernel(
+    qkv_ptr, fq_ptr, fk_ptr, q_ptr, k_ptr, v_ptr, batch, freq_stride,
+    G: tl.constexpr, HQ: tl.constexpr, D: tl.constexpr, BLOCK_R: tl.constexpr,
+):
+    HALF: tl.constexpr = D // 2
+    HG: tl.constexpr = HQ + 2
+    row = tl.program_id(0).to(tl.int64)
+    g = tl.program_id(1)
+    pos = row // batch
+    r = tl.arange(0, BLOCK_R)[:, None]
+    j = tl.arange(0, HALF)[None, :]
+    rmask = r < HG
+    isq = r < HQ
+    isv = r == HQ + 1
+
+    base = qkv_ptr + row * (G * HG * D) + (g * HG + r) * D + j
+    x1 = tl.load(base, mask=rmask, other=0.0).to(tl.float32)
+    x2 = tl.load(base + HALF, mask=rmask, other=0.0).to(tl.float32)
+    c1, s1, c2, s2 = _cos_sin(fq_ptr, fk_ptr, pos, freq_stride, j, isq, HALF)
+    o1 = x1 * c1 + (-x2) * s1
+    o2 = x2 * c2 + x1 * s2
+    o1 = tl.where(isv, x1, o1).to(q_ptr.dtype.element_ty)
+    o2 = tl.where(isv, x2, o2).to(q_ptr.dtype.element_ty)
+
+    qo = q_ptr + row * (G * HQ * D) + (g * HQ + r) * D + j
+    mq = rmask & isq
+    tl.store(qo, o1, mask=mq)
+    tl.store(qo + HALF, o2, mask=mq)
+    kvo = row * (G * D) + g * D + j + r * 0
+    mk = r == HQ
+    tl.store(k_ptr + kvo, o1, mask=mk)
+    tl.store(k_ptr + kvo + HALF, o2, mask=mk)
+    tl.store(v_ptr + kvo, o1, mask=isv)
+    tl.store(v_ptr + kvo + HALF, o2, mask=isv)
+
+
+@triton.jit
+def _qkv_rope_bwd_kernel(
+    gq_ptr, gk_ptr, gv_ptr, fq_ptr, fk_ptr, gqkv_ptr, batch, freq_stride,
+    G: tl.constexpr, HQ: tl.constexpr, D: tl.constexpr, BLOCK_R: tl.constexpr,
+):
+    HALF: tl.constexpr = D // 2
+    HG: tl.constexpr = HQ + 2
+    row = tl.program_id(0).to(tl.int64)
+    g = tl.program_id(1)
+    pos = row // batch
+    r = tl.arange(0, BLOCK_R)[:, None]
+    j = tl.arange(0, HALF)[None, :]
+    rmask = r < HG
+    isq = r < HQ
+    isv = r == HQ + 1
+    mq = rmask & isq
+    mk = r == HQ
+
+    qo = gq_ptr + row * (G * HQ * D) + (g * HQ + r) * D + j
+    kvo = row * (G * D) + g * D + j + r * 0
+    y1 = (
+        tl.load(qo, mask=mq, other=0.0).to(tl.float32)
+        + tl.load(gk_ptr + kvo, mask=mk, other=0.0).to(tl.float32)
+        + tl.load(gv_ptr + kvo, mask=isv, other=0.0).to(tl.float32)
+    )
+    y2 = (
+        tl.load(qo + HALF, mask=mq, other=0.0).to(tl.float32)
+        + tl.load(gk_ptr + kvo + HALF, mask=mk, other=0.0).to(tl.float32)
+        + tl.load(gv_ptr + kvo + HALF, mask=isv, other=0.0).to(tl.float32)
+    )
+    c1, s1, c2, s2 = _cos_sin(fq_ptr, fk_ptr, pos, freq_stride, j, isq, HALF)
+    o1 = y1 * c1 + y2 * s2
+    o2 = y2 * c2 + (-y1) * s1
+    o1 = tl.where(isv, y1, o1).to(gqkv_ptr.dtype.element_ty)
+    o2 = tl.where(isv, y2, o2).to(gqkv_ptr.dtype.element_ty)
+    out = gqkv_ptr + row * (G * HG * D) + (g * HG + r) * D + j
+    tl.store(out, o1, mask=rmask)
+    tl.store(out + HALF, o2, mask=rmask)
+
+
+class TritonQKVRoPE(torch.autograd.Function):
+    """sbhd only: row = s_idx * b + b_idx, so the position is row // b."""
+
+    @staticmethod
+    def forward(ctx, qkv, q_freqs, k_freqs, split):
+        s, b, g, _ = qkv.shape
+        d = split[1]
+        hq = split[0] // d
+        q = qkv.new_empty(s, b, g * hq, d)
+        k = qkv.new_empty(s, b, g, d)
+        v = qkv.new_empty(s, b, g, d)
+        fq = q_freqs.float().contiguous()
+        fk = k_freqs.float().contiguous()
+        block_r = triton.next_power_of_2(hq + 2)
+        _qkv_rope_fwd_kernel[(s * b, g)](
+            qkv, fq, fk, q, k, v, b, fq.stride(0),
+            G=g, HQ=hq, D=d, BLOCK_R=block_r, num_warps=1,
+        )
+        ctx.save_for_backward(fq, fk)
+        ctx.meta = (g, hq, d, b, block_r, qkv.shape, qkv.dtype)
+        return q, k, v
+
+    @staticmethod
+    def backward(ctx, gq, gk, gv):
+        fq, fk = ctx.saved_tensors
+        g, hq, d, b, block_r, shape, dtype = ctx.meta
+        gq = gq.contiguous()
+        gk = gk.contiguous()
+        gv = gv.contiguous()
+        gqkv = torch.empty(shape, dtype=dtype, device=gq.device)
+        _qkv_rope_bwd_kernel[(shape[0] * shape[1], g)](
+            gq, gk, gv, fq, fk, gqkv, b, fq.stride(0),
+            G=g, HQ=hq, D=d, BLOCK_R=block_r, num_warps=1,
+        )
+        return gqkv, None, None, None
+
+
+def make_apply_fused_qkv_rotary_pos_emb(te_apply):
+    """Wrap TE's ``apply_fused_qkv_rotary_pos_emb``, routing the supported case to Triton."""
+
+    def apply_fused_qkv_rotary_pos_emb(
+        qkv: torch.Tensor,
+        q_freqs: torch.Tensor,
+        k_freqs: torch.Tensor,
+        qkv_split_arg_list: List[int],
+        tensor_format: str = "sbhd",
+        start_positions=None,
+        interleaved: bool = False,
+        cu_seqlens=None,
+        cp_size: int = 1,
+        cp_rank: int = 0,
+    ):
+        d = qkv_split_arg_list[1]
+        if (
+            tensor_format == "sbhd"
+            and start_positions is None
+            and not interleaved
+            and cp_size == 1
+            and qkv.dim() == 4
+            and qkv.is_contiguous()
+            and qkv_split_arg_list[2] == d
+            and qkv_split_arg_list[0] % d == 0
+            and q_freqs.shape[-1] == d
+            and k_freqs.shape[-1] == d
+            and q_freqs.shape[0] >= qkv.shape[0]
+            and d in (32, 64, 128)
+        ):
+            return TritonQKVRoPE.apply(qkv, q_freqs, k_freqs, list(qkv_split_arg_list))
+        return te_apply(
+            qkv, q_freqs, k_freqs, qkv_split_arg_list, tensor_format=tensor_format,
+            start_positions=start_positions, interleaved=interleaved, cu_seqlens=cu_seqlens,
+            cp_size=cp_size, cp_rank=cp_rank,
+        )
+
+    return apply_fused_qkv_rotary_pos_emb
diff --git a/transformer_engine/pytorch/ops/basic/nvfp4_triton_rmsnorm_bwd.py b/transformer_engine/pytorch/ops/basic/nvfp4_triton_rmsnorm_bwd.py
