+"""Run the BF16 tail layers (first_last_layers_bf16) under MXFP8 instead of BF16.
+
+The NVFP4 recipe keeps the last ``num_layers_at_end_in_bf16`` transformer layers in
+BF16. Their TE modules (attention linears and the expert MLP) are wrapped in an
+MXFP8 autocast at the instance level, so the TE CUDA-graph capture (which runs
+these callables with FP8/FP4 disabled) records MXFP8 kernels. Attention itself and
+the router stay BF16. Parameters, optimizer and DDP buffers are unchanged.
+Env: NVFP4_TAIL_MXFP8_FORMAT (e4m3|hybrid), NVFP4_TAIL_MXFP8_ATTN (1), NVFP4_TAIL_MXFP8_MLP (1).
+"""
+
+import os
+
+import transformer_engine.pytorch as te
+from transformer_engine.common import recipe as te_recipe
+
+_FORMATS = {"e4m3": te_recipe.Format.E4M3, "hybrid": te_recipe.Format.HYBRID}
+
+
+def _recipe():
+    return te_recipe.MXFP8BlockScaling(fp8_format=_FORMATS[os.environ.get("NVFP4_TAIL_MXFP8_FORMAT", "e4m3")])
+
+
+def _wrap(module, recipe):
+    orig = module.forward
+
+    def forward(*args, **kwargs):
+        with te.fp8_autocast(enabled=True, fp8_recipe=recipe):
+            return orig(*args, **kwargs)
+
+    module.forward = forward
+
+
+def tail_layer_indices(config):
+    if not getattr(config, "first_last_layers_bf16", False):
+        return set()
+    start = getattr(config, "num_layers_at_start_in_bf16", 0) or 0
+    end = getattr(config, "num_layers_at_end_in_bf16", 0) or 0
+    return set(range(start)) | set(range(config.num_layers - end, config.num_layers))
+
+
+def patch_layer(layer, recipe, attn=True, mlp=True):
+    """Wrap one TransformerLayer's TE linears and experts; returns the wrapped names."""
+    from transformer_engine.pytorch.module.base import TransformerEngineBaseModule
+
+    DotProductAttention = te.DotProductAttention
+    wrapped = []
+    experts = getattr(getattr(layer, "mlp", None), "experts", None)
+    if mlp and experts is not None:
+        _wrap(experts, recipe)
+        wrapped.append("mlp.experts")
+    if attn:
+        for name, mod in layer.named_modules():
+            if name.startswith("mlp") or isinstance(mod, DotProductAttention):
+                continue
+            if isinstance(mod, TransformerEngineBaseModule):
+                _wrap(mod, recipe)
+                wrapped.append(name)
+    return wrapped
+
+
+def install():
+    """Patch GPTModel.__init__ so the BF16 tail layers of every stage run MXFP8."""
+    from megatron.core.models.gpt.gpt_model import GPTModel
+
+    orig_init = GPTModel.__init__
+    attn = os.environ.get("NVFP4_TAIL_MXFP8_ATTN", "1") == "1"
+    mlp = os.environ.get("NVFP4_TAIL_MXFP8_MLP", "1") == "1"
+
+    def init(self, *args, **kwargs):
+        orig_init(self, *args, **kwargs)
+        tail = tail_layer_indices(self.config)
+        recipe = _recipe()
+        done = {}
+        for layer in getattr(self.decoder, "layers", []):
+            if layer.layer_number - 1 in tail:
+                done[layer.layer_number - 1] = patch_layer(layer, recipe, attn=attn, mlp=mlp)
+        if int(os.environ.get("RANK", "0")) == 0:
+            print(f"NVFP4 tail MXFP8 ({os.environ.get('NVFP4_TAIL_MXFP8_FORMAT', 'e4m3')}) layers {done}", flush=True)
+
+    GPTModel.__init__ = init
