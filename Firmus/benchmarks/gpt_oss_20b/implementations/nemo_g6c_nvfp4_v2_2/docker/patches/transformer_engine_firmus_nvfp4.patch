index 0000000000000000000000000000000000000000..8820ffaaa112163e47760d52b8be4846ed9771f9
--- /dev/null
+++ b/transformer_engine/pytorch/ops/basic/nvfp4_triton_rmsnorm_bwd.py
@@ -0,0 +1,140 @@
+# Classification: Internal
+"""Triton RMSNorm backward, a drop-in for ``transformer_engine_torch.rmsnorm_bwd``.
+
+TE's backward for hidden 2880 (not a tuned size) runs a main and a finalize
+kernel of about 240 us each on 24576 x 2880 BF16. This persistent kernel
+reads x and dz once, writes dx, and reduces dgamma through a small
+per-program partial buffer.
+
+v2 keeps the row-to-program assignment, the per-row arithmetic and the dgamma
+accumulation order of v1, so results are bit-identical. It only raises the
+number of rows in flight per program: ``NVFP4_RMSNORM_BWD_UNROLL`` (1, 2 or 4)
+issues the loads of that many rows before computing them, and
+``NVFP4_RMSNORM_BWD_STAGES`` software-pipelines the row loop.
+"""
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+_UNROLL = int(os.environ.get("NVFP4_RMSNORM_BWD_UNROLL", "1"))
+_STAGES = int(os.environ.get("NVFP4_RMSNORM_BWD_STAGES", "1"))
+
+
+@triton.jit
+def _load_row(x_ptr, dz_ptr, rsigma_ptr, row, rows, stride_row, offs, mask):
+    valid = row < rows
+    r = tl.minimum(row, rows - 1)
+    base = r.to(tl.int64) * stride_row
+    x = tl.load(x_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    dz = tl.load(dz_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+    rs = tl.load(rsigma_ptr + r)
+    return x, dz, rs, base, valid
+
+
+@triton.jit
+def _finish_row(x, dz, rs, base, valid, gamma, cols, dx_ptr, offs, mask):
+    xhat = x * rs
+    gdz = dz * gamma
+    mdot = tl.sum(gdz * xhat, axis=0) / cols
+    dx = rs * (gdz - xhat * mdot)
+    tl.store(dx_ptr + base + offs, dx.to(dx_ptr.dtype.element_ty), mask=mask & valid)
+    return dz * xhat
+
+
+@triton.jit
+def _rmsnorm_bwd_kernel(
+    dz_ptr, x_ptr, rsigma_ptr, gamma_ptr, dx_ptr, dgamma_part_ptr,
+    rows, cols, stride_row,
+    ZERO_CENTERED: tl.constexpr, BLOCK_N: tl.constexpr,
+    UNROLL: tl.constexpr, STAGES: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    num_programs = tl.num_programs(0)
+    offs = tl.arange(0, BLOCK_N)
+    mask = offs < cols
+    gamma = tl.load(gamma_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    if ZERO_CENTERED:
+        gamma = gamma + 1.0
+    dgamma_acc = tl.zeros([BLOCK_N], dtype=tl.float32)
+    for row0 in tl.range(pid, rows, num_programs * UNROLL, num_stages=STAGES):
+        if UNROLL == 1:
+            x0, dz0, rs0, b0, v0 = _load_row(x_ptr, dz_ptr, rsigma_ptr, row0, rows, stride_row, offs, mask)
+            dgamma_acc += _finish_row(x0, dz0, rs0, b0, v0, gamma, cols, dx_ptr, offs, mask)
+        elif UNROLL == 2:
+            x0, dz0, rs0, b0, v0 = _load_row(x_ptr, dz_ptr, rsigma_ptr, row0, rows, stride_row, offs, mask)
+            x1, dz1, rs1, b1, v1 = _load_row(
+                x_ptr, dz_ptr, rsigma_ptr, row0 + num_programs, rows, stride_row, offs, mask)
+            dgamma_acc += _finish_row(x0, dz0, rs0, b0, v0, gamma, cols, dx_ptr, offs, mask)
+            c1 = _finish_row(x1, dz1, rs1, b1, v1, gamma, cols, dx_ptr, offs, mask)
+            dgamma_acc += tl.where(v1, c1, 0.0)
+        else:
+            x0, dz0, rs0, b0, v0 = _load_row(x_ptr, dz_ptr, rsigma_ptr, row0, rows, stride_row, offs, mask)
+            x1, dz1, rs1, b1, v1 = _load_row(
+                x_ptr, dz_ptr, rsigma_ptr, row0 + num_programs, rows, stride_row, offs, mask)
+            x2, dz2, rs2, b2, v2 = _load_row(
+                x_ptr, dz_ptr, rsigma_ptr, row0 + 2 * num_programs, rows, stride_row, offs, mask)
+            x3, dz3, rs3, b3, v3 = _load_row(
+                x_ptr, dz_ptr, rsigma_ptr, row0 + 3 * num_programs, rows, stride_row, offs, mask)
+            dgamma_acc += _finish_row(x0, dz0, rs0, b0, v0, gamma, cols, dx_ptr, offs, mask)
+            c1 = _finish_row(x1, dz1, rs1, b1, v1, gamma, cols, dx_ptr, offs, mask)
+            dgamma_acc += tl.where(v1, c1, 0.0)
+            c2 = _finish_row(x2, dz2, rs2, b2, v2, gamma, cols, dx_ptr, offs, mask)
+            dgamma_acc += tl.where(v2, c2, 0.0)
+            c3 = _finish_row(x3, dz3, rs3, b3, v3, gamma, cols, dx_ptr, offs, mask)
+            dgamma_acc += tl.where(v3, c3, 0.0)
+    tl.store(dgamma_part_ptr + pid.to(tl.int64) * BLOCK_N + offs, dgamma_acc, mask=mask)
+
+
+@triton.jit
+def _reduce_rows_kernel(part_ptr, out_ptr, parts, cols, BLOCK_P: tl.constexpr, BLOCK_C: tl.constexpr, STRIDE: tl.constexpr):
+    pid = tl.program_id(0)
+    cols_offs = pid * BLOCK_C + tl.arange(0, BLOCK_C)
+    cmask = cols_offs < cols
+    acc = tl.zeros([BLOCK_C], dtype=tl.float32)
+    for p0 in range(0, parts, BLOCK_P):
+        p = p0 + tl.arange(0, BLOCK_P)
+        pmask = p < parts
+        tile = tl.load(
+            part_ptr + p[:, None].to(tl.int64) * STRIDE + cols_offs[None, :],
+            mask=pmask[:, None] & cmask[None, :],
+            other=0.0,
+        )
+        acc += tl.sum(tile, axis=0)
+    tl.store(out_ptr + cols_offs, acc.to(out_ptr.dtype.element_ty), mask=cmask)
+
+
+_NUM_SMS = {}
+
+
+def rmsnorm_bwd(dz, x, rsigma, gamma, sm_margin=0, zero_centered_gamma=False):
+    """Return ``(dx, dgamma)`` with the semantics of TE ``rmsnorm_bwd``."""
+    cols = gamma.numel()
+    x2 = x.reshape(-1, cols)
+    dz2 = dz.reshape(-1, cols)
+    if not x2.is_contiguous():
+        x2 = x2.contiguous()
+    if not dz2.is_contiguous():
+        dz2 = dz2.contiguous()
+    rows = x2.shape[0]
+    device = x2.device
+    if device not in _NUM_SMS:
+        _NUM_SMS[device] = torch.cuda.get_device_properties(device).multi_processor_count
+    block_n = triton.next_power_of_2(cols)
+    programs = max(1, min(rows, 2 * (_NUM_SMS[device] - int(sm_margin))))
+    dx = torch.empty_like(x2)
+    part = torch.empty((programs, block_n), dtype=torch.float32, device=device)
+    _rmsnorm_bwd_kernel[(programs,)](
+        dz2, x2, rsigma.reshape(-1), gamma.reshape(-1), dx, part,
+        rows, cols, x2.stride(0),
+        ZERO_CENTERED=bool(zero_centered_gamma), BLOCK_N=block_n,
+        UNROLL=_UNROLL, STAGES=_STAGES, num_warps=8,
+    )
+    dgamma = torch.empty_like(gamma)
+    block_c = 128
+    _reduce_rows_kernel[(triton.cdiv(cols, block_c),)](
+        part, dgamma.reshape(-1), programs, cols, BLOCK_P=32, BLOCK_C=block_c, STRIDE=block_n,
+        num_warps=4,
+    )
+    return dx.view(x.shape), dgamma
