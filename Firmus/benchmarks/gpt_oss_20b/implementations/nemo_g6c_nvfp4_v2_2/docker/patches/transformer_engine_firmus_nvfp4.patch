+++ b/transformer_engine/pytorch/ops/basic/nvfp4_triton_bias_residual.py
@@ -0,0 +1,59 @@
+# Classification: Internal
+"""One-pass ``residual + (x + bias)`` for Megatron's bias-dropout-add with dropout 0.
+
+Rounds ``x + bias`` to the input dtype before adding the residual, matching the
+two unfused PyTorch adds bit for bit.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _bias_residual_add_kernel(x_ptr, b_ptr, r_ptr, out_ptr, numel, hidden, BLOCK: tl.constexpr):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < numel
+    x = tl.load(x_ptr + offs, mask=mask, other=0.0)
+    r = tl.load(r_ptr + offs, mask=mask, other=0.0)
+    b = tl.load(b_ptr + offs % hidden, mask=mask, other=0.0)
+    t = (x.to(tl.float32) + b.to(tl.float32)).to(x.dtype)
+    out = (r.to(tl.float32) + t.to(tl.float32)).to(x.dtype)
+    tl.store(out_ptr + offs, out, mask=mask)
+
+
+class _BiasResidualAdd(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, bias, residual):
+        out = torch.empty_like(x)
+        numel = x.numel()
+        block = 4096
+        _bias_residual_add_kernel[(triton.cdiv(numel, block),)](
+            x, bias, residual, out, numel, x.shape[-1], BLOCK=block, num_warps=8
+        )
+        ctx.bias_shape = bias.shape
+        return out
+
+    @staticmethod
+    def backward(ctx, grad):
+        return grad, grad.sum_to_size(ctx.bias_shape), grad
+
+
+def eligible(x, bias, residual, prob, training):
+    return (
+        training
+        and prob == 0.0
+        and bias is not None
+        and x.dtype == residual.dtype == bias.dtype
+        and x.dtype in (torch.bfloat16, torch.float16)
+        and x.shape == residual.shape
+        and bias.dim() == 1
+        and bias.shape[0] == x.shape[-1]
+        and x.is_contiguous()
+        and residual.is_contiguous()
+        and bias.is_contiguous()
+    )
+
+
+def bias_residual_add(x, bias, residual):
+    return _BiasResidualAdd.apply(x, bias, residual)
