+# Classification: Internal
+"""Grouped NVFP4 2D (16x16) weight quantization for equally shaped expert weights.
+
+Replaces one zero-amax, amax and quantize launch per expert with two launches per group.
+Numerics follow TE ``quantize_transpose_nvfp4_2D_kernel`` (round-to-nearest, 448 E4M3 bound).
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from transformer_engine.pytorch.tensor.nvfp4_tensor import NVFP4Quantizer, NVFP4Tensor
+from transformer_engine.pytorch.tensor.storage.nvfp4_tensor_storage import NVFP4TensorStorage
+
+_AMAX_PROGRAMS = 64
+_AMAX_BLOCK = 8192
+_FLT_MAX = tl.constexpr(3.4028234663852886e38)
+_PTR_TABLES = {}
+
+
+@triton.jit
+def _expert_base(ptr_table, expert):
+    return tl.load(ptr_table + expert).to(tl.pointer_type(tl.bfloat16))
+
+
+@triton.jit
+def _group_amax_kernel(ptr_table, partial_ptr, numel, iters, BLOCK: tl.constexpr):
+    pid = tl.program_id(0)
+    expert = tl.program_id(1)
+    base = _expert_base(ptr_table, expert)
+    offs = tl.arange(0, BLOCK)
+    acc = tl.zeros([BLOCK], dtype=tl.float32)
+    start = pid * iters * BLOCK
+    for i in range(iters):
+        idx = start + i * BLOCK + offs
+        x = tl.load(base + idx, mask=idx < numel, other=0.0)
+        acc = tl.maximum(acc, tl.abs(x.to(tl.float32)))
+    tl.store(partial_ptr + expert * tl.num_programs(0) + pid, tl.max(acc, axis=0))
+
+
+@triton.jit
+def _swizzled_scale_offset(r, c, col_length):
+    cbg_cnt = (col_length + 3) // 4
+    rb = r // 128
+    rem = r % 128
+    return ((rb * cbg_cnt + c // 4) * 32 + rem % 32) * 16 + (rem // 32) * 4 + c % 4
+
+
+@triton.jit
+def _cvt_e2m1x2(lo, hi):
+    # Same instruction as TE: the first source lands in the upper nibble.
+    return tl.inline_asm_elementwise(
+        """
+        {
+        .reg .b8 b0, b1, b2, b3;
+        cvt.rn.satfinite.e2m1x2.f32 b0, $5, $1;
+        cvt.rn.satfinite.e2m1x2.f32 b1, $6, $2;
+        cvt.rn.satfinite.e2m1x2.f32 b2, $7, $3;
+        cvt.rn.satfinite.e2m1x2.f32 b3, $8, $4;
+        mov.b32 $0, {b0, b1, b2, b3};
+        }
+        """,
+        "=r,r,r,r,r,r,r,r,r",
+        [lo, hi],
+        dtype=tl.uint8,
+        is_pure=True,
+        pack=4,
+    )
+
+
+@triton.jit
+def _group_quant_2d_kernel(
+    ptr_table,
+    partial_ptr,
+    amax_ptr,
+    row_data_ptr,
+    col_data_ptr,
+    row_scale_ptr,
+    col_scale_ptr,
+    M,
+    K,
+    row_scale_stride,
+    col_scale_stride,
+    row_scale_expert_stride,
+    col_scale_expert_stride,
+    NUM_PARTIALS: tl.constexpr,
+    MB: tl.constexpr,
+    KB: tl.constexpr,
+    COLUMNWISE: tl.constexpr,
+    SWIZZLED: tl.constexpr,
+):
+    # One program covers MB x KB 16x16 blocks, held as a [MB, 16, KB, 16] tensor so the
+    # block reductions and scale broadcasts need no layout conversion.
+    pid_k = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    expert = tl.program_id(2)
+    e64 = expert.to(tl.int64)
+
+    amax = tl.max(tl.load(partial_ptr + expert * NUM_PARTIALS + tl.arange(0, NUM_PARTIALS)), axis=0)
+    s_enc = tl.minimum(tl.math.div_rn(2688.0, amax), _FLT_MAX)
+    s_enc = tl.where((amax == 0.0) | (s_enc == 0.0), 1.0, s_enc)
+    s_dec = tl.math.div_rn(1.0, s_enc)
+    if (pid_k == 0) & (pid_m == 0):
+        tl.store(amax_ptr + expert * 2, amax)
+        tl.store(amax_ptr + expert * 2 + 1, amax)
+
+    mb = tl.arange(0, MB)
+    kb = tl.arange(0, KB)
+    i16 = tl.arange(0, 16)
+    i8 = tl.arange(0, 8)
+    row0 = pid_m * (MB * 16)
+    col0 = pid_k * (KB * 16)
+    x_base = _expert_base(ptr_table, expert) + row0 * K + col0
+    x_off = (mb[:, None, None, None] * 16 + i16[None, :, None, None]) * K + (
+        kb[None, None, :, None] * 16 + i16[None, None, None, :]
+    )
+    x = tl.load(x_base + x_off).to(tl.float32)
+
+    blk = tl.max(tl.max(tl.abs(x), axis=3), axis=1)
+    sf = tl.minimum(blk * (s_enc * 0.16666666666666666), _FLT_MAX).to(tl.float8e4nv)
+    inv = tl.minimum(tl.math.div_rn(1.0, sf.to(tl.float32) * s_dec), _FLT_MAX)
+    y = x * inv[:, None, :, None]
+    sf_bits = sf.to(tl.uint8, bitcast=True)
+    half = e64 * (M * K // 2)
+
+    lo, hi = tl.split(tl.reshape(y, [MB, 16, KB, 8, 2]))
+    packed = _cvt_e2m1x2(lo, hi)
+    r_base = row_data_ptr + half + row0 * (K // 2) + col0 // 2
+    r_off = (mb[:, None, None, None] * 16 + i16[None, :, None, None]) * (K // 2) + (
+        kb[None, None, :, None] * 8 + i8[None, None, None, :]
+    )
+    tl.store(r_base + r_off, packed)
+    # Rowwise scale matrix is [M, K/16]: one entry per row per 16-column block.
+    srow = row0 + mb[:, None, None] * 16 + i16[None, :, None]
+    scol = pid_k * KB + kb[None, None, :]
+    rs = tl.broadcast_to(sf_bits[:, None, :], [MB, 16, KB])
+    if SWIZZLED:
+        off = _swizzled_scale_offset(srow, scol, K // 16)
+    else:
+        off = srow * row_scale_stride + scol
+    tl.store(row_scale_ptr + e64 * row_scale_expert_stride + off, rs)
+
+    if COLUMNWISE:
+        lo, hi = tl.split(tl.permute(tl.reshape(y, [MB, 8, 2, KB, 16]), (0, 1, 3, 4, 2)))
+        packed = _cvt_e2m1x2(lo, hi)
+        c_base = col_data_ptr + half + col0 * (M // 2) + row0 // 2
+        c_off = (kb[None, None, :, None] * 16 + i16[None, None, None, :]) * (M // 2) + (
+            mb[:, None, None, None] * 8 + i8[None, :, None, None]
+        )
+        tl.store(c_base + c_off, packed)
+        # Columnwise scale matrix is [K, M/16]: one entry per column per 16-row block.
+        crow = col0 + kb[None, :, None] * 16 + i16[None, None, :]
+        ccol = pid_m * MB + mb[:, None, None]
+        cs = tl.broadcast_to(sf_bits[:, :, None], [MB, KB, 16])
+        if SWIZZLED:
+            off = _swizzled_scale_offset(crow, ccol, M // 16)
+        else:
+            off = crow * col_scale_stride + ccol
+        tl.store(col_scale_ptr + e64 * col_scale_expert_stride + off, cs)
+
+
+def unsupported_reason(weights, quantizers):
+    """Return why the grouped path cannot run, or None."""
+    if len(weights) < 2 or len(quantizers) != len(weights):
+        return "group size"
+    w0, q0 = weights[0], quantizers[0]
+    if w0.dtype != torch.bfloat16 or w0.dim() != 2 or not w0.is_cuda:
+        return f"weight {w0.dtype} dim={w0.dim()}"
+    M, K = w0.shape
+    if M % 128 or K % 128 or (M // 16) % 4 or (K // 16) % 4 or M * K >= 2**31:
+        return f"shape {tuple(w0.shape)}"
+    for w in weights:
+        if w.shape != w0.shape or w.dtype != w0.dtype or not w.is_contiguous():
+            return "weights differ or are not contiguous"
+    for q in quantizers:
+        if not isinstance(q, NVFP4Quantizer):
+            return f"quantizer {type(q).__name__}"
+        flags = dict(
+            with_2d_quantization=q.with_2d_quantization,
+            with_rht=q.with_rht,
+            stochastic_rounding=q.stochastic_rounding,
+            row_scaled_nvfp4=q.row_scaled_nvfp4,
+            nvfp4_use_4over6=q.nvfp4_use_4over6,
+            with_amax_reduction=q.with_amax_reduction,
+            rowwise_usage=q.rowwise_usage,
+        )
+        wanted = dict(
+            with_2d_quantization=True,
+            with_rht=False,
+            stochastic_rounding=False,
+            row_scaled_nvfp4=False,
+            nvfp4_use_4over6=False,
+            with_amax_reduction=False,
+            rowwise_usage=True,
+        )
+        if flags != wanted:
+            return f"quantizer flags {flags}"
+        if (
+            q.columnwise_usage != q0.columnwise_usage
+            or q.optimize_for_gemm != q0.optimize_for_gemm
+            or q.internal != q0.internal
+            or q.dtype != q0.dtype
+        ):
+            return "quantizers differ"
+    if torch.cuda.is_current_stream_capturing() and _ptr_key(weights) not in _PTR_TABLES:
+        return "pointer table not built before capture"
+    return None
+
+
+def _ptr_key(weights):
+    return tuple(w.data_ptr() for w in weights)
+
+
+def _ptr_table(weights):
+    key = _ptr_key(weights)
+    table = _PTR_TABLES.get(key)
+    if table is None:
+        table = torch.tensor(key, dtype=torch.int64, device=weights[0].device)
+        _PTR_TABLES[key] = table
+    return table
+
+
+def group_quantize_weights(weights, quantizers, bm=64, bk=128, num_warps=4):
+    """Quantize equally shaped BF16 expert weights; returns None when not applicable."""
+    if unsupported_reason(weights, quantizers) is not None:
+        return None
+    table = _ptr_table(weights)
+
+    q0 = quantizers[0]
+    E = len(weights)
+    M, K = weights[0].shape
+    device = weights[0].device
+    columnwise = q0.columnwise_usage
+    swizzled = bool(q0.optimize_for_gemm)
+    numel = M * K
+
+    rs_shape = q0.get_scale_shape((M, K), False)
+    cs_shape = q0.get_scale_shape((M, K), True)
+    row_data = torch.empty((E, M, K // 2), dtype=torch.uint8, device=device)
+    row_scale = torch.empty((E, *rs_shape), dtype=torch.uint8, device=device)
+    col_data = col_scale = None
+    if columnwise:
+        col_data = torch.empty((E, K, M // 2), dtype=torch.uint8, device=device)
+        col_scale = torch.empty((E, *cs_shape), dtype=torch.uint8, device=device)
+    amax = torch.empty((E, 2), dtype=torch.float32, device=device)
+    partial = torch.empty((E, _AMAX_PROGRAMS), dtype=torch.float32, device=device)
+
+    iters = triton.cdiv(numel, _AMAX_PROGRAMS * _AMAX_BLOCK)
+    _group_amax_kernel[(_AMAX_PROGRAMS, E)](
+        table, partial, numel, iters, BLOCK=_AMAX_BLOCK, num_warps=8
+    )
+    _group_quant_2d_kernel[(K // bk, M // bm, E)](
+        table,
+        partial,
+        amax,
+        row_data,
+        col_data if columnwise else row_data,
+        row_scale,
+        col_scale if columnwise else row_scale,
+        M,
+        K,
+        rs_shape[1],
+        cs_shape[1],
+        rs_shape[0] * rs_shape[1],
+        cs_shape[0] * cs_shape[1],
+        NUM_PARTIALS=_AMAX_PROGRAMS,
+        MB=bm // 16,
+        KB=bk // 16,
+        COLUMNWISE=columnwise,
+        SWIZZLED=swizzled,
+        num_warps=num_warps,
+    )
+
+    out = []
+    for e, q in enumerate(quantizers):
+        kwargs = dict(
+            rowwise_data=row_data[e],
+            rowwise_scale_inv=row_scale[e],
+            columnwise_data=col_data[e] if columnwise else None,
+            columnwise_scale_inv=col_scale[e] if columnwise else None,
+            amax_rowwise=amax[e, 0:1],
+            amax_columnwise=amax[e, 1:2] if columnwise else None,
+            fp4_dtype=q.dtype,
+            quantizer=q,
+            with_gemm_swizzled_scales=swizzled,
+        )
+        if q.internal:
+            out.append(NVFP4TensorStorage(**kwargs, fake_dtype=weights[e].dtype))
+        else:
+            out.append(
+                NVFP4Tensor(shape=(M, K), dtype=weights[e].dtype, requires_grad=False, **kwargs)
+            )
+    return out
