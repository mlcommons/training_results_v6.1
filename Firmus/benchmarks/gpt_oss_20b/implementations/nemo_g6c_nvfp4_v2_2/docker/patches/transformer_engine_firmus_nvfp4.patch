+++ b/transformer_engine/pytorch/ops/fused/nvfp4_shard_weight_amax.py
@@ -0,0 +1,338 @@
+"""Per-expert-weight NVFP4 amax computed from the distributed-optimizer shards.
+
+Quantizing an expert weight normally runs zero_amax + amax over the full gathered
+weight before the cast. Here each rank reduces |w| over only its own param-buffer
+shard (the bytes the optimizer just wrote), one MAX all-reduce combines the shards,
+and the cast reads the result via ``tex.nvfp4_quantize_with_amax``. max is exact, so
+the quantized weights are bit-identical to ``quantizer(weight)``.
+
+Protocol:
+  * ``register(param)`` on the first quantization of each expert weight (eager, before
+    graph capture) allocates a persistent fp32 slot and seeds it from the full weight.
+  * ``mark_dirty()`` after every optimizer step.
+  * ``refresh(bucket_groups)`` before the first param all-gather after a step
+    recomputes every slot from the local shards.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+_CAPACITY = 8192
+_CHUNK_BLOCK = 4096
+_CHUNK_ITERS = 8
+_CHUNK = _CHUNK_BLOCK * _CHUNK_ITERS
+
+_amax_buf = None
+_slots = {}
+# Slot views handed to quantization are built with set_() so they get their own autograd
+# version counter; every in-place write goes through _amax_buf, whose counter is separate,
+# so saved quantized weights are not flagged as modified by the per-step refresh.
+_views = {}
+_dirty = False
+_disabled_reason = None
+_plan = None
+_plan_nslots = -1
+counters = {"dirty": 0, "refresh": 0}
+
+
+@triton.jit
+def _segment_amax_kernel(
+    base_ptr,
+    chunk_start_ptr,
+    chunk_len_ptr,
+    chunk_slot_ptr,
+    out_ptr,
+    BLOCK: tl.constexpr,
+    ITERS: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    start = tl.load(chunk_start_ptr + pid)
+    n = tl.load(chunk_len_ptr + pid)
+    slot = tl.load(chunk_slot_ptr + pid)
+    acc = tl.zeros([BLOCK], dtype=tl.float32)
+    for i in tl.static_range(ITERS):
+        offs = i * BLOCK + tl.arange(0, BLOCK)
+        x = tl.load(base_ptr + start + offs, mask=offs < n, other=0.0).to(tl.float32)
+        acc = tl.maximum(acc, tl.abs(x))
+    tl.atomic_max(out_ptr + slot, tl.max(acc, axis=0))
+
+
+def disabled_reason():
+    return _disabled_reason
+
+
+def disable(reason):
+    global _disabled_reason
+    if _disabled_reason is None:
+        _disabled_reason = reason
+        print(f"NVFP4_SHARD_WEIGHT_AMAX disabled: {reason}", flush=True)
+
+
+def slot_for(param):
+    """Return the 1-element amax view for ``param`` or None if unavailable."""
+    if _disabled_reason is not None:
+        return None
+    return _views.get(param)
+
+
+def register(param):
+    """Allocate a slot for ``param`` and seed it from the full weight (eager only)."""
+    global _amax_buf
+    if _disabled_reason is not None:
+        return None
+    if param in _slots:
+        return slot_for(param)
+    if torch.cuda.is_current_stream_capturing():
+        return None
+    if param.dtype != torch.bfloat16 or not param.is_contiguous():
+        disable(f"unsupported weight {param.dtype} contiguous={param.is_contiguous()}")
+        return None
+    if _amax_buf is None:
+        _amax_buf = torch.zeros(_CAPACITY, dtype=torch.float32, device=param.device)
+    slot = len(_slots)
+    if slot >= _CAPACITY:
+        disable("slot capacity exceeded")
+        return None
+    _slots[param] = slot
+    _amax_buf[slot : slot + 1].copy_(param.detach().abs().amax().float().view(1))
+    view = torch.empty(0, dtype=torch.float32, device=_amax_buf.device)
+    view.set_(_amax_buf.untyped_storage(), slot, (1,), (1,))
+    _views[param] = view
+    return view
+
+
+def mark_dirty():
+    global _dirty
+    _dirty = True
+    counters["dirty"] += 1
+
+
+def _build_plan(bucket_groups, only=None):
+    """Map each registered param's local-shard segment into chunk tables per DP group.
+
+    ``only`` restricts the plan to a subset of the registered params."""
+    owner = {}
+    for group in bucket_groups:
+        for bucket in group.buckets:
+            if bucket.param_data is None:
+                continue
+            for p in bucket.params:
+                if p in _slots:
+                    owner[p] = (group, bucket)
+    missing = [p for p in _slots if p not in owner]
+    if missing:
+        disable(f"{len(missing)} registered weights not in any DDP bucket")
+        return None
+
+    selected = {p: s for p, s in _slots.items() if only is None or p in only}
+    per_pg = {}
+    for p, slot in selected.items():
+        group, bucket = owner[p]
+        buf = bucket.param_data
+        if buf.dtype != torch.bfloat16:
+            disable(f"param buffer dtype {buf.dtype}")
+            return None
+        esize = buf.element_size()
+        off_bytes = p.data_ptr() - buf.data_ptr()
+        if off_bytes < 0 or off_bytes % esize or off_bytes // esize + p.numel() > buf.numel():
+            disable("weight storage is not a view into its bucket param buffer")
+            return None
+        off = off_bytes // esize
+        size = group.intra_distributed_optimizer_instance_size
+        rank = group.intra_distributed_optimizer_instance_rank
+        shard = buf.numel() // size
+        lo = max(off, rank * shard)
+        hi = min(off + p.numel(), (rank + 1) * shard)
+        pg = group.intra_distributed_optimizer_instance_group
+        entry = per_pg.setdefault(id(pg), {"pg": pg, "segs": []})
+        if hi > lo:
+            entry["segs"].append((buf, lo, hi - lo, slot))
+
+    plans = []
+    for entry in per_pg.values():
+        segs = entry["segs"]
+        slots = sorted({s for _, _, _, s in segs} | {
+            selected[p] for p in selected
+            if id(owner[p][0].intra_distributed_optimizer_instance_group) == id(entry["pg"])
+        })
+        base = min((b.data_ptr() for b, _, _, _ in segs), default=None)
+        starts, lens, chunk_slots = [], [], []
+        base_tensor = None
+        for buf, lo, n, slot in segs:
+            if buf.data_ptr() == base:
+                base_tensor = buf
+            rel = (buf.data_ptr() - base) // 2 + lo
+            for c in range(0, n, _CHUNK):
+                starts.append(rel + c)
+                lens.append(min(_CHUNK, n - c))
+                chunk_slots.append(slot)
+        dev = _amax_buf.device
+        slot_idx = torch.tensor(slots, dtype=torch.int64, device=dev)
+        plans.append(
+            {
+                "pg": entry["pg"],
+                "base": base_tensor,
+                "starts": torch.tensor(starts, dtype=torch.int64, device=dev),
+                "lens": torch.tensor(lens, dtype=torch.int64, device=dev),
+                "slots": torch.tensor(chunk_slots, dtype=torch.int64, device=dev),
+                "nchunks": len(starts),
+                "slot_idx": slot_idx,
+                "seg_slots": {s for _, _, _, s in segs},
+                "contig": (slots == list(range(slots[0], slots[0] + len(slots)))) if slots else True,
+                "lo": slots[0] if slots else 0,
+                "hi": slots[-1] + 1 if slots else 0,
+            }
+        )
+    return plans
+
+
+_side_pgs = {}
+
+
+def _reduce_group(pg):
+    """A duplicate of ``pg`` on its own communicator when side_group is enabled, so the
+    amax all-reduce is not queued behind param all-gathers already in flight on ``pg``."""
+    if not use_side_group:
+        return pg
+    side = _side_pgs.get(id(pg))
+    if side is None:
+        ranks = torch.distributed.get_process_group_ranks(pg)
+        side = torch.distributed.new_group(ranks=ranks)
+        _side_pgs[id(pg)] = side
+    return side
+
+
+use_side_group = False
+
+
+def refresh(bucket_groups):
+    """Recompute every slot from the local shards if an optimizer step happened."""
+    global _dirty, _plan, _plan_nslots
+    if not _dirty or _disabled_reason is not None or not _slots:
+        return
+    if torch.cuda.is_current_stream_capturing():
+        return
+    _dirty = False
+    counters["refresh"] += 1
+    if _plan is None or _plan_nslots != len(_slots):
+        _plan = _build_plan(bucket_groups)
+        _plan_nslots = len(_slots)
+        if _plan is None:
+            return
+    _run_plans(_plan)
+
+
+_subset_plans = {}
+
+
+def refresh_subset(bucket_groups, groups):
+    """Recompute the slots of the weights owned by ``groups`` now, independent of the dirty
+    flag. ``bucket_groups`` is every bucket group, as passed to ``refresh``."""
+    if _disabled_reason is not None or not _slots or torch.cuda.is_current_stream_capturing():
+        return
+    key = tuple(id(g) for g in groups)
+    hit = _subset_plans.get(key)
+    if hit is None or hit[0] != len(_slots):
+        owned = {p for g in groups for b in g.buckets for p in b.params if p in _slots}
+        plans = _build_plan(bucket_groups, only=owned) if owned else []
+        if plans is None:
+            return
+        hit = _subset_plans[key] = (len(_slots), plans)
+    if hit[1]:
+        counters["subset_refresh"] = counters.get("subset_refresh", 0) + 1
+        _run_plans(hit[1])
+
+
+_lookup = {"n": -1, "fn": None}
+
+
+def slot_lookup():
+    """f(tensor) -> slot of the registered weight whose storage holds ``tensor``, or -1."""
+    import bisect
+
+    if _lookup["n"] != len(_slots):
+        ranges = sorted(
+            (p.data_ptr(), p.data_ptr() + p.numel() * p.element_size(), s) for p, s in _slots.items()
+        )
+        starts = [r[0] for r in ranges]
+
+        def fn(t):
+            ptr = t.data_ptr()
+            i = bisect.bisect_right(starts, ptr) - 1
+            if i >= 0 and ptr + t.numel() * t.element_size() <= ranges[i][1]:
+                return ranges[i][2]
+            return -1
+
+        _lookup.update(n=len(_slots), fn=fn)
+    return _lookup["fn"]
+
+
+def begin_fold(bucket_groups):
+    """Zero every slot so the optimizer step can max its updated shards into them.
+
+    Returns False (nothing changed) if the shard amax is unavailable."""
+    global _plan, _plan_nslots
+    if _disabled_reason is not None or not _slots or torch.cuda.is_current_stream_capturing():
+        return False
+    if _plan is None or _plan_nslots != len(_slots):
+        _plan = _build_plan(bucket_groups)
+        _plan_nslots = len(_slots)
+        if _plan is None:
+            return False
+    _zero_plans(_plan)
+    return True
+
+
+def finish_fold(covered):
+    """Combine the folded slots across ranks. ``covered`` holds the slots the step folded;
+    if any local shard was missed, every slot is recomputed from the shards instead."""
+    global _dirty
+    _dirty = False
+    if all(plan["seg_slots"] <= covered for plan in _plan):
+        counters["fold"] = counters.get("fold", 0) + 1
+        _run_plans(_plan, local=False)
+    else:
+        counters["fold_fallback"] = counters.get("fold_fallback", 0) + 1
+        _run_plans(_plan)
+
+
+def _zero_plans(plans):
+    for plan in plans:
+        if not len(plan["slot_idx"]):
+            continue
+        if plan["contig"]:
+            _amax_buf[plan["lo"] : plan["hi"]].zero_()
+        else:
+            _amax_buf.index_fill_(0, plan["slot_idx"], 0.0)
+
+
+def _run_plans(plans, local=True):
+    """Zero and recompute the slots from the local shards (unless ``local`` is False, when
+    they already hold the local maxima), then MAX-reduce them across the shard group."""
+    if local:
+        _zero_plans(plans)
+    for plan in plans:
+        if not len(plan["slot_idx"]):
+            continue
+        if plan["contig"]:
+            region = _amax_buf[plan["lo"] : plan["hi"]]
+        if local and plan["nchunks"]:
+            _segment_amax_kernel[(plan["nchunks"],)](
+                plan["base"],
+                plan["starts"],
+                plan["lens"],
+                plan["slots"],
+                _amax_buf,
+                BLOCK=_CHUNK_BLOCK,
+                ITERS=_CHUNK_ITERS,
+            )
+        pg = _reduce_group(plan["pg"])
+        if plan["contig"]:
+            torch.distributed.all_reduce(region, op=torch.distributed.ReduceOp.MAX, group=pg)
+        else:
+            vals = _amax_buf.index_select(0, plan["slot_idx"])
+            torch.distributed.all_reduce(vals, op=torch.distributed.ReduceOp.MAX, group=pg)
+            _amax_buf.index_copy_(0, plan["slot_idx"], vals)
diff --git a/transformer_engine/pytorch/optimizers/nvfp4_triton_adam.py b/transformer_engine/pytorch/optimizers/nvfp4_triton_adam.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd0d1ad44e68e5c13621005df66a6043db0eecc1
--- /dev/null
+++ b/transformer_engine/pytorch/optimizers/nvfp4_triton_adam.py
@@ -0,0 +1,268 @@
+# Classification: Internal
+"""Single-launch AdamW for TE FusedAdam's BF16 param + int16 remainder path.
+
+Replaces ``tex.multi_tensor_adam_param_remainder`` (about 4.9 TB/s with 320 CTAs per
+launch) and folds Megatron's gradient-clip scale into the update, so the separate
+``multi_tensor_scale`` pass over the FP32 main gradients disappears. Per-element math
+follows ``AdamFunctorMasterParamRemainder``: FP32 master = BF16 param and int16
+remainder, IEEE division and square root, bias corrections computed on the host.
+"""
+import math
+
+import numpy as np
+import torch
+import triton
+import triton.language as tl
+
+_BLOCK = 4096
+_NUM_WARPS = 8
+_TABLES = {}
+_PENDING_CLIP = {}
+_TE_FALLBACK = None
+
+
+@triton.jit
+def _aligned_base(table, idx, n_tensors, ALIGNED: tl.constexpr):
+    base = tl.load(table + idx * n_tensors)
+    if ALIGNED:
+        base = (base // 16) * 16
+    return base
+
+
+@triton.jit
+def _adam_remainder_kernel(
+    ptrs,
+    sizes,
+    block_tensor,
+    block_index,
+    coeff_ptr,
+    n_tensors,
+    lr,
+    beta1,
+    beta2,
+    bc1,
+    bc2,
+    eps,
+    decay,
+    ADAMW: tl.constexpr,
+    HAS_COEFF: tl.constexpr,
+    G_BF16: tl.constexpr,
+    ALIGNED: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    t = tl.load(block_tensor + pid)
+    start = tl.load(block_index + pid).to(tl.int64) * BLOCK
+    n = tl.load(sizes + t)
+    offs = start + tl.arange(0, BLOCK)
+    offs = tl.max_contiguous(tl.multiple_of(offs, BLOCK), BLOCK)
+    mask = offs < n
+
+    g_type = tl.bfloat16 if G_BF16 else tl.float32
+    g_ptr = _aligned_base(ptrs + t, 0, n_tensors, ALIGNED).to(tl.pointer_type(g_type))
+    p_ptr = _aligned_base(ptrs + t, 1, n_tensors, ALIGNED).to(tl.pointer_type(tl.int16))
+    m_ptr = _aligned_base(ptrs + t, 2, n_tensors, ALIGNED).to(tl.pointer_type(tl.float32))
+    v_ptr = _aligned_base(ptrs + t, 3, n_tensors, ALIGNED).to(tl.pointer_type(tl.float32))
+    r_ptr = _aligned_base(ptrs + t, 4, n_tensors, ALIGNED).to(tl.pointer_type(tl.int16))
+
+    g = tl.load(g_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    if HAS_COEFF:
+        g = g * tl.load(coeff_ptr)
+    m = tl.load(m_ptr + offs, mask=mask, other=0.0)
+    v = tl.load(v_ptr + offs, mask=mask, other=0.0)
+    p = tl.load(p_ptr + offs, mask=mask, other=0).to(tl.int32)
+    r = tl.load(r_ptr + offs, mask=mask, other=0).to(tl.int32)
+
+    p = p - (r < 0).to(tl.int32)
+    master = ((p << 16) | (r & 0xFFFF)).to(tl.float32, bitcast=True)
+
+    if ADAMW:
+        m = beta1 * m + (1 - beta1) * g
+        v = beta2 * v + (1 - beta2) * g * g
+        denom = tl.sqrt_rn(tl.div_rn(v, bc2)) + eps
+        update = tl.div_rn(tl.div_rn(m, bc1), denom) + decay * master
+    else:
+        g = g + decay * master
+        m = beta1 * m + (1 - beta1) * g
+        v = beta2 * v + (1 - beta2) * g * g
+        denom = tl.sqrt_rn(tl.div_rn(v, bc2)) + eps
+        update = tl.div_rn(tl.div_rn(m, bc1), denom)
+    master = master - lr * update
+
+    bits = master.to(tl.int32, bitcast=True)
+    r_new = (bits << 16) >> 16
+    p_new = (bits >> 16) + (r_new < 0).to(tl.int32)
+
+    tl.store(m_ptr + offs, m, mask=mask)
+    tl.store(v_ptr + offs, v, mask=mask)
+    tl.store(p_ptr + offs, p_new.to(tl.int16), mask=mask)
+    tl.store(r_ptr + offs, r_new.to(tl.int16), mask=mask)
+
+
+def _table(lists):
+    key = tuple(t.data_ptr() for lst in lists for t in lst)
+    entry = _TABLES.get(key)
+    if entry is None:
+        device = lists[0][0].device
+        numels = [t.numel() for t in lists[0]]
+        blocks = [(n + _BLOCK - 1) // _BLOCK for n in numels]
+        counts = torch.tensor(blocks, dtype=torch.int64)
+        block_tensor = torch.repeat_interleave(torch.arange(len(blocks), dtype=torch.int32), counts)
+        first = torch.cumsum(counts, 0) - counts
+        block_index = torch.arange(int(counts.sum()), dtype=torch.int64) - first.repeat_interleave(counts)
+        entry = (
+            torch.tensor(key, dtype=torch.int64, device=device),
+            torch.tensor(numels, dtype=torch.int64, device=device),
+            block_tensor.to(device),
+            block_index.to(torch.int32).to(device),
+            all(k % 16 == 0 for k in key),
+        )
+        _TABLES[key] = entry
+    return entry
+
+
+def unsupported_reason(tensor_lists):
+    if len(tensor_lists) != 5 or not tensor_lists[0]:
+        return "expected 5 non-empty tensor lists"
+    g, p, m, v, r = tensor_lists
+    if g[0].dtype not in (torch.float32, torch.bfloat16):
+        return f"grad dtype {g[0].dtype}"
+    for lst, dtype in ((g, g[0].dtype), (p, torch.bfloat16), (m, torch.float32),
+                       (v, torch.float32), (r, torch.int16)):
+        if any(t.dtype != dtype or not t.is_contiguous() for t in lst):
+            return f"dtype or layout mismatch (want {dtype})"
+    for i in range(len(g)):
+        n = g[i].numel()
+        if p[i].numel() != n or m[i].numel() != n or v[i].numel() != n or r[i].numel() != n:
+            return "numel mismatch"
+    if max(t.numel() for t in g) >= 2**31:
+        return "tensor too large"
