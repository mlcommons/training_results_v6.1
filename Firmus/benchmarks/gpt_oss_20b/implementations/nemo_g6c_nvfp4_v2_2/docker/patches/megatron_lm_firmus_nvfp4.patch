+@torch.no_grad()
+def _edit_param(param: torch.Tensor, edit: Callable[[torch.Tensor], None]) -> None:
+    """Apply an in-place init edit to a (possibly quantized) parameter.
+
+    With quantized primary weights the distributed optimizer seeds its FP32
+    main weights from the preserved high-precision init value, so the edit
+    must reach that copy as well as the quantized data.
+    """
+    if hasattr(param, "dequantize") and hasattr(param, "quantize_"):
+        value = param.dequantize()
+        edit(value)
+        param.quantize_(value)
+    else:
+        edit(param)
+    get_init_val = getattr(param, "get_high_precision_init_val", None)
+    if get_init_val is not None:
+        init_val = get_init_val()
+        if init_val is not None:
+            edit(init_val)
 
 
