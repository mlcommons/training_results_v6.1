+def _reset_grad_buffer(buffer):
+    """Zero the grad buffer except params whose wgrad GEMM overwrites main_grad.
+
+    Padding is zeroed by the first full reset and is never written afterwards.
+    """
+    overwritten = sum(
+        1 for p in buffer.param_index_map if getattr(p, "_nvfp4_wgrad_overwrite", False)
+    )
+    if overwritten == 0:
+        buffer.reset()
+        return
+    cached = getattr(buffer, "_nvfp4_zero_views", None)
+    if cached is None or cached[0] != overwritten:
+        spans = sorted(
+            (start, end)
+            for p, (start, end, _) in buffer.param_index_map.items()
+            if not getattr(p, "_nvfp4_wgrad_overwrite", False)
+        )
+        merged = []
+        for start, end in spans:
+            if merged and start <= merged[-1][1]:
+                merged[-1][1] = max(merged[-1][1], end)
+            else:
+                merged.append([start, end])
+        skipped = [
+            buffer.grad_data[start:end]
+            for p, (start, end, _) in buffer.param_index_map.items()
+            if getattr(p, "_nvfp4_wgrad_overwrite", False)
+        ]
+        cached = (overwritten, [buffer.grad_data[s:e] for s, e in merged], skipped)
+        buffer._nvfp4_zero_views = cached
+        if torch.distributed.get_rank() == 0:
+            print(
+                f"NVFP4 grad zero: {overwritten} overwritten params skipped, {len(merged)} spans, "
+                f"{sum(e - s for s, e in merged)}/{buffer.grad_data.numel()} elements",
+                flush=True,
+            )
+    if cached[1]:
+        torch._foreach_zero_(cached[1])
+    if os.environ.get("NVFP4_DEBUG_OVERWRITE_NAN", "0") == "1":
+        # Any skipped element the wgrad GEMM fails to write turns the grad norm NaN.
+        for view in cached[2]:
+            view.fill_(float("nan"))
+    for grad in buffer.extra_main_grads:
+        grad.zero_()
+
