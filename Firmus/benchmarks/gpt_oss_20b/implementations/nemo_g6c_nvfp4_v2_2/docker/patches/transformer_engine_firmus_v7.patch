+# Classification: Internal
+"""Gradient sums folded into the Triton RMSNorm backward (NVFP4_RESGRAD=1).
+
+A layer input ``h`` feeds both the residual add and the RMSNorm in front of the
+sublayer, so autograd sums ``d_residual + d_norm`` with a separate BF16 add over
+the whole [tokens, hidden] tensor. Here the residual add's backward hands its
+gradient to the RMSNorm backward of the same input (keyed by the input's storage),
+which adds it while writing dx.
+
+With NVFP4_RESGRAD_ROUTER=1 the pre-MLP norm output's two consumers (router and
+token permutation) are treated the same way: the router's input gradient is handed
+to the norm backward, which sums it with the permutation gradient while loading dz.
+
+Both sums are rounded exactly as the PyTorch BF16 adds they replace, so results
+are bit-identical. Every handed-over gradient must be consumed before the next
+forward starts; otherwise ``check_empty`` raises.
+"""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+_STAGES = int(os.environ.get("NVFP4_RMSNORM_BWD_STAGES", "1"))
+_pending = {}  # norm input key -> residual gradient
+_pending_dz = {}  # norm input key -> extra output gradient (router)
+_norm_inputs = {}  # pre-MLP norm output key -> norm input key
+_stats = {"handed": 0, "handed_dz": 0, "fused": 0}
+
+
+def _key(t):
+    # LayerNormLinear saves its input as a [-1, hidden] view of the [s, b, h] residual.
+    return (t.untyped_storage().data_ptr(), t.storage_offset(), t.numel(), t.dtype)
+
+
+def check_empty():
+    _norm_inputs.clear()
+    if _preadded:
+        raise RuntimeError("NVFP4_RESGRAD_FWD: an unpermute output with the residual added was not "
+                           "consumed by the MLP bias-dropout-add")
+    if _pending or _pending_dz:
+        raise RuntimeError(
+            f"NVFP4_RESGRAD: {len(_pending)} residual and {len(_pending_dz)} router gradients were "
+            "not consumed by an RMSNorm backward; the tensor is used by another op"
+        )
+
+
+def hand_over(residual, grad):
+    k = _key(residual)
+    if k in _pending:
+        raise RuntimeError("NVFP4_RESGRAD: residual gradient handed over twice")
+    _pending[k] = grad
+    _stats["handed"] += 1
+
+
+def record_norm(y, x):
+    _norm_inputs[_key(y)] = _key(x)
+
+
+class _TapGrad(torch.autograd.Function):
+    """Identity whose input gradient is handed to the norm backward of ``key`` instead."""
+
+    @staticmethod
+    def forward(ctx, y, key):
+        ctx.key = key
+        return y.view_as(y)
+
+    @staticmethod
+    def backward(ctx, grad):
+        if ctx.key in _pending_dz:
+            raise RuntimeError("NVFP4_RESGRAD: router gradient handed over twice")
+        _pending_dz[ctx.key] = grad
+        _stats["handed_dz"] += 1
+        return None, None
+
+
+def tap_norm_output(y):
+    """``y`` unchanged if it is not a recorded norm output, else a tapped alias of it."""
+    k = _norm_inputs.pop(_key(y), None)
+    if k is None or not (torch.is_grad_enabled() and y.requires_grad):
+        return y
+    return _TapGrad.apply(y, k)
+
+
+@triton.jit
+def _rmsnorm_bwd_res_kernel(
+    dz_ptr, dz2_ptr, x_ptr, rsigma_ptr, gamma_ptr, dres_ptr, dx_ptr, dgamma_part_ptr,
+    rows, cols, stride_row,
+    ZERO_CENTERED: tl.constexpr, HAS_DZ2: tl.constexpr, HAS_RES: tl.constexpr,
+    BLOCK_N: tl.constexpr, STAGES: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    num_programs = tl.num_programs(0)
+    offs = tl.arange(0, BLOCK_N)
+    mask = offs < cols
+    gamma = tl.load(gamma_ptr + offs, mask=mask, other=0.0).to(tl.float32)
+    if ZERO_CENTERED:
+        gamma = gamma + 1.0
+    dgamma_acc = tl.zeros([BLOCK_N], dtype=tl.float32)
+    for row in tl.range(pid, rows, num_programs, num_stages=STAGES):
+        base = row.to(tl.int64) * stride_row
+        x = tl.load(x_ptr + base + offs, mask=mask, other=0.0).to(tl.float32)
+        dz = tl.load(dz_ptr + base + offs, mask=mask, other=0.0)
+        if HAS_DZ2:
+            dz2 = tl.load(dz2_ptr + base + offs, mask=mask, other=0.0)
+            dz = (dz.to(tl.float32) + dz2.to(tl.float32)).to(dz_ptr.dtype.element_ty)
+        dz = dz.to(tl.float32)
+        rs = tl.load(rsigma_ptr + row)
+        xhat = x * rs
+        gdz = dz * gamma
+        mdot = tl.sum(gdz * xhat, axis=0) / cols
+        # Explicit fma: the contraction the Triton bwd gets; with the extra loads the
+        # compiler otherwise contracts dz * gamma instead and dx differs by 1 ulp.
+        dx = (rs * tl.fma(-xhat, mdot, gdz)).to(dx_ptr.dtype.element_ty)
+        if HAS_RES:
+            dres = tl.load(dres_ptr + base + offs, mask=mask, other=0.0)
+            dx = (dx.to(tl.float32) + dres.to(tl.float32)).to(dx_ptr.dtype.element_ty)
+        tl.store(dx_ptr + base + offs, dx, mask=mask)
+        dgamma_acc += dz * xhat
+    tl.store(dgamma_part_ptr + pid.to(tl.int64) * BLOCK_N + offs, dgamma_acc, mask=mask)
+
+
+_NUM_SMS = {}
+
+
+def _rows(t, cols):
+    t = t.reshape(-1, cols)
+    return t if t.is_contiguous() else t.contiguous()
+
+
+def make_rmsnorm_bwd(base_bwd, reduce_rows_kernel):
+    """Wrap the Triton ``rmsnorm_bwd`` so handed-over gradients are summed in."""
+
+    def rmsnorm_bwd(dz, x, rsigma, gamma, sm_margin=0, zero_centered_gamma=False):
+        dres = dz_extra = None
+        if _pending or _pending_dz:
+            k = _key(x)
+            dres = _pending.pop(k, None)
+            dz_extra = _pending_dz.pop(k, None)
+        if dres is None and dz_extra is None:
+            return base_bwd(dz, x, rsigma, gamma, sm_margin, zero_centered_gamma)
+        cols = gamma.numel()
+        x2 = _rows(x, cols)
+        dz2 = _rows(dz, cols)
+        r2 = _rows(dres, cols) if dres is not None else dz2
+        e2 = _rows(dz_extra, cols) if dz_extra is not None else dz2
+        rows = x2.shape[0]
+        device = x2.device
+        if device not in _NUM_SMS:
+            _NUM_SMS[device] = torch.cuda.get_device_properties(device).multi_processor_count
+        block_n = triton.next_power_of_2(cols)
+        programs = max(1, min(rows, 2 * (_NUM_SMS[device] - int(sm_margin))))
+        dx = torch.empty_like(x2)
+        part = torch.empty((programs, block_n), dtype=torch.float32, device=device)
+        _rmsnorm_bwd_res_kernel[(programs,)](
+            dz2, e2, x2, rsigma.reshape(-1), gamma.reshape(-1), r2, dx, part,
+            rows, cols, x2.stride(0),
+            ZERO_CENTERED=bool(zero_centered_gamma), HAS_DZ2=dz_extra is not None,
+            HAS_RES=dres is not None, BLOCK_N=block_n, STAGES=_STAGES, num_warps=8,
+        )
+        dgamma = torch.empty_like(gamma)
+        block_c = 128
+        reduce_rows_kernel[(triton.cdiv(cols, block_c),)](
+            part, dgamma.reshape(-1), programs, cols, BLOCK_P=32, BLOCK_C=block_c, STRIDE=block_n,
+            num_warps=4,
+        )
+        _stats["fused"] += 1
+        return dx.view(x.shape), dgamma
+
+    return rmsnorm_bwd
+
+
+@triton.jit
+def _unpermute_bias_residual_kernel(
+    input_ptr, row_id_map_ptr, bias_ptr, scale_ptr, residual_ptr, output_ptr,
+    stride_row_id_map_token, stride_row_id_map_expert, stride_input_token, stride_output_token,
+    stride_bias_expert,
+    num_experts: tl.constexpr, hidden_size: tl.constexpr, UNROLL: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    # TE's _unpermute_expert_bias_unrolled_kernel (same sum, same order), then
+    # ``residual + out`` rounded as the PyTorch BF16 add of the two.
+    pid_t = tl.program_id(0)
+    offs = tl.arange(0, BLOCK_SIZE)
+    mask = offs < hidden_size
+    map_row = row_id_map_ptr + pid_t * stride_row_id_map_token
+    accumulator = tl.zeros((BLOCK_SIZE,), dtype=tl.float32)
+    n_routed = tl.load(map_row + num_experts * 2 * stride_row_id_map_expert)
+    for idx in tl.static_range(UNROLL):
+        valid = idx < n_routed
+        src_row = tl.load(map_row + idx * stride_row_id_map_expert, mask=valid, other=0).to(tl.int64)
+        expert = tl.load(map_row + (num_experts + idx) * stride_row_id_map_expert, mask=valid, other=0)
+        x = tl.load(input_ptr + src_row * stride_input_token + offs, mask=mask & valid, other=0.0).to(
+            tl.float32
+        )
+        b = tl.load(bias_ptr + expert * stride_bias_expert + offs, mask=mask & valid, other=0.0).to(
+            tl.float32
+        )
+        s = tl.load(scale_ptr + src_row, mask=valid, other=0.0)
+        v = tl.fma(b, s, x).to(input_ptr.dtype.element_ty).to(tl.float32)
+        accumulator += tl.where(valid, v, 0.0)
+    for idx in tl.range(UNROLL, n_routed):
+        src_row = tl.load(map_row + idx * stride_row_id_map_expert).to(tl.int64)
+        expert = tl.load(map_row + (num_experts + idx) * stride_row_id_map_expert)
+        x = tl.load(input_ptr + src_row * stride_input_token + offs, mask=mask).to(tl.float32)
+        b = tl.load(bias_ptr + expert * stride_bias_expert + offs, mask=mask).to(tl.float32)
+        s = tl.load(scale_ptr + src_row)
+        accumulator += tl.fma(b, s, x).to(input_ptr.dtype.element_ty).to(tl.float32)
+    out = accumulator.to(output_ptr.dtype.element_ty)
+    row = pid_t.to(tl.int64) * stride_output_token
+    r = tl.load(residual_ptr + row + offs, mask=mask, other=0.0)
+    out = (r.to(tl.float32) + out.to(tl.float32)).to(output_ptr.dtype.element_ty)
+    tl.store(output_ptr + row + offs, out, mask=mask)
+
+
+_fwd_residual = [None]  # residual of the MLP sublayer being run
+_preadded = {}  # unpermute output key -> residual already added into it
+
+
+def make_unpermute(tp, orig_unpermute):
+    """Unpermute with deferred FC2 bias that also adds the pending MLP residual."""
+
+    def unpermute_with_mask_map(inp, row_id_map, merging_probs, permuted_probs, pad_offsets,
+                                num_tokens, num_experts, hidden_size):
+        residual = _fwd_residual[0]
+        if (
+            residual is None
+            or merging_probs is not None
+            or permuted_probs is not None
+            or pad_offsets is not None
+            or inp.data_ptr() not in tp._PENDING_EXPERT_BIAS
+            or tp._EXPERT_BIAS_UNROLL <= 0
+            or residual.dtype != inp.dtype
+            or residual.numel() != num_tokens * hidden_size
+            or not residual.is_contiguous()
+            or inp.stride(1) != 1
+        ):
+            return orig_unpermute(inp, row_id_map, merging_probs, permuted_probs, pad_offsets,
+                                  num_tokens, num_experts, hidden_size)
+        _fwd_residual[0] = None
+        bias, scale = tp._PENDING_EXPERT_BIAS.pop(inp.data_ptr())
+        output = torch.empty((num_tokens, hidden_size), dtype=inp.dtype, device="cuda")
+        _unpermute_bias_residual_kernel[(num_tokens,)](
+            inp, row_id_map, bias, scale, residual, output,
+            row_id_map.stride(0), row_id_map.stride(1), inp.stride(0), output.stride(0),
+            bias.stride(0), num_experts, hidden_size,
+            UNROLL=tp._EXPERT_BIAS_UNROLL, BLOCK_SIZE=triton.next_power_of_2(hidden_size),
+            num_warps=tp._EXPERT_BIAS_WARPS,
+        )
+        _preadded[_key(output)] = residual
+        return output, None
+
+    return unpermute_with_mask_map
+
+
+class _PreAdded(torch.autograd.Function):
+    """``x`` already holds ``residual + mlp_out``; routes the residual gradient like _ResidualAdd."""
+
+    @staticmethod
+    def forward(ctx, x, residual):
+        ctx.residual = residual
+        return x.view_as(x)
+
+    @staticmethod
+    def backward(ctx, grad):
+        hand_over(ctx.residual, grad)
+        ctx.residual = None
+        return grad, None
+
+
+class _ResidualAdd(torch.autograd.Function):
+    """``residual + x``; the residual gradient goes to the RMSNorm backward of ``residual``."""
+
+    @staticmethod
+    def forward(ctx, x, residual):
+        ctx.residual = residual
+        return residual + x
+
+    @staticmethod
+    def backward(ctx, grad):
+        hand_over(ctx.residual, grad)
+        ctx.residual = None
+        return grad, None
+
+
+def make_bias_residual_add(kernel):
+    class _BiasResidualAdd(torch.autograd.Function):
+        @staticmethod
+        def forward(ctx, x, bias, residual):
+            out = torch.empty_like(x)
+            numel = x.numel()
+            block = 4096
+            kernel[(triton.cdiv(numel, block),)](
+                x, bias, residual, out, numel, x.shape[-1], BLOCK=block, num_warps=8
+            )
+            ctx.bias_shape = bias.shape
+            ctx.residual = residual
+            return out
+
+        @staticmethod
+        def backward(ctx, grad):
+            hand_over(ctx.residual, grad)
+            ctx.residual = None
+            return grad, grad.sum_to_size(ctx.bias_shape), None
+
+    return _BiasResidualAdd
+
+
+def install():
+    """Patch the RMSNorm backward call sites, Megatron's bias-dropout-add and (optionally) the router input."""
+    import megatron.core.fusions.fused_bias_dropout as mc_bda
+    import transformer_engine.pytorch.ops.basic.rmsnorm as te_rmsnorm_op
+    import transformer_engine_torch as tex
+    from megatron.core.transformer.transformer_layer import TransformerLayer
+    from transformer_engine.pytorch.ops.basic import nvfp4_triton_bias_residual as tbr
+    from transformer_engine.pytorch.ops.basic import nvfp4_triton_rmsnorm_bwd as trb
+
+    if tex.rmsnorm_bwd is not trb.rmsnorm_bwd:
+        raise RuntimeError("NVFP4_RESGRAD needs NVFP4_TRITON_RMSNORM_BWD=1")
+    if int(os.environ.get("NVFP4_RMSNORM_BWD_UNROLL", "1")) != 1:
+        raise RuntimeError("NVFP4_RESGRAD supports NVFP4_RMSNORM_BWD_UNROLL=1 only")
+    fused_bwd = make_rmsnorm_bwd(trb.rmsnorm_bwd, trb._reduce_rows_kernel)
+    tex.rmsnorm_bwd = fused_bwd
+    te_rmsnorm_op.rmsnorm_bwd = fused_bwd
+
+    bias_res = make_bias_residual_add(tbr._bias_residual_add_kernel)
+    orig_bda = mc_bda._bias_dropout_add_func
+
+    def bda(x_with_bias, residual, prob, training):
+        x, bias = x_with_bias
+        pre = _preadded.pop(_key(x), None) if _preadded else None
+        if pre is not None:
+            if pre is not residual or bias is not None or prob != 0.0:
+                raise RuntimeError("NVFP4_RESGRAD_FWD: unpermute output reached a different add")
+            return _PreAdded.apply(x, residual)
+        if not (training and torch.is_grad_enabled() and residual.requires_grad):
+            return orig_bda(x_with_bias, residual, prob, training)
+        if bias is not None and tbr.eligible(x, bias, residual, prob, training):
+            return bias_res.apply(x, bias, residual)
+        if bias is None and prob == 0.0 and x.dtype == residual.dtype and x.shape == residual.shape:
+            return _ResidualAdd.apply(x, residual)
+        return orig_bda(x_with_bias, residual, prob, training)
+
+    mc_bda._bias_dropout_add_func = bda
+
+    orig_forward = TransformerLayer.forward
+
+    def forward(self, *args, **kwargs):
+        if self.layer_number == 1:
+            check_empty()
+        return orig_forward(self, *args, **kwargs)
+
+    TransformerLayer.forward = forward
+
+    router = os.environ.get("NVFP4_RESGRAD_ROUTER", "0") == "1"
+    if router:
+        from megatron.core.transformer.moe.moe_layer import MoELayer
+
+        if os.environ.get("NVFP4_FUSED_PERMUTE_PAD", "0") != "1" and int(
+            os.environ.get("NVFP4_PADDED_EXPERT_HIDDEN", "0")
+        ):
+            raise RuntimeError("NVFP4_RESGRAD_ROUTER needs NVFP4_FUSED_PERMUTE_PAD=1 with padding")
+        orig_pre_mlp = TransformerLayer._forward_pre_mlp_layernorm
+
+        def pre_mlp(self, hidden_states):
+            out = orig_pre_mlp(self, hidden_states)
+            if self.training and torch.is_grad_enabled() and isinstance(out, torch.Tensor):
+                record_norm(out, hidden_states)
+            return out
+
+        TransformerLayer._forward_pre_mlp_layernorm = pre_mlp
+        orig_route = MoELayer.route
+
+        def route(self, hidden_states, *args, **kwargs):
+            return orig_route(self, tap_norm_output(hidden_states), *args, **kwargs)
+
+        MoELayer.route = route
+
+    fwd = os.environ.get("NVFP4_RESGRAD_FWD", "0") == "1"
+    if fwd:
+        import transformer_engine.pytorch.triton.permutation as tp
+
+        if os.environ.get("NVFP4_DEFER_FC2_BIAS", "0") != "1" or tp._EXPERT_BIAS_UNROLL <= 0:
+            raise RuntimeError("NVFP4_RESGRAD_FWD needs NVFP4_DEFER_FC2_BIAS=1 and "
+                               "NVFP4_UNPERMUTE_BIAS_UNROLL>0")
+        tp.unpermute_with_mask_map = make_unpermute(tp, tp.unpermute_with_mask_map)
+        orig_run_mlp = TransformerLayer._run_mlp
+
+        def run_mlp(self, pre_mlp_layernorm_output, residual, *args, **kwargs):
+            if self.training and torch.is_grad_enabled():
+                _fwd_residual[0] = residual
+            try:
+                return orig_run_mlp(self, pre_mlp_layernorm_output, residual, *args, **kwargs)
+            finally:
+                _fwd_residual[0] = None
+
+        TransformerLayer._run_mlp = run_mlp
+    if int(os.environ.get("RANK", "0")) == 0:
+        print(f"NVFP4_RESGRAD installed (router {int(router)}, fwd {int(fwd)})", flush=True)
diff --git a/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast.py b/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast.py
new file mode 100644
index 00000000..b1051860
--- /dev/null
+++ b/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast.py
@@ -0,0 +1,128 @@
+# Classification: Internal
+"""One-launch NVFP4 2D cast of every local piece of an FP4 all-gather bucket.
+
+Each piece is rows [r0, r1) of one expert weight (a multiple of 16 rows). The kernel writes
+the row-wise data and scales and the column-wise data and scales straight into the gather
+buffers in the unpadded layouts of nvfp4_fp4_ag (row data [R, K/2], row scales [R, K/16],
+column data [K, R/2], column scales [K, R/16]). Numerics follow nvfp4_group_weight_quant
+(TE ``quantize_transpose_nvfp4_2D_kernel``, round-to-nearest) with the amax taken from the
+piece's shard-amax slot.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+_FLT_MAX = tl.constexpr(3.4028234663852886e38)
+_FIELDS = 8  # src elem offset, rows, K, amax slot, row data, row scale, col data, col scale
+
+
+@triton.jit
+def _cvt_e2m1x2(lo, hi):
+    return tl.inline_asm_elementwise(
+        """
+        {
+        .reg .b8 b0, b1, b2, b3;
+        cvt.rn.satfinite.e2m1x2.f32 b0, $5, $1;
+        cvt.rn.satfinite.e2m1x2.f32 b1, $6, $2;
+        cvt.rn.satfinite.e2m1x2.f32 b2, $7, $3;
+        cvt.rn.satfinite.e2m1x2.f32 b3, $8, $4;
+        mov.b32 $0, {b0, b1, b2, b3};
+        }
+        """,
+        "=r,r,r,r,r,r,r,r,r",
+        [lo, hi],
+        dtype=tl.uint8,
+        is_pure=True,
+        pack=4,
+    )
+
+
+@triton.jit
+def _shard_cast_kernel(
+    table_ptr,
+    src_ptr,
+    amax_ptr,
+    data_r_ptr,
+    scale_r_ptr,
+    data_c_ptr,
+    scale_c_ptr,
+    MB: tl.constexpr,
+    KB: tl.constexpr,
+):
+    pid_k = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    t = table_ptr + tl.program_id(2).to(tl.int64) * 8
+    src_off = tl.load(t)
+    R = tl.load(t + 1)
+    K = tl.load(t + 2)
+    slot = tl.load(t + 3)
+    o_dr = tl.load(t + 4)
+    o_sr = tl.load(t + 5)
+    o_dc = tl.load(t + 6)
+    o_sc = tl.load(t + 7)
+    row0 = pid_m * (MB * 16)
+    col0 = pid_k * (KB * 16)
+    if (row0 >= R) | (col0 >= K):
+        return
+
+    amax = tl.load(amax_ptr + slot)
+    s_enc = tl.minimum(tl.math.div_rn(2688.0, amax), _FLT_MAX)
+    s_enc = tl.where((amax == 0.0) | (s_enc == 0.0), 1.0, s_enc)
+    s_dec = tl.math.div_rn(1.0, s_enc)
+
+    mb = tl.arange(0, MB)
+    kb = tl.arange(0, KB)
+    i16 = tl.arange(0, 16)
+    i8 = tl.arange(0, 8)
+    rows = row0 + mb[:, None, None, None] * 16 + i16[None, :, None, None]
+    cols = col0 + kb[None, None, :, None] * 16 + i16[None, None, None, :]
+    # Pieces are whole 16-row blocks and K is a multiple of 64, so masks are block-uniform.
+    mask = (rows < R) & (cols < K)
+    x = tl.load(src_ptr + src_off + rows.to(tl.int64) * K + cols, mask=mask, other=0.0).to(tl.float32)
+
+    blk = tl.max(tl.max(tl.abs(x), axis=3), axis=1)
+    sf = tl.minimum(blk * (s_enc * 0.16666666666666666), _FLT_MAX).to(tl.float8e4nv)
+    inv = tl.minimum(tl.math.div_rn(1.0, sf.to(tl.float32) * s_dec), _FLT_MAX)
+    y = x * inv[:, None, :, None]
+    sf_bits = sf.to(tl.uint8, bitcast=True)
+
+    lo, hi = tl.split(tl.reshape(y, [MB, 16, KB, 8, 2]))
+    packed = _cvt_e2m1x2(lo, hi)
+    hcols = col0 // 2 + kb[None, None, :, None] * 8 + i8[None, None, None, :]
+    tl.store(data_r_ptr + o_dr + rows.to(tl.int64) * (K // 2) + hcols, packed, mask=(rows < R) & (hcols < K // 2))
+
+    srow = row0 + mb[:, None, None] * 16 + i16[None, :, None]
+    scol = pid_k * KB + kb[None, None, :]
+    rs = tl.broadcast_to(sf_bits[:, None, :], [MB, 16, KB])
+    tl.store(scale_r_ptr + o_sr + srow.to(tl.int64) * (K // 16) + scol, rs, mask=(srow < R) & (scol < K // 16))
+
+    lo, hi = tl.split(tl.permute(tl.reshape(y, [MB, 8, 2, KB, 16]), (0, 1, 3, 4, 2)))
+    packed = _cvt_e2m1x2(lo, hi)
+    ccols = col0 + kb[None, None, :, None] * 16 + i16[None, None, None, :]
+    hrows = row0 // 2 + mb[:, None, None, None] * 8 + i8[None, :, None, None]
+    tl.store(data_c_ptr + o_dc + ccols.to(tl.int64) * (R // 2) + hrows, packed, mask=(ccols < K) & (hrows < R // 2))
+
+    crow = col0 + kb[None, :, None] * 16 + i16[None, None, :]
+    ccol = pid_m * MB + mb[:, None, None]
+    cs = tl.broadcast_to(sf_bits[:, :, None], [MB, KB, 16])
+    tl.store(scale_c_ptr + o_sc + crow.to(tl.int64) * (R // 16) + ccol, cs, mask=(crow < K) & (ccol < R // 16))
+
+
+class ShardCast:
+    """Static piece table for one bucket; ``__call__`` casts every local piece."""
+
+    def __init__(self, pieces, device, bm=64, bk=64, num_warps=4):
+        # pieces: (src elem offset, rows, cols, amax slot, row data, row scale, col data, col scale)
+        assert pieces
+        for p in pieces:
+            assert p[1] % 16 == 0 and p[2] % bk == 0, p
+        self.table = torch.tensor(pieces, dtype=torch.int64, device=device).view(-1, _FIELDS)
+        self.grid = (max(p[2] for p in pieces) // bk, triton.cdiv(max(p[1] for p in pieces), bm), len(pieces))
+        self.bm, self.bk, self.num_warps = bm, bk, num_warps
+
+    def __call__(self, src, amax_buf, data_r, scale_r, data_c, scale_c):
+        _shard_cast_kernel[self.grid](
+            self.table, src, amax_buf, data_r, scale_r, data_c, scale_c,
+            MB=self.bm // 16, KB=self.bk // 16, num_warps=self.num_warps,
+        )
diff --git a/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast_cuda.py b/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast_cuda.py
new file mode 100644
index 00000000..5c918f22
--- /dev/null
+++ b/transformer_engine/pytorch/ops/fused/nvfp4_shard_cast_cuda.py
@@ -0,0 +1,62 @@
+# Classification: Internal
+"""CUDA version of nvfp4_shard_cast.ShardCast (same piece table, same outputs, bitwise equal).
+
+Built once with `build(dir)`; training ranks load the .so from NVFP4_SHARD_CAST_EXT.
+"""
+import importlib.util
+import os
+
+import torch
+
+EXT_NAME = "nvfp4_shard_cast_ext"
+TILE = 128
+_ext = None
+
+
+def build(build_dir, name=EXT_NAME, arch="10.3a", verbose=True):
+    from torch.utils.cpp_extension import load
+
+    os.environ["TORCH_CUDA_ARCH_LIST"] = arch
+    src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "shard_cast_ext.cu")
+    os.makedirs(build_dir, exist_ok=True)
+    return load(name=name, sources=[src], build_directory=build_dir,
+                extra_cuda_cflags=["-O3"], verbose=verbose)
+
+
+def _get_ext():
+    global _ext
+    if _ext is None:
+        path = os.environ["NVFP4_SHARD_CAST_EXT"]
+        spec = importlib.util.spec_from_file_location(os.path.basename(path).split(".")[0], path)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        _ext = mod
+    return _ext
+
+
+def set_ext(mod):
+    global _ext
+    _ext = mod
+
+
+def supported(pieces):
+    """Store alignment the kernel relies on (row data 16 B, column data 8 B, row scales 4 B)."""
+    for _, rows, cols, _, o_dr, o_sr, o_dc, _ in pieces:
+        if rows % 16 or cols % 64 or o_dr % 16 or o_dc % 8 or o_sr % 4 or (cols // 16) % 4:
+            return False
+    return True
+
+
+class ShardCastCUDA:
+    """Static piece table for one bucket; ``__call__`` casts every local piece."""
+
+    def __init__(self, pieces, device):
+        assert pieces and supported(pieces), pieces
+        self.table = torch.tensor(pieces, dtype=torch.int64, device=device).view(-1, 8)
+        tiles = [(i, m, k) for i, p in enumerate(pieces)
+                 for m in range(-(-p[1] // TILE)) for k in range(-(-p[2] // TILE))]
+        self.tiles = torch.tensor(tiles, dtype=torch.int32, device=device)
+
+    def __call__(self, src, amax_buf, data_r, scale_r, data_c, scale_c):
+        _get_ext().shard_cast(self.table, self.tiles, src, amax_buf, data_r, scale_r, data_c,
+                              scale_c)
diff --git a/transformer_engine/pytorch/ops/fused/shard_cast_ext.cu b/transformer_engine/pytorch/ops/fused/shard_cast_ext.cu
new file mode 100644
index 00000000..a1fbbbb7
--- /dev/null
+++ b/transformer_engine/pytorch/ops/fused/shard_cast_ext.cu
@@ -0,0 +1,219 @@
+// Classification: Internal
+// NVFP4 2D (16x16 block) cast of the local pieces of an FP4 all-gather bucket, written straight
+// into the gather buffers (row data [R, K/2], row scales [R, K/16], column data [K, R/2], column
+// scales [K, R/16]). Same numerics as nvfp4_shard_cast._shard_cast_kernel (TE
+// quantize_transpose_nvfp4_2D_kernel, round-to-nearest, per-piece amax slot).
+#include <c10/cuda/CUDAStream.h>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+#include <torch/extension.h>
+
+#include <cfloat>
+#include <cstdint>
+
+namespace {
+
+constexpr int kTR = 128;  // tile rows
+constexpr int kTK = 128;  // tile cols
+constexpr int kThreads = 256;
+constexpr int kBR = kTR / 16, kBK = kTK / 16;  // 16x16 blocks per tile
+constexpr int kRowU4 = kTK / 8;                 // uint4 (8 bf16) per tile row
+
+struct Piece {
+  int64_t src, rows, cols, slot, o_dr, o_sr, o_dc, o_sc;
+};
+
+__device__ __forceinline__ uint8_t e2m1x2(float lo, float hi) {
+  uint16_t r;
+  asm("{\n .reg .b8 b;\n cvt.rn.satfinite.e2m1x2.f32 b, %1, %2;\n mov.b16 %0, {b, 0};\n}"
+      : "=h"(r) : "f"(hi), "f"(lo));
+  return static_cast<uint8_t>(r & 0xff);
+}
+
+__global__ void __launch_bounds__(kThreads)
+    shard_cast_kernel(const Piece* __restrict__ table, const int32_t* __restrict__ tiles,
+                      const __nv_bfloat16* __restrict__ src, const float* __restrict__ amax_buf,
+                      uint8_t* __restrict__ data_r, uint8_t* __restrict__ scale_r,
+                      uint8_t* __restrict__ data_c, uint8_t* __restrict__ scale_c) {
+  __shared__ __align__(16) __nv_bfloat16 tile[kTR][kTK + 8];  // +8: column reads conflict-free
+  __shared__ unsigned blk_max[kBR][kBK];
+  __shared__ float blk_inv[kBR][kBK];
+  __shared__ uint8_t blk_sf[kBR][kBK];
+  // Column-wise data of the tile; 72-byte rows keep the column-pair writes at 4-way conflicts.
+  __shared__ __align__(16) uint8_t col_out[kTK][kTR / 2 + 8];
+
+  const int32_t* tl = tiles + 3 * blockIdx.x;
+  const Piece p = table[tl[0]];
+  const int R = static_cast<int>(p.rows), K = static_cast<int>(p.cols);
+  const int row0 = tl[1] * kTR, col0 = tl[2] * kTK;
+  const int nr = min(kTR, R - row0), nk = min(kTK, K - col0);  // multiples of 16 / 64
+
+  if (threadIdx.x < kBR * kBK) (&blk_max[0][0])[threadIdx.x] = 0u;
+  __syncthreads();
+
+  const __nv_bfloat16* s = src + p.src + static_cast<int64_t>(row0) * K + col0;
+  constexpr int kLoads = kTR * kRowU4 / kThreads;
+  uint4 v[kLoads];
+#pragma unroll
+  for (int i = 0; i < kLoads; ++i) {
+    const int k = threadIdx.x + i * kThreads, r = k / kRowU4, cu = k % kRowU4;
+    v[i] = make_uint4(0, 0, 0, 0);
+    if (r < nr && cu * 8 < nk) v[i] = __ldg(reinterpret_cast<const uint4*>(s + static_cast<int64_t>(r) * K) + cu);
+  }
+  // A warp holds rows (2 per load) x 16 uint4; lanes l, l^1 share a 16-column block and lanes
+  // l, l^16 the two rows, so two shuffles leave one partial max per (load, block column).
+  const int lane = threadIdx.x & 31;
+#pragma unroll
+  for (int i = 0; i < kLoads; ++i) {
+    const int k = threadIdx.x + i * kThreads, r = k / kRowU4, cu = k % kRowU4;
+    *reinterpret_cast<uint4*>(&tile[r][cu * 8]) = v[i];
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&v[i]);
+    float m = 0.f;
+#pragma unroll
+    for (int e = 0; e < 4; ++e) {
+      m = fmaxf(m, fabsf(__bfloat162float(h[e].x)));
+      m = fmaxf(m, fabsf(__bfloat162float(h[e].y)));
+    }
+    m = fmaxf(m, __shfl_xor_sync(0xffffffff, m, 1));
+    m = fmaxf(m, __shfl_xor_sync(0xffffffff, m, 16));
+    if ((lane & 17) == 0) atomicMax(&blk_max[r / 16][cu / 2], __float_as_uint(m));
+  }
+
+  const float amax = amax_buf[p.slot];
+  float s_enc = fminf(__fdiv_rn(2688.0f, amax), FLT_MAX);
+  if (amax == 0.0f || s_enc == 0.0f) s_enc = 1.0f;
+  const float s_dec = __fdiv_rn(1.0f, s_enc);
+  __syncthreads();
+
+  if (threadIdx.x < kBR * kBK) {
+    const int br = threadIdx.x / kBK, bk = threadIdx.x % kBK;
+    const float blk = __uint_as_float(blk_max[br][bk]);
+    const float t = s_enc * 0.16666667f;
+    const __nv_fp8_storage_t sf =
+        __nv_cvt_float_to_fp8(fminf(blk * t, FLT_MAX), __NV_SATFINITE, __NV_E4M3);
+    __half_raw hr = __nv_cvt_fp8_to_halfraw(sf, __NV_E4M3);
+    const float sf_f = __half2float(__half(hr));
+    blk_sf[br][bk] = sf;
+    blk_inv[br][bk] = fminf(__fdiv_rn(1.0f, sf_f * s_dec), FLT_MAX);
+  }
+  __syncthreads();
+
+  // Row-wise data: thread -> (row, 32 columns) -> 16 bytes.
+#pragma unroll
+  for (int i = 0; i < kTR * (kTK / 32) / kThreads; ++i) {
+    const int k = threadIdx.x + i * kThreads, r = k / (kTK / 32), seg = k % (kTK / 32);
+    if (r >= nr || seg * 32 >= nk) continue;
+    uint8_t out[16];
+#pragma unroll
+    for (int b = 0; b < 2; ++b) {
+      const float inv = blk_inv[r / 16][seg * 2 + b];
+#pragma unroll
+      for (int u = 0; u < 2; ++u) {
+        const uint4 x = *reinterpret_cast<const uint4*>(&tile[r][seg * 32 + b * 16 + u * 8]);
+        const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&x);
+#pragma unroll
+        for (int e = 0; e < 4; ++e) {
+          out[b * 8 + u * 4 + e] = e2m1x2(__bfloat162float(h[e].x) * inv, __bfloat162float(h[e].y) * inv);
+        }
+      }
+    }
+    uint8_t* dst = data_r + p.o_dr + static_cast<int64_t>(row0 + r) * (K / 2) + (col0 + seg * 32) / 2;
+    *reinterpret_cast<uint4*>(dst) = *reinterpret_cast<const uint4*>(out);
+  }
+
+  // Row-wise scales: thread -> row, kBK blocks (4-byte stores; K / 16 is a multiple of 4).
+  if (threadIdx.x < nr) {
+    const int r = threadIdx.x;
+    uint8_t* dst = scale_r + p.o_sr + static_cast<int64_t>(row0 + r) * (K / 16) + col0 / 16;
+    for (int q = 0; q < nk / 64; ++q) {
+      uint32_t w = 0;
+#pragma unroll
+      for (int e = 0; e < 4; ++e) w |= static_cast<uint32_t>(blk_sf[r / 16][q * 4 + e]) << (8 * e);
+      reinterpret_cast<uint32_t*>(dst)[q] = w;
+    }
+  }
+
+  // Column-wise data: thread -> (column pair, 32 rows) -> 16 bytes per column as two 8-byte
+  // stores; lanes take consecutive column pairs, so each bf16x2 shared load is conflict-free.
+  {
+    const int cp = threadIdx.x % (kTK / 2), quarter = threadIdx.x / (kTK / 2);
+    const int c = 2 * cp;
+    if (c < nk) {
+      uint8_t* dst0 = &col_out[c][quarter * 16];
+      uint8_t* dst1 = &col_out[c + 1][quarter * 16];
+#pragma unroll
+      for (int q = 0; q < 2; ++q) {
+        const int rb = quarter * 2 + q;  // 16-row block
+        if (rb * 16 >= nr) break;
+        const float inv = blk_inv[rb][c / 16];
+        uint8_t o0[8], o1[8];
+#pragma unroll
+        for (int e = 0; e < 8; ++e) {
+          const int r = rb * 16 + 2 * e;
+          const __nv_bfloat162 a = *reinterpret_cast<const __nv_bfloat162*>(&tile[r][c]);
+          const __nv_bfloat162 b = *reinterpret_cast<const __nv_bfloat162*>(&tile[r + 1][c]);
+          o0[e] = e2m1x2(__bfloat162float(a.x) * inv, __bfloat162float(b.x) * inv);
+          o1[e] = e2m1x2(__bfloat162float(a.y) * inv, __bfloat162float(b.y) * inv);
+        }
+        reinterpret_cast<uint2*>(dst0)[q] = *reinterpret_cast<const uint2*>(o0);
+        reinterpret_cast<uint2*>(dst1)[q] = *reinterpret_cast<const uint2*>(o1);
+      }
+    }
+  }
+
+  __syncthreads();
+  // Column data out of shared memory: 4 lanes per column write its nr / 2 contiguous bytes
+  // (16 bytes each), so a warp store covers whole 32-byte sectors of 8 columns.
+  {
+    const int part = threadIdx.x & 3;
+    const int nbytes = nr / 2;  // multiple of 8
+    for (int c = threadIdx.x >> 2; c < nk; c += kThreads / 4) {
+      uint8_t* dst = data_c + p.o_dc + static_cast<int64_t>(col0 + c) * (R / 2) + row0 / 2;
+      const int off = part * 16;
+      if (off + 16 <= nbytes && ((reinterpret_cast<uintptr_t>(dst) & 15) == 0)) {
+        const uint2 a = *reinterpret_cast<const uint2*>(&col_out[c][off]);
+        const uint2 b = *reinterpret_cast<const uint2*>(&col_out[c][off + 8]);
+        *reinterpret_cast<uint4*>(dst + off) = make_uint4(a.x, a.y, b.x, b.y);
+      } else {
+        for (int o = off; o < min(off + 16, nbytes); o += 8) {
+          *reinterpret_cast<uint2*>(dst + o) = *reinterpret_cast<const uint2*>(&col_out[c][o]);
+        }
+      }
+    }
+  }
+
+  // Column-wise scales: thread -> column, nr / 16 bytes (one 8-byte store when aligned).
+  if (threadIdx.x < nk) {
+    const int c = threadIdx.x;
+    uint8_t* dst = scale_c + p.o_sc + static_cast<int64_t>(col0 + c) * (R / 16) + row0 / 16;
+    const int nb = nr / 16;
+    if (nb == kBR && (reinterpret_cast<uintptr_t>(dst) & 7) == 0) {
+      uint8_t v[kBR];
+#pragma unroll
+      for (int rb = 0; rb < kBR; ++rb) v[rb] = blk_sf[rb][c / 16];
+      *reinterpret_cast<uint2*>(dst) = *reinterpret_cast<const uint2*>(v);
+    } else {
+      for (int rb = 0; rb < nb; ++rb) dst[rb] = blk_sf[rb][c / 16];
+    }
+  }
+}
+
+}  // namespace
+
+void shard_cast(torch::Tensor table, torch::Tensor tiles, torch::Tensor src, torch::Tensor amax,
+                torch::Tensor data_r, torch::Tensor scale_r, torch::Tensor data_c,
+                torch::Tensor scale_c) {
+  TORCH_CHECK(table.scalar_type() == torch::kInt64 && table.size(1) == 8);
+  TORCH_CHECK(tiles.scalar_type() == torch::kInt32 && tiles.size(1) == 3);
+  TORCH_CHECK(src.scalar_type() == torch::kBFloat16 && amax.scalar_type() == torch::kFloat32);
+  const int n = tiles.size(0);
+  if (n == 0) return;
+  shard_cast_kernel<<<n, kThreads, 0, c10::cuda::getCurrentCUDAStream()>>>(
+      reinterpret_cast<const Piece*>(table.data_ptr<int64_t>()), tiles.data_ptr<int32_t>(),
+      reinterpret_cast<const __nv_bfloat16*>(src.data_ptr()), amax.data_ptr<float>(),
+      data_r.data_ptr<uint8_t>(), scale_r.data_ptr<uint8_t>(), data_c.data_ptr<uint8_t>(),
