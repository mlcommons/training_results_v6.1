+# Classification: Internal
+"""One pass over a grouped BF16 gradient for everything the NVFP4 MoE backward reads from it.
+
+Per group g (rows offsets[g]:offsets[g+1]) of dy (rows x hidden):
+    amax_row[g] = max |dy|                               (row-wise NVFP4 amax, no RHT)
+    amax_col[g] = max |bf16(R' dy_b)| over 16-row blocks b (post-RHT column-wise amax)
+    dbias[g, :] = sum_i dy[i, :] * s_i                    (s_i = scales[i], or 1)
+    dscales[i]  = sum_j dy[i, j] * bias[g, j]             (only with scales)
+
+TE computes these with GraphSafeGroupHadamardAmax plus a separate grouped dbias kernel,
+each re-reading dy from HBM. The amaxes feed tex.nvfp4_group_quantize_with_amax and match
+TE's bitwise (TE takes the column amax of the bf16-rounded RHT output).
+Group starts must be multiples of 16 (true for the 128-padded MoE layout).
+"""
+import os
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _block_diag(rht_ptr, BM: tl.constexpr):
+    """[BM, BM] bf16 block-diagonal matrix with the 16x16 RHT operand on the diagonal."""
+    i = tl.arange(0, BM)
+    m = tl.load(rht_ptr + (i[:, None] % 16) * 16 + (i[None, :] % 16))
+    return tl.where((i[:, None] // 16) == (i[None, :] // 16), m, 0.0).to(tl.bfloat16)
+
+
+@triton.jit
+def _dy_stats_kernel(
+    dy_ptr,
+    offsets_ptr,
+    rht_ptr,
+    amax_row_ptr,
+    amax_col_ptr,
+    dbias_ptr,
+    scales_ptr,
+    bias_ptr,
+    dscales_ptr,
+    hidden,
+    HAS_DBIAS: tl.constexpr,
+    HAS_SCALES: tl.constexpr,
+    HAS_COL: tl.constexpr,
+    TRANS_DOT: tl.constexpr,
+    MMA_RED: tl.constexpr,
+    N_ROW_SPLITS: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_H: tl.constexpr,
+):
+    g = tl.program_id(0)
+    split = tl.program_id(1)
+    cb = tl.program_id(2)
+
+    row_start = tl.load(offsets_ptr + g)
+    row_end = tl.load(offsets_ptr + g + 1)
+    tiles = (row_end - row_start + BLOCK_M - 1) // BLOCK_M
+    per_split = (tiles + N_ROW_SPLITS - 1) // N_ROW_SPLITS
+    first = split * per_split
+    last = tl.minimum(first + per_split, tiles)
+
+    cols = cb * BLOCK_H + tl.arange(0, BLOCK_H)
+    col_mask = cols < hidden
+    rows = tl.arange(0, BLOCK_M)
+    bdiag = _block_diag(rht_ptr, BLOCK_M)
+
+    if HAS_SCALES:
+        if MMA_RED:
+            # [BLOCK_H, 16] with the (bf16) bias in column 0: dscales = row sums of x @ bmat
+            k16 = tl.arange(0, 16)
+            bmat = tl.load(bias_ptr + g * hidden + cols[:, None] + k16[None, :] * 0,
+                           mask=col_mask[:, None] & (k16[None, :] == 0), other=0.0)
+        else:
+            bias_vals = tl.load(bias_ptr + g * hidden + cols, mask=col_mask,
+                                other=0.0).to(tl.float32)
+    if MMA_RED:
+        # [BLOCK_M, 2 BLOCK_M]: bdiag^T in the first BLOCK_M columns, ones in column BLOCK_M
+        jj = tl.arange(0, 2 * BLOCK_M)[None, :]
+        kk = rows[:, None]
+        m = tl.load(rht_ptr + (jj % 16) * 16 + (kk % 16))
+        ext = tl.where((jj < BLOCK_M) & (kk // 16 == jj // 16), m,
+                       tl.where(jj == BLOCK_M, 1.0, 0.0)).to(tl.bfloat16)
+
+    amax_r = tl.zeros([BLOCK_H], dtype=tl.float32)
+    amax_c = tl.zeros([BLOCK_H], dtype=tl.float32)
+    dbias_acc = tl.zeros([BLOCK_H], dtype=tl.float32)
+    for t in range(first, last):
+        grow = row_start + t * BLOCK_M + rows
+        row_mask = grow < row_end
+        x = tl.load(
+            dy_ptr + grow[:, None].to(tl.int64) * hidden + cols[None, :],
+            mask=row_mask[:, None] & col_mask[None, :],
+            other=0.0,
+        )
+        xf = x.to(tl.float32)
+        amax_r = tl.maximum(amax_r, tl.max(tl.abs(xf), axis=0))
+        if MMA_RED:
+            yt2 = tl.dot(tl.trans(x), ext)  # [BLOCK_H, 2 BLOCK_M] fp32
+            yb = yt2.to(tl.bfloat16).to(tl.float32)
+            amax_c = tl.maximum(amax_c, tl.max(tl.where(jj < BLOCK_M, tl.abs(yb), 0.0), axis=1))
+        elif HAS_COL:
+            if TRANS_DOT:
+                # y^T = x^T @ bdiag^T keeps the wide hidden dim on the MMA M side
+                yt = tl.dot(tl.trans(x), tl.trans(bdiag)).to(tl.bfloat16).to(tl.float32)
+                amax_c = tl.maximum(amax_c, tl.max(tl.abs(yt), axis=1))
+            else:
+                y = tl.dot(bdiag, x).to(tl.bfloat16).to(tl.float32)
+                amax_c = tl.maximum(amax_c, tl.max(tl.abs(y), axis=0))
+
+        if HAS_DBIAS:
+            if HAS_SCALES:
+                s = tl.load(scales_ptr + grow, mask=row_mask, other=0.0)
+                dbias_acc += tl.sum(xf * s[:, None], axis=0)
+                if MMA_RED:
+                    ds = tl.sum(tl.dot(x, bmat), axis=1)
+                else:
+                    ds = tl.sum(xf * bias_vals[None, :], axis=1)
+                tl.atomic_add(dscales_ptr + grow, ds, mask=row_mask)
+            elif MMA_RED:
+                dbias_acc += tl.sum(tl.where(jj == BLOCK_M, yt2, 0.0), axis=1)
+            else:
+                dbias_acc += tl.sum(xf, axis=0)
+
+    if last > first:
+        tl.atomic_max(amax_row_ptr + g, tl.max(amax_r, axis=0))
+        tl.atomic_max(amax_col_ptr + g, tl.max(amax_c, axis=0))
+        if HAS_DBIAS:
+            tl.atomic_add(dbias_ptr + g * hidden + cols, dbias_acc, mask=col_mask)
+
+
+_RHT_T = os.environ.get("NVFP4_DYSTATS_RHT_T", "1") == "1"
+_rht_cache = {}
+
+
+def rht_operand(rht_matrix):
+    """The 16x16 left operand R' with column-wise RHT block = R' @ dy_block."""
+    key = (rht_matrix.data_ptr(), rht_matrix.device)
+    op = _rht_cache.get(key)
+    if op is None:
+        op = (rht_matrix.t() if _RHT_T else rht_matrix).contiguous()
+        _rht_cache[key] = op
+    return op
+
+
+def _cfg(hidden):
+    block_m = int(os.environ.get("NVFP4_DYSTATS_BLOCK_M", "64"))
+    block_h = int(os.environ.get("NVFP4_DYSTATS_BLOCK_H", "128"))
+    splits = int(os.environ.get("NVFP4_DYSTATS_SPLITS", "16"))
+    warps = int(os.environ.get("NVFP4_DYSTATS_WARPS", "4"))
+    stages = int(os.environ.get("NVFP4_DYSTATS_STAGES", "3"))
+    return block_m, block_h, splits, warps, stages
+
+
+_TRANS_DOT = os.environ.get("NVFP4_DYSTATS_TRANS", "1") == "1"
+_MMA_RED = os.environ.get("NVFP4_DYSTATS_MMA_RED", "0") == "1"
+
+
+def dy_stats(dy, offsets, rht_matrix, num_groups, *, dbias=True, scales=None, bias=None, cfg=None,
