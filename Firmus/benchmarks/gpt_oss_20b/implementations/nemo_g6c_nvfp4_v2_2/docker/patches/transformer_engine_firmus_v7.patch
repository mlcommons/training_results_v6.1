+    dscales = torch.zeros(rows, dtype=torch.float32, device=dev) if has_scales else None
+    block_m, block_h, splits, warps, stages = cfg or _cfg(hidden)
+    grid = (num_groups, splits, triton.cdiv(hidden, block_h))
+    _dy_stats_kernel[grid](
+        dy,
+        offsets,
+        rht_matrix,
+        amax[0],
+        amax[1],
+        dbias_out if dbias else amax,
+        scales if has_scales else amax,
+        bias if has_scales else amax,
+        dscales if has_scales else amax,
+        hidden,
+        HAS_DBIAS=dbias,
+        HAS_SCALES=has_scales,
+        HAS_COL=col,
+        TRANS_DOT=_TRANS_DOT if trans is None else trans,
+        MMA_RED=(_MMA_RED if mma_red is None else mma_red) and col,
+        N_ROW_SPLITS=splits,
+        BLOCK_M=block_m,
+        BLOCK_H=block_h,
+        num_warps=warps,
+        num_stages=stages,
+    )
+    return amax[0], amax[1], dbias_out, dscales
