+    def all_gather(out, inp, group=None, async_op=False):
+        stats["ag_calls"] = stats.get("ag_calls", 0) + 1
+        fb = _buckets.get(out.data_ptr())
+        if fb is None:
+            return orig_ag(out, inp, group=group, async_op=async_op)
+        if not fb.prepared:
