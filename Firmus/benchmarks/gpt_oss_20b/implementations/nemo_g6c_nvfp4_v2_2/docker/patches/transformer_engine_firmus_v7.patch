+# Classification: Internal
+"""Grouped NVFP4 dy amaxes (bitwise equal to TE's RHT amax kernel) plus per-group dbias (and,
+for FC2, scaled dbias + dscales) in one read of dy.
+
+The extension is built once with `build(dir)`; training ranks load the built .so from
+NVFP4_AMAX_DBIAS_EXT.
+"""
+import importlib.util
+import os
+
+import torch
+
+EXT_NAME = "nvfp4_amax_dbias_ext"
+_ext = None
+
+
+def build(build_dir, name=EXT_NAME, arch="10.3", verbose=True):
+    from torch.utils.cpp_extension import load
+
+    os.environ["TORCH_CUDA_ARCH_LIST"] = arch  # max.xorsign.abs needs sm_86+
+    src = os.path.join(os.path.dirname(os.path.abspath(__file__)), "amax_dbias_ext.cu")
+    os.makedirs(build_dir, exist_ok=True)
+    return load(name=name, sources=[src], build_directory=build_dir,
+                extra_cuda_cflags=["-O3"], verbose=verbose)
+
+
+def _get_ext():
+    global _ext
+    if _ext is None:
+        path = os.environ["NVFP4_AMAX_DBIAS_EXT"]
+        spec = importlib.util.spec_from_file_location(os.path.basename(path).split(".")[0], path)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        _ext = mod
+    return _ext
+
+
+def set_ext(mod):
+    global _ext
+    _ext = mod
+
+
+def supported(dy, scales=None, bias=None):
+    if dy.shape[0] % 64 or dy.shape[1] % 64 or (scales is None) != (bias is None):
+        return False
+    if scales is None:
+        return True
+    return (os.environ.get("NVFP4_DY_STATS_CUDA_FC2", "0") == "1"
+            and scales.dtype == torch.float32 and scales.is_contiguous()
+            and bias.dtype == torch.bfloat16 and bias.is_contiguous())
+
+
+_COLS = int(os.environ.get("NVFP4_AMAX_DBIAS_COLS", "1024"))
+_COLS_SCALED = int(os.environ.get("NVFP4_AMAX_DBIAS_COLS_SCALED", "256"))
+
+
+def dy_stats(dy, offsets, mask_t, num_groups, *, dbias=True, scales=None, bias=None,
+             cols_per_cta=None):
+    """Returns (amax_row[G], amax_col[G], dbias[G, H] fp32 or None, dscales[M] fp32 or None)."""
+    rows, hidden = dy.shape
+    scaled = scales is not None
+    if cols_per_cta is None:
+        cols_per_cta = _COLS_SCALED if scaled else _COLS
+    cols_per_cta = min(cols_per_cta, -(-hidden // 64) * 64)
+    amax = torch.zeros(2, num_groups, device=dy.device, dtype=torch.float32)
+    db = (torch.zeros(num_groups, hidden, device=dy.device, dtype=torch.float32)
+          if dbias or scaled else None)
+    ds = torch.zeros(rows, device=dy.device, dtype=torch.float32) if scaled else None
+    if scaled:
+        _get_ext().amax_dbias(dy, offsets, int(mask_t), amax[0], amax[1], db, scales, bias, ds,
+                              cols_per_cta)
+    else:
+        _get_ext().amax_dbias(dy, offsets, int(mask_t), amax[0], amax[1], db, None, None, None,
+                              cols_per_cta)
+    return amax[0], amax[1], db, ds
