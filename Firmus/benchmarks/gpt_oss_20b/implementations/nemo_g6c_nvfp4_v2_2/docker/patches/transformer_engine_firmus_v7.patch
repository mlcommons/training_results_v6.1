+# Classification: Internal
+"""NVFP4 param all-gather for the 2D-quantized expert weights (NVFP4_FP4_AG=1).
+
+Every rank used to all-gather the BF16 expert weights and cast all of them to NVFP4.
+Here each rank casts only the weights in its own distributed-optimizer shard and the
+ranks all-gather the NVFP4 row-wise and column-wise data and scales instead.
+
+Layout: tagged expert weights get their own DDP buckets (``layout``) in which every
+weight size is a multiple of ``unit`` = lcm(16 * cols) and buckets are padded to
+``dp * unit``, so every shard boundary inside a weight falls on a 16-row boundary. A
+16-row slice cast with the full-tensor amax reproduces the full 2D cast bit for bit
+(rows, scales and the slice's columns), so each rank's piece is exact.
+
+Per FP4 bucket of ``n`` elements there are four gather buffers proportional to the
+element order: row data (n/2 B), row scales (n/16 B), column data (n/2 B), column
+scales (n/16 B). A weight that lies in one shard has its final [cols, rows/2] column
+layout in place; a weight cut by a shard boundary has one [cols, (r1-r0)/2] piece per
+rank and is reassembled after the gather. Scale tensors that TE pads (rows to 128,
+tiles to 4) are copied into persistent padded buffers.
+
+The BF16 copies of these weights outside the local shard go stale once a bucket has
+been gathered in FP4, so from then on the weights must only be read through
+``lookup``. The first gathers (before any amax slot exists) stay in BF16. The first
+``lookup`` of a bucket (eager, e.g. CUDA graph warmup) fills the buffers from the
+replicated BF16 weights; the TE tensors it returns are persistent, so graphs captured
+afterwards read every later gather, and the per-weight fixup copies are captured with them.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+
+import torch
+
+ENABLED = os.environ.get("NVFP4_FP4_AG", "0") == "1"
+DEBUG_CHECK = int(os.environ.get("NVFP4_FP4_AG_CHECK", "0"))
+USE_KERNEL = os.environ.get("NVFP4_FP4_AG_KERNEL", "1") == "1"
+SHARD_CAST_CUDA = os.environ.get("NVFP4_SHARD_CAST_IMPL", "triton") == "cuda"
+_TAG = "_nvfp4_fp4_ag"
+
+_buckets = {}  # param_data.data_ptr() -> _Bucket
+_by_param = {}  # param -> (_Bucket, item index)
+_bucket_groups = []
+_copiers = {}  # tuple of weight ids -> BatchCopy2D (or False) for one lookup call
+_state = {"folding": False, "installed": False}
+stats = {"fp4_ag": 0, "bf16_ag": 0, "fixup": 0, "refresh": 0, "lookup": 0, "check_bad": 0}
+
+
+def _round(x, m):
+    return (x + m - 1) // m * m
+
+
+# ---------------------------------------------------------------------------- tagging
+
+
+def tag_module(module, num_layers, num_tail_layers, num_head_layers=0):
+    """Mark the 2D expert weights of every layer outside the BF16/MXFP8 head and tail."""
+    from megatron.core.transformer.transformer_layer import TransformerLayer
+
+    n = 0
+    for layer in module.modules():
+        if not isinstance(layer, TransformerLayer):
+            continue
+        if layer.layer_number > num_layers - num_tail_layers or layer.layer_number <= num_head_layers:
+            continue
+        experts = getattr(getattr(layer, "mlp", None), "experts", None)
+        if experts is None:
+            continue
+        owners = []
+        for mod in experts.modules():
+            hit = False
+            for name, p in mod._parameters.items():
+                if (p is not None and p.dim() == 2 and p.dtype == torch.bfloat16
+                        and name.startswith("weight") and name[6:].isdigit()):
+                    setattr(p, _TAG, True)
+                    hit = True
+                    n += 1
+            if hit:
+                owners.append(mod)
+        # The param buffer walks params in reverse registration order and needs each
+        # bucket to be one contiguous run, so keep the tagged weights adjacent.
+        for i, mod in enumerate(owners):
+            items = list(mod._parameters.items())
+            tagged = [kv for kv in items if kv[1] is not None and is_tagged(kv[1])]
+            other = [kv for kv in items if not (kv[1] is not None and is_tagged(kv[1]))]
+            mod._parameters.clear()
+            mod._parameters.update(other + tagged if i == 0 else tagged + other)
+    return n
+
+
+def is_tagged(p):
+    return getattr(p, _TAG, False)
+
+
+# ---------------------------------------------------------------------------- layout
+
+
+def make_layout(orig):
+    """Wrap DistributedOptimizer._compute_per_buffer_param_layout (see module docstring)."""
+    from megatron.core.optimizer.param_layout import (
+        PerBufferParamLayout,
+        bucket_end_divisor,
+        pad_bucket_end,
+        pad_param_start,
+        pad_to_divisor,
+    )
+
+    def layout(params, bucket_size, data_parallel_world_size, ddp_config, param_indices=None):
+        tagged = [p for p in params if is_tagged(p)]
+        if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
+            print(
+                f"NVFP4_FP4_AG layout call: {len(params)} params, {len(tagged)} tagged, "
+                f"bucket_size {bucket_size}, dp {data_parallel_world_size}",
+                flush=True,
+            )
+        if not tagged or bucket_size is None:
+            return orig(params, bucket_size, data_parallel_world_size, ddp_config, param_indices)
+        unit = math.lcm(*{16 * p.shape[1] for p in tagged})
+        for p in tagged:
+            if p.numel() % unit or p.shape[0] % 16:
+                setattr(p, _TAG, False)
+        dp = data_parallel_world_size
+        fp4_div = math.lcm(dp * unit, bucket_end_divisor(dp, ddp_config.pad_buckets_for_high_nccl_busbw))
+
+        index_map, bucket_indices, unpadded = {}, [], []
+        cursor = [0]
+
+        def emit(plist, fp4):
+            if not plist:
+                return
+            start = cursor[0]
+            pos = start
+            for p in plist:
+                if not fp4:
+                    pos = pad_param_start(pos)
+                index_map[p] = (pos, pos + p.numel(), len(bucket_indices))
+                pos += p.numel()
+            unpadded.append(pos - start)
+            if fp4:
+                end = start + pad_to_divisor(pos - start, fp4_div)
+            else:
+                end = pad_bucket_end(pos, dp, ddp_config.pad_buckets_for_high_nccl_busbw)
+            bucket_indices.append((start, end))
+            cursor[0] = end
+            plist.clear()
+
+        # Buckets must be contiguous runs of params[::-1]: cut at every tagged/untagged switch.
+        # A layer's expert weights stay in one FP4 bucket rather than leaving a small remainder.
+        run, run_fp4, run_n = [], False, 0
+        for p in params[::-1]:
+            shared = getattr(p, "shared_embedding", False)
+            t = is_tagged(p)
+            if run and (t != run_fp4 or shared):
+                emit(run, run_fp4)
+                run_n = 0
+            run_fp4 = t
+            run.append(p)
+            run_n += p.numel()
+            if (not t and run_n >= bucket_size) or shared:
+                emit(run, run_fp4)
+                run_n = 0
+        emit(run, run_fp4)
+
+        index_map = {p: index_map[p] for p in params[::-1]}
+        if torch.distributed.is_initialized() and torch.distributed.get_rank() == 0:
+            nfp4 = sum(1 for p in params if is_tagged(p))
+            print(
+                f"NVFP4_FP4_AG layout: {len(bucket_indices)} buckets, {nfp4} FP4 weights, unit {unit}, "
+                f"numel {cursor[0]} (orig unpadded {sum(p.numel() for p in params)})",
+                flush=True,
+            )
+        return PerBufferParamLayout(
+            param_index_map=index_map,
+            bucket_indices=bucket_indices,
+            per_bucket_numel_unpadded=unpadded,
+            param_indices=param_indices if param_indices is not None else [],
+            num_optimizer_shards=dp,
+        )
+
+    return staticmethod(layout)
+
+
+# ---------------------------------------------------------------------------- buckets
+
+
+class _Item:
+    __slots__ = ("param", "off", "rows", "cols", "pieces", "local", "tensor", "row_scale_pad",
+                 "col_data_full", "col_scale_pad")
+
+    def __init__(self, param, off):
+        self.param = param
+        self.off = off
+        self.rows, self.cols = param.shape
+        self.pieces = []  # (r0, r1) per shard that holds rows of this weight
+        self.local = None  # (r0, r1) held by this rank
+        self.tensor = None
+
+
+class _Bucket:
+    def __init__(self, bucket, group):
+        pd = bucket.param_data
+        self.param_data = pd
+        self.n = pd.numel()
+        self.size = group.intra_distributed_optimizer_instance_size
+        self.rank = group.intra_distributed_optimizer_instance_rank
+        self.group = group
+        assert self.n % (32 * self.size) == 0, self.n
+        dev = pd.device
+        self.data_r = torch.zeros(self.n // 2, dtype=torch.uint8, device=dev)
+        self.scale_r = torch.zeros(self.n // 16, dtype=torch.uint8, device=dev)
+        self.data_c = torch.zeros(self.n // 2, dtype=torch.uint8, device=dev)
+        self.scale_c = torch.zeros(self.n // 16, dtype=torch.uint8, device=dev)
+        shard = self.n // self.size
+        self.items = []
+        for p in bucket.params_list:
+            off = (p.data_ptr() - pd.data_ptr()) // pd.element_size()
+            it = _Item(p, off)
+            for r in range(self.size):
+                lo, hi = max(off, r * shard), min(off + p.numel(), (r + 1) * shard)
+                if hi <= lo:
+                    continue
+                assert (lo - off) % (16 * it.cols) == 0 and (hi - off) % (16 * it.cols) == 0, (
+                    "FP4 bucket shard boundary not on a 16-row boundary"
+                )
+                piece = ((lo - off) // it.cols, (hi - off) // it.cols)
+                it.pieces.append(piece)
+                if r == self.rank:
+                    it.local = piece
+            self.items.append(it)
+            _by_param[p] = (self, len(self.items) - 1)
+        lo, hi = self.rank * shard, (self.rank + 1) * shard
+        self.shards = (
+            self.data_r[lo // 2 : hi // 2],
+            self.scale_r[lo // 16 : hi // 16],
+            self.data_c[lo // 2 : hi // 2],
+            self.scale_c[lo // 16 : hi // 16],
+        )
+        self.prepared = False  # local pieces cast for the next gather
+        self.valid = False  # an FP4 gather has been issued (BF16 copies are stale)
+        self.armed = False  # buffers hold the current weights; every later gather is FP4
+        self.quantizer = None
+        self.kernel = None
+
+    def ready(self, shard_amax):
+        return all(shard_amax.slot_for(it.param) is not None for it in self.items)
+
+    def _store(self, it, t, r0, r1, base):
+        """Copy rows [r0, r1) of ``t`` (a cast of the weight rows from ``base``) into the buffers."""
+        cols = it.cols
+        e0, e1 = it.off + r0 * cols, it.off + r1 * cols
+        a, b = r0 - base, r1 - base
+        k = cols // 16
+        self.data_r[e0 // 2 : e1 // 2].view(r1 - r0, cols // 2).copy_(t._rowwise_data[a:b])
+        self.scale_r[e0 // 16 : e1 // 16].view(r1 - r0, k).copy_(
+            t._rowwise_scale_inv.view(torch.uint8)[a:b, :k]
+        )
+        self.data_c[e0 // 2 : e1 // 2].view(cols, (r1 - r0) // 2).copy_(
+            t._columnwise_data[:, a // 2 : b // 2]
+        )
+        self.scale_c[e0 // 16 : e1 // 16].view(cols, (r1 - r0) // 16).copy_(
+            t._columnwise_scale_inv.view(torch.uint8)[:cols, a // 16 : b // 16]
+        )
+
+    def cast_local(self, shard_amax):
+        if USE_KERNEL:
+            if self.kernel is None:
+                from transformer_engine.pytorch.ops.fused import grouped_mlp as _gm
+
+                pieces = []
+                for it in self.items:
+                    if it.local is None:
+                        continue
+                    r0, r1 = it.local
+                    e0 = it.off + r0 * it.cols
+                    pieces.append((e0, r1 - r0, it.cols, shard_amax._slots[it.param],
+                                   e0 // 2, e0 // 16, e0 // 2, e0 // 16))
+                if not pieces:
+                    self.kernel = False
+                elif SHARD_CAST_CUDA and _gm._v7_module("nvfp4_shard_cast_cuda").supported(pieces):
+                    self.kernel = _gm._v7_module("nvfp4_shard_cast_cuda").ShardCastCUDA(pieces, self.data_r.device)
+                else:
+                    self.kernel = _gm._v7_module("nvfp4_shard_cast").ShardCast(pieces, self.data_r.device)
+                if pieces and not stats.get("cast_impl") and torch.distributed.get_rank() == 0:
+                    stats["cast_impl"] = type(self.kernel).__name__
+                    print(f"NVFP4_FP4_AG shard cast: {stats['cast_impl']}", flush=True)
+            if self.kernel:
+                self.kernel(self.param_data, shard_amax._amax_buf, self.data_r, self.scale_r, self.data_c, self.scale_c)
+            return
+        import transformer_engine_torch as tex
+
+        q = self.quantizer
+        for it in self.items:
+            if it.local is None:
+                continue
+            r0, r1 = it.local
+            amax = shard_amax.slot_for(it.param)
+            w = it.param.detach().view(it.rows, it.cols)[r0:r1]
+            self._store(it, tex.nvfp4_quantize_with_amax(w, q, amax, amax), r0, r1, r0)
+
+    def arm(self, shard_amax):
+        """Fill every rank's region from the (still replicated) BF16 weights, eager only."""
+        import transformer_engine_torch as tex
+
+        if self.armed:
+            return
+        if self.quantizer is None:
+            self.quantizer = _row_col_quantizer()
+        if not self.valid:
+            for it in self.items:
+                amax = shard_amax.slot_for(it.param)
+                if amax is None:
+                    amax = shard_amax.register(it.param)
+                if amax is None:
+                    raise RuntimeError("NVFP4_FP4_AG: no amax slot for an FP4 weight")
+                t = tex.nvfp4_quantize_with_amax(it.param.detach(), self.quantizer, amax, amax)
+                for r0, r1 in it.pieces:
+                    self._store(it, t, r0, r1, 0)
+        self.armed = True
+
+    # -- TE tensors over the gathered buffers
+
+    def _build_tensor(self, it, template):
+        rows, cols = it.rows, it.cols
+        whole = len(it.pieces) == 1
+        e0, e1 = it.off // 2, (it.off + rows * cols) // 2
+        s0, s1 = it.off // 16, (it.off + rows * cols) // 16
+        t = template
+        dev = self.data_r.device
+        t._rowwise_data = self.data_r[e0:e1].view(rows, cols // 2)
+        rs_shape = (_round(rows, 128), _round(cols // 16, 4))
+        if rs_shape == (rows, cols // 16):
+            it.row_scale_pad = None
+            t._rowwise_scale_inv = self.scale_r[s0:s1].view(rows, cols // 16).view(t._rowwise_scale_inv.dtype)
+        else:
+            it.row_scale_pad = torch.zeros(rs_shape, dtype=torch.uint8, device=dev)
+            t._rowwise_scale_inv = it.row_scale_pad.view(t._rowwise_scale_inv.dtype)
+        if whole:
+            it.col_data_full = None
+            t._columnwise_data = self.data_c[e0:e1].view(cols, rows // 2)
+        else:
+            it.col_data_full = torch.zeros((cols, rows // 2), dtype=torch.uint8, device=dev)
+            t._columnwise_data = it.col_data_full
+        cs_shape = (_round(cols, 128), _round(rows // 16, 4))
+        if whole and cs_shape == (cols, rows // 16):
+            it.col_scale_pad = None
+            t._columnwise_scale_inv = self.scale_c[s0:s1].view(cols, rows // 16).view(
+                t._columnwise_scale_inv.dtype
+            )
+        else:
+            it.col_scale_pad = torch.zeros(cs_shape, dtype=torch.uint8, device=dev)
+            t._columnwise_scale_inv = it.col_scale_pad.view(t._columnwise_scale_inv.dtype)
+        it.tensor = t
+
+    def fixup_entries(self, it):
+        """(src, dst) copies that assemble one weight's padded scales and cut pieces."""
+        rows, cols = it.rows, it.cols
+        s0, s1 = it.off // 16, (it.off + rows * cols) // 16
+        out = []
+        if it.row_scale_pad is not None:
+            out.append((self.scale_r[s0:s1].view(rows, cols // 16), it.row_scale_pad[:rows, : cols // 16]))
+        if len(it.pieces) == 1:
+            if it.col_scale_pad is not None:
+                out.append((self.scale_c[s0:s1].view(cols, rows // 16), it.col_scale_pad[:cols, : rows // 16]))
+            return out
+        for r0, r1 in it.pieces:
+            e0, e1 = it.off + r0 * cols, it.off + r1 * cols
+            out.append((self.data_c[e0 // 2 : e1 // 2].view(cols, (r1 - r0) // 2),
+                        it.col_data_full[:, r0 // 2 : r1 // 2]))
+            out.append((self.scale_c[e0 // 16 : e1 // 16].view(cols, (r1 - r0) // 16),
+                        it.col_scale_pad[:cols, r0 // 16 : r1 // 16]))
+        return out
+
+    def fixup(self, it):
+        """Assemble one weight's padded scales and cut pieces (current stream, graph-safe)."""
+        for src, dst in self.fixup_entries(it):
+            dst.copy_(src)
+
+
+# ---------------------------------------------------------------------------- hooks
+
+
+def _shard_amax():
+    from transformer_engine.pytorch.ops.fused import nvfp4_shard_weight_amax
+
+    return nvfp4_shard_weight_amax
+
+
+def _discover():
+    for group in _bucket_groups:
+        for bucket in group.buckets:
+            key = bucket.param_data.data_ptr() if bucket.param_data is not None else None
+            if key is None or key in _buckets:
+                continue
+            if bucket.params_list and all(is_tagged(p) for p in bucket.params_list):
+                _buckets[key] = _Bucket(bucket, group)
+    _state["discovered"] = len(_bucket_groups)
+
+
+def _group_fp4_buckets(group):
+    if _state.get("discovered") != len(_bucket_groups):
+        _discover()
+    return [_buckets[b.param_data.data_ptr()] for b in group.buckets
+            if b.param_data is not None and b.param_data.data_ptr() in _buckets]
+
+
+def _prepare(group):
+    """Cast this group's local FP4 pieces before its gather is dispatched."""
+    stats["prepare_calls"] = stats.get("prepare_calls", 0) + 1
+    fbs = _group_fp4_buckets(group)
+    if not fbs:
+        return
+    sa = _shard_amax()
+    if not all(fb.ready(sa) for fb in fbs):
+        if any(fb.armed or fb.valid for fb in fbs):
+            raise RuntimeError("NVFP4_FP4_AG: amax slots missing for an armed FP4 bucket")
+        stats["not_ready"] = stats.get("not_ready", 0) + 1
+        if DEBUG_CHECK > 0 and stats["not_ready"] <= 2 and torch.distributed.get_rank() == 0:
+            print(f"NVFP4_FP4_AG not ready: {len(sa._slots)} amax slots, {stats}", flush=True)
+        return
+    if torch.cuda.is_current_stream_capturing():
+        raise RuntimeError("NVFP4_FP4_AG: param gather dispatched under graph capture")
+    if _state["folding"]:
+        # Early phased gathers run before the amax fold is all-reduced.
+        sa.refresh_subset(_bucket_groups, [group])
+        stats["refresh"] += 1
+    for fb in fbs:
+        if fb.quantizer is None:
+            fb.quantizer = _row_col_quantizer()
+        fb.cast_local(sa)
+        fb.prepared = True
+
+
+def _row_col_quantizer():
+    from transformer_engine.pytorch.tensor.nvfp4_tensor import NVFP4Quantizer
+
+    return NVFP4Quantizer(rowwise=True, columnwise=True, with_2d_quantization=True, stochastic_rounding=False)
