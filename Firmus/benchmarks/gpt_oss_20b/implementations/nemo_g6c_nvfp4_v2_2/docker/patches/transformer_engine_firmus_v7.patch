+        shapes = [x.shape for x in tensors]
+        numels = [x.numel() for x in tensors]
+        numels = [sum(numels[:i]) for i in range(4)]
+        q_data, k_data, v_data = [
+            qkv_fp8._data[numels[i] : numels[i + 1]].view(shapes[i]) for i in range(3)
+        ]
+        q_fp8, k_fp8, v_fp8 = [
+            utils.Float8Tensor.make_like(qkv_fp8, data=x, dtype=q.dtype)
+            for x in [q_data, k_data, v_data]
+        ]
+        return q_fp8, k_fp8, v_fp8, qkv_layout, None
+
+    return combine_and_quantize
+
+
+def install():
+    from transformer_engine.pytorch.attention.dot_product_attention import backends
