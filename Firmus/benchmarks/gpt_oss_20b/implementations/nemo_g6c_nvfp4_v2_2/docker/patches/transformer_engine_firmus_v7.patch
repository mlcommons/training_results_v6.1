+    num_layers = int(os.environ.get("OVERWRITTEN_NUM_LAYERS", "24"))
+    num_tail = int(os.environ.get("NUM_LAYERS_AT_END_IN_BF16", "0"))
+    num_head = int(os.environ.get("NUM_LAYERS_AT_START_IN_BF16", "0"))
+    if os.environ.get("NVTE_NVFP4_4OVER6", "none") != "none":
+        raise RuntimeError("NVFP4_FP4_AG: the shard cast kernel does not implement 4over6")
