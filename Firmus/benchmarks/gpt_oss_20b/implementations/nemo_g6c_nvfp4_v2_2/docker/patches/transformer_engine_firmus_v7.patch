+def lookup(weights, quantizers):
+    """NVFP4 tensors over the gathered buffers for ``weights``, or None if not all valid."""
+    if not ENABLED or not weights:
+        return None
+    stats["lookup_calls"] = stats.get("lookup_calls", 0) + 1
+    if DEBUG_CHECK > 0 and stats["lookup_calls"] in (400, 2000, 4000) and torch.distributed.get_rank() == 0:
+        sa = _shard_amax()
+        print(
+            f"NVFP4_FP4_AG diag: {stats} groups {len(_bucket_groups)} fp4 buckets {len(_buckets)} "
+            f"ready {[fb.ready(sa) for fb in _buckets.values()][:4]} "
+            f"valid {sum(fb.valid for fb in _buckets.values())} known {sum(w in _by_param for w in weights)}",
+            flush=True,
+        )
+    if _state.get("discovered") != len(_bucket_groups):
+        _discover()
+    entries = [_by_param.get(w) for w in weights]
+    if any(e is None for e in entries):
+        return None
+    sa = _shard_amax()
+    for fb in {id(e[0]): e[0] for e in entries}.values():
+        # TE fused ops are not called as modules, so DDP's forward pre-hooks never finish
+        # an expert-only bucket group in eager mode (the graph replay path does).
+        if fb.group.param_gather_handle is not None and not torch.cuda.is_current_stream_capturing():
+            fb.group.finish_param_sync()
+            stats["eager_finish"] = stats.get("eager_finish", 0) + 1
+        if not fb.armed:
+            if torch.cuda.is_current_stream_capturing():
+                raise RuntimeError("NVFP4_FP4_AG: first use of an FP4 bucket under graph capture")
+            fb.arm(sa)
+            stats["armed"] = stats.get("armed", 0) + 1
+    out = []
+    for (fb, idx), w, q in zip(entries, weights, quantizers):
+        it = fb.items[idx]
+        if it.tensor is None:
+            both = q.copy()
+            both.set_usage(rowwise=True, columnwise=True)
+            fb._build_tensor(it, both.make_empty(w.shape, dtype=w.dtype, device=w.device))
+            amax = sa.slot_for(w)
+            it.tensor._amax_rowwise = amax
+            it.tensor._amax_columnwise = amax
+        out.append(it.tensor)
+    if USE_KERNEL:
+        key = tuple(id(w) for w in weights)
+        copier = _copiers.get(key)
+        if copier is None:
+            pairs = [p for (fb, idx) in entries for p in fb.fixup_entries(fb.items[idx])]
+            if pairs:
+                from transformer_engine.pytorch.ops.fused import grouped_mlp as _gm
+
+                copier = _gm._v7_module("nvfp4_shard_cast").BatchCopy2D(pairs, weights[0].device)
+            else:
+                copier = False
+            _copiers[key] = copier
+        if copier:
+            copier()
+    else:
+        for fb, idx in entries:
+            fb.fixup(fb.items[idx])
+    stats["lookup"] += 1
+    n = stats["lookup"]
+    if DEBUG_CHECK > 0 and (n <= DEBUG_CHECK or n % 200 == 0) and not torch.cuda.is_current_stream_capturing():
+        _check(weights, out)
+    return out
+
+
+def _check(weights, out):
+    """Local rows against a fresh cast of the local shard, full tensors against the other ranks."""
+    import transformer_engine_torch as tex
+
+    sa = _shard_amax()
+    bad = 0
+    sums = []
+    for w, t in zip(weights, out):
+        fb, idx = _by_param[w]
+        it = fb.items[idx]
+        rows, cols = it.rows, it.cols
+        parts = (
+            t._rowwise_data, t._rowwise_scale_inv.view(torch.uint8)[:rows, : cols // 16],
+            t._columnwise_data, t._columnwise_scale_inv.view(torch.uint8)[:cols, : rows // 16],
+        )
+        sums += [p.to(torch.int64).sum() for p in parts]
+        if it.local is None:
+            continue
+        r0, r1 = it.local
+        ref = tex.nvfp4_quantize_with_amax(w.detach()[r0:r1], _row_col_quantizer(), sa.slot_for(w), sa.slot_for(w))
+        ok = (
+            torch.equal(t._rowwise_data[r0:r1], ref._rowwise_data)
+            and torch.equal(parts[1][r0:r1], ref._rowwise_scale_inv.view(torch.uint8)[: r1 - r0, : cols // 16])
+            and torch.equal(t._columnwise_data[:, r0 // 2 : r1 // 2], ref._columnwise_data)
+            and torch.equal(parts[3][:, r0 // 16 : r1 // 16],
+                            ref._columnwise_scale_inv.view(torch.uint8)[:cols, : (r1 - r0) // 16])
+        )
+        bad += not ok
+    fb = _by_param[weights[0]][0]
+    s = torch.stack(sums)
+    lo, hi = s.clone(), s.clone()
+    pg = fb.group.intra_distributed_optimizer_instance_group
+    torch.distributed.all_reduce(lo, op=torch.distributed.ReduceOp.MIN, group=pg)
+    torch.distributed.all_reduce(hi, op=torch.distributed.ReduceOp.MAX, group=pg)
+    diverged = int((lo != hi).sum())
+    stats["check_bad"] += bad
+    stats["check_diverged"] = stats.get("check_diverged", 0) + diverged
+    stats["checks"] = stats.get("checks", 0) + 1
+    if bad or diverged or stats["lookup"] in (1, DEBUG_CHECK) or stats["checks"] % 10 == 0:
+        print(f"NVFP4_FP4_AG check rank{torch.distributed.get_rank()}: {bad} bad {diverged} diverged {stats}",
+              flush=True)
