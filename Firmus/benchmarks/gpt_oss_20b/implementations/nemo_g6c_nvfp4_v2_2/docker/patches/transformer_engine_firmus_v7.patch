+            last is not None
+            and last[0] == q.untyped_storage().data_ptr()
+            and q.storage_offset() == 0
+            and isinstance(qkv_quantizer, utils.Float8CurrentScalingQuantizer)
+            and not qkv_quantizer.with_amax_reduction
