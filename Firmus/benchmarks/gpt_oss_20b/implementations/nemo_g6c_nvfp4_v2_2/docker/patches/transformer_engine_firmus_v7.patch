+# Classification: Internal
+"""Q, K, V from the Triton QKV RoPE written back to back into one buffer (NVFP4_QKV_PACKED=1).
+
+For separate sbhd Q, K, V the FP8 DPA quantizes them together: ``combine_and_quantize``
+flattens and concatenates them into a fresh BF16 buffer first (a full copy, ~70 us per
+full-attention layer). With the RoPE outputs already consecutive in one storage,
+``get_qkv_layout`` still reports ``sbhd_sbhd_sbhd`` and the flat view of that storage
+holds exactly the concatenation, so it is quantized in place. Bit-identical.
+
+NVFP4_QKV_PACKED_AMAX=1 also drops the current-scaling amax pass (~47 us per layer): the
+RoPE kernel writes the max |output| of each program, one program reduces those and
+computes the scale exactly as ``compute_scale_from_amax`` (__fdiv_rn(max_fp8, amax)),
+and the cast runs through a delayed-scaling quantizer with that scale (the same cast
+kernel the current-scaling quantizer launches).
+"""
+
+import os
+
+import torch
+import triton
+import triton.language as tl
+from triton.language.extra.cuda import libdevice
+
+_AMAX = os.environ.get("NVFP4_QKV_PACKED_AMAX", "0") == "1"
+_stats = {"packed": 0, "fallback": 0, "amax": 0}
+_last = [None]  # (storage data_ptr, per-program amax parts) of the latest packed RoPE output
+
+
+@triton.jit
+def _qkv_rope_fwd_amax_kernel(
+    qkv_ptr, fq_ptr, fk_ptr, q_ptr, k_ptr, v_ptr, parts_ptr, batch, freq_stride,
+    G: tl.constexpr, HQ: tl.constexpr, D: tl.constexpr, BLOCK_R: tl.constexpr,
+):
+    # nvfp4_triton_qkv_rope._qkv_rope_fwd_kernel plus the max |output| of the program.
+    HALF: tl.constexpr = D // 2
+    HG: tl.constexpr = HQ + 2
+    row = tl.program_id(0).to(tl.int64)
+    g = tl.program_id(1)
+    pos = row // batch
+    r = tl.arange(0, BLOCK_R)[:, None]
+    j = tl.arange(0, HALF)[None, :]
+    rmask = r < HG
+    isq = r < HQ
+    isv = r == HQ + 1
+
+    base = qkv_ptr + row * (G * HG * D) + (g * HG + r) * D + j
+    x1 = tl.load(base, mask=rmask, other=0.0).to(tl.float32)
+    x2 = tl.load(base + HALF, mask=rmask, other=0.0).to(tl.float32)
+    fb = pos * freq_stride + j
+    fq1 = tl.load(fq_ptr + fb)
+    fq2 = tl.load(fq_ptr + fb + HALF)
+    fk1 = tl.load(fk_ptr + fb)
+    fk2 = tl.load(fk_ptr + fb + HALF)
+    c1 = tl.where(isq, libdevice.cos(fq1), libdevice.cos(fk1))
+    s1 = tl.where(isq, libdevice.sin(fq1), libdevice.sin(fk1))
+    c2 = tl.where(isq, libdevice.cos(fq2), libdevice.cos(fk2))
+    s2 = tl.where(isq, libdevice.sin(fq2), libdevice.sin(fk2))
+    o1 = x1 * c1 + (-x2) * s1
+    o2 = x2 * c2 + x1 * s2
+    o1 = tl.where(isv, x1, o1).to(q_ptr.dtype.element_ty)
+    o2 = tl.where(isv, x2, o2).to(q_ptr.dtype.element_ty)
+
+    qo = q_ptr + row * (G * HQ * D) + (g * HQ + r) * D + j
+    mq = rmask & isq
+    tl.store(qo, o1, mask=mq)
+    tl.store(qo + HALF, o2, mask=mq)
+    kvo = row * (G * D) + g * D + j + r * 0
+    mk = r == HQ
+    tl.store(k_ptr + kvo, o1, mask=mk)
+    tl.store(k_ptr + kvo + HALF, o2, mask=mk)
+    tl.store(v_ptr + kvo, o1, mask=isv)
+    tl.store(v_ptr + kvo + HALF, o2, mask=isv)
+    a = tl.maximum(tl.abs(o1.to(tl.float32)), tl.abs(o2.to(tl.float32)))
+    a = tl.where(rmask, a, 0.0)
+    tl.store(parts_ptr + row * G + g, tl.max(tl.max(a, axis=1), axis=0))
+
+
+@triton.jit
+def _amax_scale_kernel(parts_ptr, n, amax_ptr, scale_ptr, max_fp8, epsilon,
+                       POW2: tl.constexpr, BLOCK: tl.constexpr):
+    offs = tl.arange(0, BLOCK)
+    acc = tl.zeros([BLOCK], dtype=tl.float32)
+    for start in range(0, n, BLOCK):
+        acc = tl.maximum(acc, tl.load(parts_ptr + start + offs, mask=start + offs < n, other=0.0))
+    amax = tl.max(acc, axis=0)
+    tl.store(amax_ptr, amax)
+    am = tl.where(amax < epsilon, epsilon, amax)
+    scale = libdevice.div_rn(max_fp8, am)
+    scale = tl.where(scale == float("inf"), 3.4028234663852886e38, scale)
+    if POW2:
+        scale = (scale.to(tl.uint32, bitcast=True) & 0xFF800000).to(tl.float32, bitcast=True)
+    scale = tl.where((am == 0.0) | (am == float("inf")) | (am != am), 1.0, scale)
+    tl.store(scale_ptr, scale)
+
+
+def _packed_forward(tqr):
+    def forward(ctx, qkv, q_freqs, k_freqs, split):
+        s, b, g, _ = qkv.shape
+        d = split[1]
+        hq = split[0] // d
+        nq = s * b * g * hq * d
+        nk = s * b * g * d
+        buf = qkv.new_empty(nq + 2 * nk)
+        q = buf[:nq].view(s, b, g * hq, d)
+        k = buf[nq : nq + nk].view(s, b, g, d)
+        v = buf[nq + nk :].view(s, b, g, d)
+        fq = q_freqs.float().contiguous()
+        fk = k_freqs.float().contiguous()
+        block_r = triton.next_power_of_2(hq + 2)
+        if _AMAX:
+            parts = torch.empty(s * b * g, dtype=torch.float32, device=qkv.device)
+            _qkv_rope_fwd_amax_kernel[(s * b, g)](
+                qkv, fq, fk, q, k, v, parts, b, fq.stride(0),
+                G=g, HQ=hq, D=d, BLOCK_R=block_r, num_warps=1,
+            )
+            _last[0] = (buf.untyped_storage().data_ptr(), parts)
+        else:
+            tqr._qkv_rope_fwd_kernel[(s * b, g)](
+                qkv, fq, fk, q, k, v, b, fq.stride(0),
+                G=g, HQ=hq, D=d, BLOCK_R=block_r, num_warps=1,
+            )
+        ctx.save_for_backward(fq, fk)
+        ctx.meta = (g, hq, d, b, block_r, qkv.shape, qkv.dtype)
+        return q, k, v
+
+    return forward
+
+
+def packed_flat(q, k, v):
+    """Flat view of ``q|k|v`` if they are contiguous and consecutive in one storage, else None."""
+    if not (q.dtype == k.dtype == v.dtype and all(x.is_contiguous() for x in (q, k, v))):
+        return None
+    st = q.untyped_storage().data_ptr()
+    if k.untyped_storage().data_ptr() != st or v.untyped_storage().data_ptr() != st:
+        return None
+    if (
+        k.storage_offset() != q.storage_offset() + q.numel()
+        or v.storage_offset() != k.storage_offset() + k.numel()
+    ):
+        return None
+    return q.as_strided((q.numel() + k.numel() + v.numel(),), (1,), q.storage_offset())
+
+
+def _quantize_with_parts(utils, qkv, quantizer, parts):
+    max_fp8 = 448.0 if int(quantizer.dtype) == int(utils.tex.DType.kFloat8E4M3) else 57344.0
+    amax = torch.empty(1, dtype=torch.float32, device=qkv.device)
+    scale = torch.empty(1, dtype=torch.float32, device=qkv.device)
+    _amax_scale_kernel[(1,)](
+        parts, parts.numel(), amax, scale, max_fp8, float(quantizer.amax_epsilon),
+        POW2=bool(quantizer.force_pow_2_scales), BLOCK=4096, num_warps=8,
+    )
+    fq = utils.Float8Quantizer(scale, amax, quantizer.dtype, rowwise=quantizer.rowwise_usage,
+                               columnwise=quantizer.columnwise_usage)
+    fq.internal = quantizer.internal
+    out = fq(qkv)
+    out._quantizer = quantizer
+    return out
+
+
+def make_combine_and_quantize(utils):
+    orig = utils.combine_and_quantize
+
+    def combine_and_quantize(qkv_layout, q, k, v, qkv_quantizer, used_in_forward=True,
+                             used_in_backward=False, keep_same_data_and_scale_inv_format=False):
+        n = _stats["packed"] + _stats["fallback"]
+        if n == 64 and int(os.environ.get("RANK", "0")) == 0:
+            print(f"NVFP4_QKV_PACKED stats {_stats} layout {qkv_layout} q {tuple(q.shape)} "
+                  f"{q.stride()} off {q.storage_offset()} k off {k.storage_offset()} "
+                  f"quantizer {type(qkv_quantizer).__name__}", flush=True)
+        layout = qkv_layout.replace("paged_kv_", "")
+        qkv = None
+        if (
+            layout in ("sbhd_sbhd_sbhd", "bshd_bshd_bshd")
+            and qkv_layout == layout
+            and isinstance(qkv_quantizer, (utils.Float8Quantizer, utils.Float8CurrentScalingQuantizer))
+        ):
+            qkv = packed_flat(q, k, v)
+        if qkv is None:
+            _stats["fallback"] += 1
+            return orig(qkv_layout, q, k, v, qkv_quantizer, used_in_forward, used_in_backward,
+                        keep_same_data_and_scale_inv_format)
+        _stats["packed"] += 1
