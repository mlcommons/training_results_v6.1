> #
> # Firmus: /root is NFS. Pyxis creates the same --container-name on every node;
> # if ENROOT_DATA_PATH is under /root, nodes race → File already exists.
> #
> # Critical: spank_pyxis does NOT honor ENROOT_* from srun --export for create
> # paths (enroot still uses /root/.local/share/enroot). User
> # ~/.config/enroot/enroot.conf path overrides are also ignored by enroot 4.2.1
> # for DATA_PATH. The setting that works is a system drop-in under
> # /etc/enroot/enroot.conf.d/ (writable as root on these nodes).
> #
> # Do NOT override ENROOT_CONFIG_PATH — ACR creds are in
> # /root/.config/enroot/.credentials.
> ##############################################
> : "${ENROOT_DATA_PATH:=/tmp/enroot-data}"
> : "${ENROOT_CACHE_PATH:=/tmp/enroot-cache}"
> : "${ENROOT_RUNTIME_PATH:=/tmp/enroot-runtime}"
> : "${ENROOT_TEMP_PATH:=/tmp/enroot-temp}"
> # /mnt/nvme does not exist on this cluster — fall back if someone exported it.
> for _p in "$ENROOT_DATA_PATH" "$ENROOT_CACHE_PATH" "$ENROOT_RUNTIME_PATH"; do
>   _parent=$(dirname "$_p")
>   if [[ ! -d "$_parent" ]]; then
>     echo "WARNING: ${_parent} missing; forcing enroot paths under /tmp" >&2
>     ENROOT_DATA_PATH=/tmp/enroot-data
>     ENROOT_CACHE_PATH=/tmp/enroot-cache
>     ENROOT_RUNTIME_PATH=/tmp/enroot-runtime
>     ENROOT_TEMP_PATH=/tmp/enroot-temp
>     break
>   fi
> done
> unset _p _parent
> export ENROOT_DATA_PATH ENROOT_CACHE_PATH ENROOT_RUNTIME_PATH ENROOT_TEMP_PATH
> unset ENROOT_CONFIG_PATH
> 
> if [[ ! -f /root/.config/enroot/.credentials ]]; then
>   echo "WARNING: /root/.config/enroot/.credentials missing — ACR pulls may 401" >&2
> fi
> 
> # `/root` is node-local NVMe on this cluster. Pyxis uses its own root-owned
> # Enroot paths, so no privileged system drop-in is required.
> srun --ntasks-per-node=1 df -T /root /tmp
> 
> ##############################################
