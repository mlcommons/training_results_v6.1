diff --git a/primus/backends/megatron_bridge/recipes/mlperf_llama2_70b/llama2_custom.py b/primus/backends/megatron_bridge/recipes/mlperf_llama2_70b/llama2_custom.py
index 5bb411f0..f61de520 100644
--- a/primus/backends/megatron_bridge/recipes/mlperf_llama2_70b/llama2_custom.py
+++ b/primus/backends/megatron_bridge/recipes/mlperf_llama2_70b/llama2_custom.py
@@ -414,7 +414,24 @@ def llama2_70b_lora_config(**user_kwargs: Unpack[Llama2CustomKwargs]) -> ConfigC
                     "MLLOG_LOWEST_NUMERICAL_PRECISION_LINEAR", "mxfp4"
                 ),
             )
+            # HPE: opt_learning_rate_training_steps is the step where the cosine
+            # curve ends (lr_decay_iters), which can differ from train_iters.
+            _decay = kw.get("lr_decay_iters") or int(os.getenv("PRIMUS_LR_DECAY_ITERS", "0") or 0)
+            if _decay and isinstance(init_cfg, dict) and "opt_lr_training_steps" in init_cfg:
+                init_cfg["opt_lr_training_steps"] = int(_decay)
             _sft_logger.log_init_params(init_cfg)
+            # HPE: MLPerf Training 6.1 makes these three keys mandatory; the
+            # primus_mllog version in the image only knows the 6.0 name
+            # (lowest_numerical_precision_linear). Linear layers are MXFP4; the
+            # MXFP4 recipe and the FP8 healing phase keep FP8 attention off
+            # (fp8_dot_product_attention=False) and reduce gradients in bf16
+            # (grad_reduce_in_fp32=False, no FP8 param gather).
+            for _key, _env, _default in (
+                ("lowest_numerical_precision_in_linear", "MLLOG_LOWEST_NUMERICAL_PRECISION_IN_LINEAR", "mxfp4"),
+                ("lowest_numerical_precision_in_attn", "MLLOG_LOWEST_NUMERICAL_PRECISION_IN_ATTN", "bfloat16"),
+                ("lowest_numerical_precision_in_comm", "MLLOG_LOWEST_NUMERICAL_PRECISION_IN_COMM", "bfloat16"),
+            ):
+                _sft_logger._logger.log_event(key=_key, value=os.getenv(_env, _default))
         except Exception as exc:
             _orig_log_rank_0(f"MLPerf logging init failed ({type(exc).__name__}: {exc}) — disabled")
             _sft_logger = None
