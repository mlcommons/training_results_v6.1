diff --git a/examples/mlperf/llama2_70b/config_MI355X_1x8x1.sh b/examples/mlperf/llama2_70b/config_MI355X_1x8x1.sh
index d29f3d83..9ee6f2cb 100755
--- a/examples/mlperf/llama2_70b/config_MI355X_1x8x1.sh
+++ b/examples/mlperf/llama2_70b/config_MI355X_1x8x1.sh
@@ -108,6 +108,13 @@ export MLLOG_MICRO_BATCH_SIZE=1
 MLLOG_CONFIG_FILENAME=$(basename "${BASH_SOURCE[0]}")
 export MLLOG_CONFIG_FILENAME
 export MLLOG_LOWEST_NUMERICAL_PRECISION_LINEAR=mxfp4
+# HPE: MLPerf 6.1 precision keys (logged by the recipe) and submitter fields
+# (these override AMD's values set above).
+export MLLOG_LOWEST_NUMERICAL_PRECISION_IN_LINEAR=mxfp4
+export MLLOG_LOWEST_NUMERICAL_PRECISION_IN_ATTN=bfloat16
+export MLLOG_LOWEST_NUMERICAL_PRECISION_IN_COMM=bfloat16
+export MLLOG_SUBMISSION_ORG=HPE
+export MLLOG_SUBMISSION_PLATFORM=XD685_MI355X
 
 export TP_COMM_OVERLAP=False
 export MC_TP_OVERLAP_AG=False
@@ -154,6 +161,8 @@ export LOGGING_INTERVAL=5000
 export FP4=True
 export FP4_RECIPE=mxfp4
 export MAX_STEPS=550
+# HPE: cosine schedule length (opt_learning_rate_training_steps); unconstrained by the rules.
+export PRIMUS_LR_DECAY_ITERS=${PRIMUS_LR_DECAY_ITERS:-550}
 export NEXP=1
 
 export LOAD_CKPT=True
